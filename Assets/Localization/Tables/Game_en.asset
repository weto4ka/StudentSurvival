  - m_Id: 1085267968
    m_Localized: Student Survival
    m_Metadata:
      m_Items: []
  - m_Id: 1156571136
    m_Localized: Get your degree. Stay awake.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959744
