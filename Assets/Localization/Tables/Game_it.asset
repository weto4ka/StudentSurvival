  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Game_it
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: it
  m_SharedData: {fileID: 11400000, guid: 8139048101eb71f49b76732f067e45f7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1085267968
    m_Localized: Sopravvivenza universitaria
    m_Metadata:
      m_Items: []
  - m_Id: 1156571136
    m_Localized: Prendi la laurea. Resta sveglio.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959744
    m_Localized: Inizia una partita
    m_Metadata:
      m_Items: []
  - m_Id: 1164959745
    m_Localized: Impostazioni
    m_Metadata:
      m_Items: []
  - m_Id: 1164959746
    m_Localized: Come giocare
    m_Metadata:
      m_Items: []
  - m_Id: 1164959747
    m_Localized: Esci
    m_Metadata:
      m_Items: []
  - m_Id: 1164959748
    m_Localized: Indietro
    m_Metadata:
      m_Items: []
  - m_Id: 1164959749
    m_Localized: Riprendi
    m_Metadata:
      m_Items: []
  - m_Id: 1164959750
    m_Localized: Ricomincia
    m_Metadata:
      m_Items: []
  - m_Id: 1164959751
    m_Localized: Menu principale
    m_Metadata:
      m_Items: []
  - m_Id: 1164959752
    m_Localized: "Caricamento\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959753
    m_Localized: Prenditi una pausa
    m_Metadata:
      m_Items: []
  - m_Id: 1164959754
    m_Localized: Lingua
    m_Metadata:
      m_Items: []
  - m_Id: 1164959755
    m_Localized: Volume generale
    m_Metadata:
      m_Items: []
  - m_Id: 1164959756
    m_Localized: Dimensione interfaccia
    m_Metadata:
      m_Items: []
  - m_Id: 1164959757
    m_Localized: Schermo intero
    m_Metadata:
      m_Items: []
  - m_Id: 1164959758
    m_Localized: Attivo
    m_Metadata:
      m_Items: []
  - m_Id: 1164959759
    m_Localized: Disattivo
    m_Metadata:
      m_Items: []
  - m_Id: 1164959760
    m_Localized: La lingua del testo cambia subito. Le scritte nelle immagini e nei
      video originali restano invariate.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959761
    m_Localized: 'Sonno: {0}    Intelligenza: {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 1164959762
    m_Localized: "Esame {0}/2 \xB7 Elaborati rimasti: {1}/{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959763
    m_Localized: "Arriva il prossimo esaminatore\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959764
    m_Localized: 'Ctrl / mouse: lancia un elaborato (costo: 1 Sonno)'
    m_Metadata:
      m_Items: []
  - m_Id: 1164959765
    m_Localized: Vuoto
    m_Metadata:
      m_Items: []
  - m_Id: 1164959766
    m_Localized: "{0} \xB7 {1}\n\xD7{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959767
    m_Localized: Prima trova un oggetto e raccoglilo con E.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959768
    m_Localized: Raggiungi il docente e supera il primo esame.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959769
    m_Localized: "Supera l\u2019esame finale per ottenere la laurea."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959770
    m_Localized: "E \xB7 Apri la porta (resta vicino)"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959771
    m_Localized: "Apertura\u2026 resta vicino alla porta"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959772
    m_Localized: "Questa porta \xE8 chiusa a chiave."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959773
    m_Localized: Questa porta non ha una destinazione.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959774
    m_Localized: "E \xB7 Raccogli: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959775
    m_Localized: Shawarma
    m_Metadata:
      m_Items: []
  - m_Id: 1164959776
    m_Localized: Libro
    m_Metadata:
      m_Items: []
  - m_Id: 1164959777
    m_Localized: Elaborato di laboratorio
    m_Metadata:
      m_Items: []
  - m_Id: 1164959778
    m_Localized: Bevanda energetica
    m_Metadata:
      m_Items: []
  - m_Id: 1164959779
    m_Localized: Recupera 1 Sonno.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959780
    m_Localized: Recupera 1 Intelligenza.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959781
    m_Localized: Lancia un elaborato raccolto senza consumare Sonno.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959782
    m_Localized: "Recupera 1 Sonno e aumenta la velocit\xE0 di 1 per questa partita."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959783
    m_Localized: 'Raccolto: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 1164959784
    m_Localized: 'Usato: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 1164959785
    m_Localized: "La barra \xE8 piena. Usa prima un oggetto."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959786
    m_Localized: Brutto voto! Hai perso 1 Intelligenza.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959787
    m_Localized: "Manca il proiettile dell\u2019elaborato."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959788
    m_Localized: Primo esame superato! +3 Sonno, +1 Intelligenza. Ne manca uno.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959789
    m_Localized: Laurea ottenuta!
    m_Metadata:
      m_Items: []
  - m_Id: 1164959790
    m_Localized: Il semestre ha avuto la meglio.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959791
    m_Localized: Hai finito il Sonno. Usa gli elaborati raccolti per risparmiarlo.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959792
    m_Localized: "L\u2019Intelligenza \xE8 scesa a zero. I libri ti aiuteranno nella
      prossima partita."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959793
    m_Localized: "R \xB7 Ricomincia     Esc \xB7 Menu principale"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959794
    m_Localized: "Movimento: A/D o frecce\nSalto: Spazio\nInteragisci / raccogli:
      E\nLancia un elaborato: Ctrl o clic sinistro (costo: 1 Sonno)\nOggetti: 1\u20139
      o clic su una casella\nPausa / impostazioni: Esc\n\nRaccogli provviste, raggiungi
      l\u2019aula e supera due esami. Ogni colpo conta una volta. Mantieni Sonno
      e Intelligenza sopra lo zero.\n\nGamepad: levetta sinistra / croce per muoverti,
      tasto superiore per saltare, sinistro per interagire, inferiore per lanciare;
      Start per ricominciare dopo il risultato, Select per la pausa. Inventario:
      pulsanti a schermo o tastiera."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959795
    m_Localized: University.exe non risponde. Per fortuna, tu resisti ancora.
    m_Metadata:
      m_Items: []
  - m_Id: 27822423793664
    m_Localized: Pausa
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708224
    m_Localized: Suoni interfaccia
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708225
    m_Localized: "Modalit\xE0 schermo"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708226
    m_Localized: Disponibile nel gioco compilato
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708227
    m_Localized: Schermo intero senza bordi
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708228
    m_Localized: In finestra
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708229
    m_Localized: Raccogli oggetti e supera due esami. Mantieni Sonno e Intelligenza
      sopra lo zero. Sparare costa 1 Sonno; gli elaborati raccolti sono munizioni
      gratuite. Seleziona un comando per modificarlo.
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708230
    m_Localized: Tastiera / mouse
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708231
    m_Localized: Controller
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708232
    m_Localized: Ripristina predefiniti
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708233
    m_Localized: Annulla assegnazione
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708234
    m_Localized: "Premi un comando \xB7 Esc annulla \xB7 Scadenza: 10 secondi"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708235
    m_Localized: "Questo comando \xE8 gi\xE0 assegnato. Scegline un altro."
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708236
    m_Localized: Seleziona un comando da modificare. Scorri per vedere tutte le azioni.
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708237
    m_Localized: "Trova un oggetto \xB7 {0} per raccoglierlo"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708238
    m_Localized: "{0} \xB7 Raccogli: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708239
    m_Localized: "{0} \xB7 Apri la porta (resta vicino)"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708240
    m_Localized: "{0}: lancia (1 Sonno) \xB7 {1}: inventario \xB7 {2}: usa l\u2019oggetto
      selezionato"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708241
    m_Localized: Movimento (asse)
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708242
    m_Localized: Vai a sinistra
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708243
    m_Localized: Vai a destra
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708244
    m_Localized: Salta
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708245
    m_Localized: Abbassati (tieni premuto)
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708246
    m_Localized: Interagisci / raccogli
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708247
    m_Localized: Lancia elaborato (1 Sonno)
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708248
    m_Localized: Pausa / indietro
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708249
    m_Localized: Ricomincia dopo il risultato
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708250
    m_Localized: Mostra / nascondi inventario
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708251
    m_Localized: Oggetto precedente
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708252
    m_Localized: Oggetto successivo
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708253
    m_Localized: "Usa l\u2019oggetto selezionato"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708254
    m_Localized: Usa lo spazio {0}
    m_Metadata:
      m_Items: []
  - m_Id: 39276501786624
    m_Localized: Continua
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980928
    m_Localized: Nuova partita
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980929
    m_Localized: Riprendi dal checkpoint
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980930
    m_Localized: Ricominciare?
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980931
    m_Localized: La partita e il checkpoint saranno sostituiti. Le impostazioni resteranno
      salvate.
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980932
    m_Localized: 'Torna all''ultimo checkpoint: inizio, passaggio di una porta o
      pausa dopo il primo esame. Oggetti e danni successivi vengono annullati.'
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980933
    m_Localized: Partita salvata
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980934
    m_Localized: Salvataggio non riuscito. Controlla spazio e accesso alla cartella.
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980935
    m_Localized: Salvataggio illeggibile. Si usa una copia di sicurezza, se disponibile.
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980936
    m_Localized: Ripristino interrotto. Torna al menu e riprova Continua.
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980937
    m_Localized: Sopravvivi agli esami
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980938
    m_Localized: Si parte
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980939
    m_Localized: 'Supera due esami per laurearti. Raccogli con {0}, poi segui la
      freccia verso l''aula.


      Una nuova relazione con {1} costa 1 Sonno: scriverla
      richiede energia. Le relazioni raccolte sono pronte: selezionane una e usa
      {2}, senza spendere Sonno. Il cibo ripristina Sonno, i libri Intelligenza.


      Se
      Sonno o Intelligenza raggiunge zero, il tentativo termina. Dopo una sconfitta
      riparti dal checkpoint; il menu conserva i progressi.'
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980940
    m_Localized: Raccogli con {1}; poi {0} verso l'aula
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980941
    m_Localized: "{0} Aula \xB7 porte aperte: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980942
    m_Localized: "Nuova relazione: {0} (\u22121 Sonno) \xB7 raccolta: seleziona e
      {1} (gratis)"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980943
    m_Localized: "TIRO BASSO \u2014 salta: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980944
    m_Localized: "TIRO ALTO \u2014 tieni premuto per accovacciarti: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980945
    m_Localized: Protezione temporanea
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980946
    m_Localized: Crediti
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980947
    m_Localized: Collaboratori del progetto
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980948
    m_Localized: Collaboratore del repository
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980949
    m_Localized: Codice e strumenti
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980950
    m_Localized: Console di gioco originale
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980951
    m_Localized: Unity Localization, Input System, uGUI e Addressables
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980952
    m_Localized: Formattazione in Unity Localization (MIT)
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980953
    m_Localized: Audio
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980954
    m_Localized: Suoni sintetizzati dell'interfaccia
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980955
    m_Localized: L'attribuzione di immagini, video e musica originali attende conferma
      del team.
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980956
    m_Localized: Illustrazione del menu generata con OpenAI, 2026-11-21.
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980957
    m_Localized: Illustrazione del menu
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980958
    m_Localized: Minimalista / misteriosa
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980959
    m_Localized: Illustrazione dettagliata
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980960
    m_Localized: "IPERSTIMOLAZIONE \xB7 {0}s \xB7 velocit\xE0 aumentata"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980961
    m_Localized: "CALO DI CAFFEINA \xB7 {0}s \xB7 reazioni lente"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980962
    m_Localized: "SONNO A ZERO \xB7 {0}s! Seleziona cibo/bevanda, poi {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980963
    m_Localized: "Sei gi\xE0 su di giri! Aspetta che finisca l'effetto."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980964
    m_Localized: Sonno insufficiente per una nuova relazione. Usa cibo, una bevanda
      o una relazione raccolta.
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980965
    m_Localized: La caffeina presenta il conto. Movimento e reazioni rallentati per
      10 secondi.
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980966
    m_Localized: "{0} Flirta \xB7 costa 1 relazione raccolta"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980967
    m_Localized: "La relazione \xE8 diventata una lettera d'amore. L'esame pu\xF2
      aspettare..."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980968
    m_Localized: Nessuna relazione da trasformare in lettera d'amore. Raccogline
      una prima.
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980969
    m_Localized: "+3 Sonno temporaneo, pi\xF9 velocit\xE0 per 20s, poi reazioni lente
      per 10s. Il bonus inutilizzato scade."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980970
    m_Localized: "Supera due esami. Raccogli con {0} e segui la freccia. Una relazione
      nuova ({1}) costa 1 Sonno; una raccolta \xE8 gratis: selezionala e usa {2}.
      I libri ripristinano Intelligenza, il cibo Sonno.\n\nA zero Sonno hai 8s per
      recuperare. Una bevanda presta 3 Sonno e accelera per 20s, poi rimuove il bonus
      inutilizzato e rallenta le reazioni per 10s. Gli effetti non si sommano. Flirtare
      \xE8 facoltativo e costa una relazione.\n\nZero Intelligenza o la fine del
      tempo causa la sconfitta. Riparti dal checkpoint; il menu conserva i progressi."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980971
    m_Localized: Sei rimasto senza Sonno troppo a lungo. Usa cibo o una bevanda prima
      della fine del tempo.
    m_Metadata:
      m_Items: []
  - m_Id: 44367438929920
    m_Localized: Come giocare
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398912
    m_Localized: Comandi
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398913
    m_Localized: Seleziona un'azione per cambiare il comando.
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398914
    m_Localized: Il tuo obiettivo
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398915
    m_Localized: Supera due esami per laurearti. Segui la freccia verso l'aula e
      usa le porte aperte.
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398916
    m_Localized: Raccogli provviste
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398917
    m_Localized: Usa {0} vicino a un oggetto o una porta aperta. Il cibo ripristina
      Sonno, i libri Intelligenza. Seleziona un oggetto per vederne l'effetto.
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398918
    m_Localized: Combatti con le relazioni
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398919
    m_Localized: 'Una relazione nuova con {0} costa 1 Sonno. Quelle raccolte sono
      munizioni gratuite: selezionane una e usa {1}. Salta i tiri bassi e abbassati
      per quelli alti.'
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398920
    m_Localized: L'energia ha un prezzo
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398921
    m_Localized: Una bevanda presta 3 Sonno e accelera per 20 secondi. Poi il bonus
      inutilizzato scompare e arriva un calo di 10 secondi. A zero Sonno hai 8 secondi
      per mangiare o bere. Zero Intelligenza causa la sconfitta immediata.
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398922
    m_Localized: Salvataggi e tentativi
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398923
    m_Localized: Il menu salva i progressi. Continua li ripristina. Dopo una sconfitta,
      Riprova torna all'ultimo checkpoint e annulla oggetti e danni successivi. Nuova
      partita sostituisce la partita.
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398924
    m_Localized: Una distrazione allettante
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398925
    m_Localized: "Flirtare con la studentessa \xE8 facoltativo. Interagisci per trasformare
      una relazione raccolta in una lettera d'amore. Passare oltre non costa nulla.
      Una volta per partita."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398926
    m_Localized: Tipografia
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398927
    m_Localized: Carattere pixel - SIL Open Font License 1.1
    m_Metadata:
      m_Items: []
  - m_Id: 45729513988096
    m_Localized: Un altro membro del team - nome da confermare
    m_Metadata:
      m_Items: []
  - m_Id: 62966366986240
    m_Localized: 'Sonno: {0}

      Intelletto: {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706496
    m_Localized: 'Esame {0}: {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706497
    m_Localized: 'Tieni {0}: lancia relazioni raccolte x{1} (senza Sonno)'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706498
    m_Localized: '{0}: usa {1} x{2}'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706499
    m_Localized: 'Raccogli: {0}. Seleziona: {1} / {2}. Usa: {3}.'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706500
    m_Localized: '{0}: raccogli relazioni (munizioni gratuite)'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706501
    m_Localized: '{0} Relazioni a terra - raccogli: {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706502
    m_Localized: 'Tieni {0}: lancia (-1 Sonno)'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706503
    m_Localized: Slot vuoto. Raccogli con {0} o lancia relazioni nuove con {1}.
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706504
    m_Localized: Relazioni raccolte finite. {0} ne lancia di nuove spendendo Sonno.
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706505
    m_Localized: Le prime relazioni sono a terra a destra del punto iniziale. Segui
      il segnale pixel e premi {0} vicino. Gli oggetti raccolti si selezionano automaticamente.
      Il cibo ripristina Sonno, i libri Intelletto.
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706506
    m_Localized: "Tieni {0} per lanciare relazioni nuove (-1 Sonno ciascuna). Quelle
      raccolte sono gratis: tieni {1} per lanciare la pila selezionata. {2} / {3}
      cambiano oggetto. Se \xE8 selezionato del cibo, {1} lo mangia. Ogni lancio
      consuma una relazione; uno slot vuoto non spara."
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706507
    m_Localized: 'SALTA: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706508
    m_Localized: 'ABBASSATI: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706509
    m_Localized: Quando il docente prepara un lancio, compaiono segni sopra la testa
      e lo schermo indica SALTA o ABBASSATI. Segui il segnale per schivare il voto.
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706510
    m_Localized: '{0}: Esci'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706511
    m_Localized: "{0}: Entra in universit\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706512
    m_Localized: '{0}: Flirta

      Costo: 1 relazione raccolta'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706513
    m_Localized: Seleziona un nome per aprire il profilo GitHub.
    m_Metadata:
      m_Items: []
  - m_Id: 80304181075968
    m_Localized: "{0}: prendi i bigliettini nascosti \u2014 rischio di confisca"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658880
    m_Localized: "{0}: ripassa onestamente \u2014 preparazione gratuita"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658881
    m_Localized: "{0}: usa i bigliettini \u2014 basteranno quattro colpi"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658882
    m_Localized: Bigliettini raccolti. Nascondili alla guardia.
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658883
    m_Localized: Ripasso completato. Puoi sostenere l'esame senza bigliettini.
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658884
    m_Localized: 'I bigliettini aiutano: ora bastano quattro colpi in totale.'
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658885
    m_Localized: 'Bigliettini confiscati. Esame annullato: preparati e riprova.'
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658886
    m_Localized: "La guardia \xE8 sospettosa! Nasconditi, accovacciati o allontanati."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658887
    m_Localized: 'Sospetti della guardia: confisca tra {0} s'
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658888
    m_Localized: "{0} \xB7 Flirta (1 relazione raccolta + 1 ora libera)"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658889
    m_Localized: "Facoltativo: usa 1 relazione raccolta e 1 delle 2 ore libere per
      stringere un legame. Studia una volta, poi chiedi 2 relazioni gratuite alla
      tua amica. Studiare due volte d\xE0 invece una preparazione migliore."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658890
    m_Localized: "\xC8 nato un legame! Studia una volta, poi torna per 2 relazioni
      gratuite."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658891
    m_Localized: "\xC8 nato un legame! Parla di nuovo per ricevere 2 relazioni gratuite."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658892
    m_Localized: "{0} \xB7 Accetta 2 relazioni dalla tua amica"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658893
    m_Localized: La tua amica ti ha dato 2 relazioni. Lanciarle non costa Sonno.
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658894
    m_Localized: "{0} \xB7 Studia (+1 preparazione, usa 1 ora libera)"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658895
    m_Localized: "Preparazione +1. Prepararsi meglio rende questo esame pi\xF9 facile."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658896
    m_Localized: "Preparazione +1. La tua amica pu\xF2 ora darti 2 relazioni gratuite:
      torna prima dell'esame."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658897
    m_Localized: Non restano ore libere. Puoi comunque sostenere l'esame.
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658898
    m_Localized: Professor Byte
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658899
    m_Localized: Dottoressa Penna Rossa
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658900
    m_Localized: Professor Scadenza
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658901
    m_Localized: "{0} \u2014 inizia questo esame"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658902
    m_Localized: Prima preparati per questo esame
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658903
    m_Localized: Prima di iniziare, studia o trova un vantaggio utile.
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658904
    m_Localized: "{0} \u2014 passa all\u2019altra aula"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658905
    m_Localized: "Termina l\u2019esame prima di cambiare aula."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658906
    m_Localized: "Esame iniziato. Osserva l\u2019avviso del docente, poi contrattacca."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658907
    m_Localized: Esame superato! Hai recuperato Sonno e Intelligenza. Usa la porta
      quando sei pronto.
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658908
    m_Localized: "Esame {0}/3 \xB7 {1}/{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658909
    m_Localized: "{0} Prossima aula \xB7 {1} alla porta"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658910
    m_Localized: '{0} Raccogli le scorte; {1} avvia l''esame'
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658911
    m_Localized: "{0} Bigliettini in bagno o banco di ripasso \xB7 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658912
    m_Localized: "{0} Tutto pronto \xB7 {1} avvia l'esame"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658913
    m_Localized: "{0} Studia o flirta\nOre libere: {2} \xB7 Preparazione {3}/2"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658914
    m_Localized: "{0} Chiedi 2 relazioni al tuo amico \xB7 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658915
    m_Localized: "{0} Esame in corso \xB7 lancia relazioni e schiva"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658916
    m_Localized: Semestre superato!
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658917
    m_Localized: "Tre docenti, tre esami. Il primo semestre \xE8 finito. Riprendi
      fiato: te lo sei meritato."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658918
    m_Localized: Supera tre esami consecutivi per completare il semestre. Raccogli
      le scorte, preparati, poi interagisci con ogni docente per iniziare. Dopo aver
      superato l'esame, usa la porta indicata per raggiungere l'aula successiva.
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658919
    m_Localized: Bigliettini nascosti e una guardia attenta
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658920
    m_Localized: 'Nella seconda aula, ripassa onestamente al banco o prendi i bigliettini
      nascosti nella nicchia del bagno. Se la guardia ti vede con i bigliettini,
      i sospetti aumentano. Accovacciati o nasconditi nella nicchia per farli diminuire.
      Se ti scopre, i bigliettini vengono confiscati e l''esame annullato: preparati
      e riprova. Durante l''esame, interagisci vicino al docente per usare i bigliettini:
      quattro colpi invece di sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658921
    m_Localized: Due ore libere prima dell'ultimo esame
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658922
    m_Localized: "Nella terza aula hai due ore libere. Studiare ne consuma una e
      aggiunge un punto di preparazione. Flirtare costa un'ora e una relazione raccolta.
      Studia due volte per l'esame pi\xF9 facile, oppure flirta e studia una volta,
      poi torna dal tuo amico per due relazioni gratuite. Puoi anche affrontare un
      esame pi\xF9 difficile con meno preparazione. Il costo appare prima di interagire."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658923
    m_Localized: Docenti diversi, esami diversi
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658924
    m_Localized: "Il professor Byte inizia con lanci bassi singoli. Il dottor Redline
      alterna raffiche alte e basse. Il professor Deadline lancia salve alternate
      pi\xF9 lunghe. Avvia ogni esame con l'azione Interagisci; osserva i segnali
      di avvertimento e le indicazioni Salta/Accovacciati. Un esame superato apre
      l'aula successiva e salva un checkpoint."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658925
    m_Localized: '{0}: esame iniziato. Guarda gli avvisi e schiva.'
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658926
    m_Localized: Continua a esplorare
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658927
    m_Localized: "Semestre superato! Continua a esplorare: i progressi restano salvati.
      Ricominciare \xE8 facoltativo."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658928
    m_Localized: "Semestre superato \xB7 Esplora il campus"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658929
    m_Localized: "Il docente recupera \xB7 Scegli quando lanciare"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658930
    m_Localized: "Avvia ogni esame con Interagisci. Byte lancia due voti bassi, Penna
      Rossa coppie ad altezze diverse e Scadenza triple ravvicinate. Segui gli avvisi
      di salto e accovacciamento. Dopo un colpo il docente lampeggia ed \xE8 protetto
      per poco: distanzia i lanci per non sprecare relazioni. Superare un esame apre
      la stanza successiva; dopo l\u2019ultimo puoi continuare a esplorare."
    m_Metadata:
      m_Items: []
  - m_Id: 81762762874880
    m_Localized: Ritorno su terreno sicuro. I progressi restano invariati.
    m_Metadata:
      m_Items: []
  - m_Id: 93462958432256
    m_Localized: "{0} \xB7 Prendi il cibo (scorta unica)"
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735424
    m_Localized: Cibo raccolto. Mangiare non ripristina questa scorta.
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735425
    m_Localized: "{0} \xB7 Scambia 1 relazione raccolta con 1 bevanda energetica"
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735426
    m_Localized: "{0} \xB7 Scambia 1 relazione raccolta con un consiglio per l\u2019esame"
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735427
    m_Localized: "{0} \xB7 Ripeti il consiglio (gratis)"
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735428
    m_Localized: "Abbiamo gi\xE0 fatto questo scambio."
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735429
    m_Localized: Porta 1 relazione raccolta da scambiare.
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735430
    m_Localized: Libera spazio per la bevanda. Nessuna relazione spesa.
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735431
    m_Localized: Scambio non disponibile. Nessuna relazione spesa.
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735432
    m_Localized: 1 relazione scambiata con 1 bevanda energetica.
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735433
    m_Localized: Salta i voti bassi e abbassati sotto quelli alti. Attendi la fine
      del lampeggio protettivo del docente prima di rilanciare.
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735434
    m_Localized: "{0} \xB7 WC \u2014 entra nei servizi"
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735435
    m_Localized: "{0} \xB7 Torna all\u2019aula di pratica"
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735436
    m_Localized: "{0} Torna in aula \xB7 {1} alla porta dei WC"
    m_Metadata:
      m_Items: []
  - m_Id: 745201730576384
    m_Localized: "Supera prima l\u2019esame di quest\u2019aula per aprire questa
      porta."
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685248
    m_Localized: "Hai lasciato l\u2019aula, quindi l\u2019esame \xE8 annullato. Torna
      e ricomincialo quando sei pronto."
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685249
    m_Localized: "{0} \u2014 esci dall\u2019aula (annulla l\u2019esame)"
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685250
    m_Localized: 'Controllo della guardia: nascondi i bigliettini per altri {0} s!
      Accovacciati o stagli alle spalle.'
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685251
    m_Localized: "La guardia ti ha visto usare i bigliettini! Sono stati confiscati
      e l\u2019esame \xE8 annullato."
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685252
    m_Localized: "Nella seconda aula, ripassa onestamente al banco o prendi i bigliettini
      nascosti nel bagno. Portarli \xE8 sicuro finch\xE9 l\u2019esame non inizia.
      All\u2019inizio la guardia controlla l\u2019aula per qualche secondo: resta
      fuori dalla sua vista, accovacciati o stagli alle spalle. Durante l\u2019esame,
      interagisci vicino al docente per usare i bigliettini (quattro colpi invece
      di sei), ma solo quando la guardia non ti vede. Se ti scopre, vengono confiscati
      e l\u2019esame \xE8 annullato. Anche lasciare l\u2019aula durante un esame
      lo annulla."
    m_Metadata:
      m_Items: []
  - m_Id: 748101240348672
    m_Localized: 'Sonno: {0}

      Intelletto: {1}

      Relazioni: {2}'
    m_Metadata:
      m_Items: []
  - m_Id: 748101244542976
    m_Localized: "Esame {0}/3 \xB7 colpi rimasti: {1} su {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 748101244542977
    m_Localized: "Relazioni raccolte finite. Trovane altre nelle aule successive
      o chiedi all\u2019amica nell\u2019ultima; {0} ne lancia di nuove per 1 Sonno."
    m_Metadata:
      m_Items: []
  - m_Id: 748101244542978
    m_Localized: "Sta studiando. Torna mentre ti prepari all\u2019esame finale."
    m_Metadata:
      m_Items: []
  - m_Id: 748101244542979
    m_Localized: "Studia una volta al banco, poi torna: ti dar\xE0 2 relazioni."
    m_Metadata:
      m_Items: []
  - m_Id: 748101244542980
    m_Localized: "Per ora non c\u2019\xE8 altro da fare con lei. In bocca al lupo!"
    m_Metadata:
      m_Items: []
  - m_Id: 772983596507136
    m_Localized: "{0} \xB7 Dormi nel letto (recupera Sonno)"
    m_Metadata:
      m_Items: []
  - m_Id: 772983600701440
    m_Localized: "Hai appena dormito. Il letto aiuter\xE0 di nuovo tra un paio di
      minuti."
    m_Metadata:
      m_Items: []
  - m_Id: 772983600701441
    m_Localized: "Hai dormito bene: Sonno di nuovo a 10 e mente pi\xF9 lucida."
    m_Metadata:
      m_Items: []
  - m_Id: 772983600701442
    m_Localized: Sei completamente riposato. Non serve dormire ora.
    m_Metadata:
      m_Items: []
  - m_Id: 772983600701443
    m_Localized: Niente pisolini durante un esame!
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895744
    m_Localized: "{0} \xB7 Cucina un pasto (+1 cibo da portare)"
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895745
    m_Localized: "{0} \xB7 Fai un caff\xE8 forte (carica, poi calo)"
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895746
    m_Localized: Hai cucinato un pasto da portare. Selezionalo e usalo per recuperare
      Sonno.
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895747
    m_Localized: "Caff\xE8 forte! Sonno e velocit\xE0 extra per 20 secondi, poi un
      calo."
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895748
    m_Localized: Aspetta un paio di minuti prima di usare di nuovo la cucina.
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895749
    m_Localized: "La studentessa simpatica aspetta nella terza aula, quella dell\u2019esame
      finale: supera l\u2019esame 2 e usa la porta avanti dell\u2019aula pratica.
      Un cuore rosa sopra di lei indica che puoi parlarle. L\xEC hai due ore libere.
      Studiare ne usa una e aumenta la preparazione. Flirtare usa un\u2019ora e una
      relazione raccolta. Studia due volte per l\u2019esame pi\xF9 facile, oppure
      flirta e studia una volta, poi torna da lei per due relazioni gratis."
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895750
    m_Localized: "L\u2019esame non \xE8 iniziato: premi prima {0} vicino al docente.
      Fino ad allora i lanci non servono."
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895751
    m_Localized: "Preparati prima (studia al banco o trova i bigliettini), poi premi
      {0} vicino al docente. Prima dell\u2019esame i lanci non servono."
    m_Metadata:
      m_Items: []
  - m_Id: 774744583430144
    m_Localized: "{0} \xB7 Prepara relazioni al PC (2 Sonno \u2192 2 relazioni, una
      volta per esame)"
    m_Metadata:
      m_Items: []
  - m_Id: 774744591818752
    m_Localized: "Hai gi\xE0 preparato relazioni per questo esame. Superalo per usare
      di nuovo il PC."
    m_Metadata:
      m_Items: []
  - m_Id: 774744591818753
    m_Localized: "Troppo stanco per lavorare: servono pi\xF9 di 2 Sonno. Prima mangia
      o riposa."
