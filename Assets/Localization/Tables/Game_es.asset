  m_TableData:
  - m_Id: 1085267968
    m_Localized: Supervivencia estudiantil
    m_Metadata:
      m_Items: []
  - m_Id: 1156571136
    m_Localized: "Consigue tu t\xEDtulo. Mantente despierto."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959744
    m_Localized: Empezar partida
    m_Metadata:
      m_Items: []
  - m_Id: 1164959745
    m_Localized: Ajustes
    m_Metadata:
      m_Items: []
  - m_Id: 1164959746
    m_Localized: "C\xF3mo jugar"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959747
    m_Localized: Salir
    m_Metadata:
      m_Items: []
  - m_Id: 1164959748
    m_Localized: Volver
    m_Metadata:
      m_Items: []
  - m_Id: 1164959749
    m_Localized: Continuar
    m_Metadata:
      m_Items: []
  - m_Id: 1164959750
    m_Localized: Reiniciar partida
    m_Metadata:
      m_Items: []
  - m_Id: 1164959751
    m_Localized: "Men\xFA principal"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959752
    m_Localized: "Cargando\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959753
    m_Localized: Un respiro
    m_Metadata:
      m_Items: []
  - m_Id: 1164959754
    m_Localized: Idioma
    m_Metadata:
      m_Items: []
  - m_Id: 1164959755
    m_Localized: Volumen general
    m_Metadata:
      m_Items: []
  - m_Id: 1164959756
    m_Localized: "Tama\xF1o de interfaz"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959757
    m_Localized: Pantalla completa
    m_Metadata:
      m_Items: []
  - m_Id: 1164959758
    m_Localized: Activado
    m_Metadata:
      m_Items: []
  - m_Id: 1164959759
    m_Localized: Desactivado
    m_Metadata:
      m_Items: []
  - m_Id: 1164959760
    m_Localized: "El idioma del texto cambia al instante. Los textos de las im\xE1genes
      y v\xEDdeos originales no cambian."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959761
    m_Localized: "Sue\xF1o: {0}    Inteligencia: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959762
    m_Localized: "Examen {0}/2 \xB7 Trabajos restantes: {1}/{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959763
    m_Localized: "Se acerca el siguiente examinador\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959764
    m_Localized: "Ctrl / rat\xF3n: lanzar un trabajo (coste: 1 Sue\xF1o)"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959765
    m_Localized: "Vac\xEDo"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959766
    m_Localized: "{0} \xB7 {1}\n\xD7{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959767
    m_Localized: "Primero busca un objeto y rec\xF3gelo con E."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959768
    m_Localized: Encuentra al profesor y supera el primer examen.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959769
    m_Localized: "Supera el examen final para conseguir tu t\xEDtulo."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959770
    m_Localized: "E \xB7 Abrir puerta (qu\xE9date cerca)"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959771
    m_Localized: "Abriendo\u2026 qu\xE9date junto a la puerta"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959772
    m_Localized: "Esta puerta est\xE1 cerrada con llave."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959773
    m_Localized: Esta puerta no tiene destino.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959774
    m_Localized: "E \xB7 Recoger: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959775
    m_Localized: Shawarma
    m_Metadata:
      m_Items: []
  - m_Id: 1164959776
    m_Localized: Libro
    m_Metadata:
      m_Items: []
  - m_Id: 1164959777
    m_Localized: Trabajo de laboratorio
    m_Metadata:
      m_Items: []
  - m_Id: 1164959778
    m_Localized: "Bebida energ\xE9tica"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959779
    m_Localized: "Recupera 1 de Sue\xF1o."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959780
    m_Localized: Recupera 1 de Inteligencia.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959781
    m_Localized: "Lanza un trabajo recogido sin gastar Sue\xF1o."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959782
    m_Localized: "Recupera 1 de Sue\xF1o y aumenta la velocidad en 1 durante esta
      partida."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959783
    m_Localized: 'Recogido: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 1164959784
    m_Localized: 'Usado: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 1164959785
    m_Localized: "La barra est\xE1 llena. Usa un objeto primero."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959786
    m_Localized: "\xA1Mala nota! Pierdes 1 de Inteligencia."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959787
    m_Localized: Falta el proyectil del trabajo.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959788
    m_Localized: "\xA1Primer examen superado! +3 Sue\xF1o, +1 Inteligencia. Falta
      uno."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959789
    m_Localized: "\xA1T\xEDtulo conseguido!"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959790
    m_Localized: El semestre pudo contigo.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959791
    m_Localized: "Te has quedado sin Sue\xF1o. Usa trabajos recogidos para ahorrarlo."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959792
    m_Localized: "Tu Inteligencia lleg\xF3 a cero. Los libros te ayudar\xE1n en la
      pr\xF3xima partida."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959793
    m_Localized: "R \xB7 Reiniciar     Esc \xB7 Men\xFA principal"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959794
    m_Localized: "Mover: A/D o flechas\nSaltar: Espacio\nInteractuar / recoger: E\nLanzar
      trabajo: Ctrl o clic izquierdo (coste: 1 Sue\xF1o)\nObjetos: 1\u20139 o clic
      en una casilla\nPausa / ajustes: Esc\n\nRecoge provisiones, encuentra el aula
      y supera dos ex\xE1menes. Cada impacto cuenta una vez. Mant\xE9n Sue\xF1o e
      Inteligencia por encima de cero.\n\nMando: palanca izquierda / cruceta para
      moverte, bot\xF3n superior para saltar, izquierdo para interactuar e inferior
      para lanzar; Start reinicia tras el resultado, Select abre la pausa. Inventario:
      botones en pantalla o teclado."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959795
    m_Localized: "University.exe no responde. Por suerte, t\xFA sigues adelante."
    m_Metadata:
      m_Items: []
  - m_Id: 27822423793664
    m_Localized: Pausa
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708224
    m_Localized: Sonidos de interfaz
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708225
    m_Localized: Modo de pantalla
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708226
    m_Localized: Disponible en el juego compilado
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708227
    m_Localized: Pantalla completa sin bordes
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708228
    m_Localized: En ventana
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708229
    m_Localized: "Recoge objetos y supera dos ex\xE1menes. Mant\xE9n Sue\xF1o e Inteligencia
      por encima de cero. Disparar cuesta 1 Sue\xF1o; los trabajos recogidos son
      munici\xF3n gratuita. Selecciona un control para cambiarlo."
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708230
    m_Localized: "Teclado / rat\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708231
    m_Localized: Mando
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708232
    m_Localized: Restaurar controles
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708233
    m_Localized: "Cancelar asignaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708234
    m_Localized: "Pulsa un control \xB7 Esc cancela \xB7 L\xEDmite de 10 segundos"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708235
    m_Localized: "Ese control ya est\xE1 asignado. Elige otro."
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708236
    m_Localized: "Selecciona una asignaci\xF3n para cambiarla. Despl\xE1zate para
      ver todas las acciones."
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708237
    m_Localized: "Busca un objeto \xB7 {0} para recogerlo"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708238
    m_Localized: "{0} \xB7 Recoger: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708239
    m_Localized: "{0} \xB7 Abrir puerta (qu\xE9date cerca)"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708240
    m_Localized: "{0}: lanzar (1 Sue\xF1o) \xB7 {1}: inventario \xB7 {2}: usar objeto
      seleccionado"
    m_Metadata:
      m_Items: []
