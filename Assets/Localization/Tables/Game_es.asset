    m_Items: []
  m_TableData:
  - m_Id: 1085267968
    m_Localized: Supervivencia estudiantil
    m_Metadata:
      m_Items: []
  - m_Id: 1156571136
    m_Localized: "Consigue tu t\xEDtulo. Mantente despierto."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959744
    m_Localized: Empezar partida
    m_Metadata:
      m_Items: []
  - m_Id: 1164959745
    m_Localized: Ajustes
    m_Metadata:
      m_Items: []
  - m_Id: 1164959746
    m_Localized: "C\xF3mo jugar"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959747
    m_Localized: Salir
    m_Metadata:
      m_Items: []
  - m_Id: 1164959748
    m_Localized: Volver
    m_Metadata:
      m_Items: []
  - m_Id: 1164959749
    m_Localized: Continuar
    m_Metadata:
      m_Items: []
  - m_Id: 1164959750
    m_Localized: Reiniciar partida
    m_Metadata:
      m_Items: []
  - m_Id: 1164959751
    m_Localized: "Men\xFA principal"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959752
    m_Localized: "Cargando\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959753
    m_Localized: Un respiro
    m_Metadata:
      m_Items: []
  - m_Id: 1164959754
    m_Localized: Idioma
    m_Metadata:
      m_Items: []
  - m_Id: 1164959755
    m_Localized: Volumen general
    m_Metadata:
      m_Items: []
  - m_Id: 1164959756
    m_Localized: "Tama\xF1o de interfaz"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959757
    m_Localized: Pantalla completa
    m_Metadata:
      m_Items: []
  - m_Id: 1164959758
    m_Localized: Activado
    m_Metadata:
      m_Items: []
  - m_Id: 1164959759
    m_Localized: Desactivado
    m_Metadata:
      m_Items: []
  - m_Id: 1164959760
    m_Localized: "El idioma del texto cambia al instante. Los textos de las im\xE1genes
      y v\xEDdeos originales no cambian."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959761
    m_Localized: "Sue\xF1o: {0}    Inteligencia: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959762
    m_Localized: "Examen {0}/2 \xB7 Trabajos restantes: {1}/{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959763
    m_Localized: "Se acerca el siguiente examinador\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959764
    m_Localized: "Ctrl / rat\xF3n: lanzar un trabajo (coste: 1 Sue\xF1o)"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959765
    m_Localized: "Vac\xEDo"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959766
    m_Localized: "{0} \xB7 {1}\n\xD7{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959767
    m_Localized: "Primero busca un objeto y rec\xF3gelo con E."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959768
    m_Localized: Encuentra al profesor y supera el primer examen.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959769
    m_Localized: "Supera el examen final para conseguir tu t\xEDtulo."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959770
    m_Localized: "E \xB7 Abrir puerta (qu\xE9date cerca)"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959771
    m_Localized: "Abriendo\u2026 qu\xE9date junto a la puerta"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959772
    m_Localized: "Esta puerta est\xE1 cerrada con llave."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959773
    m_Localized: Esta puerta no tiene destino.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959774
    m_Localized: "E \xB7 Recoger: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959775
    m_Localized: Shawarma
    m_Metadata:
      m_Items: []
  - m_Id: 1164959776
    m_Localized: Libro
    m_Metadata:
      m_Items: []
  - m_Id: 1164959777
    m_Localized: Trabajo de laboratorio
    m_Metadata:
      m_Items: []
  - m_Id: 1164959778
    m_Localized: "Bebida energ\xE9tica"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959779
    m_Localized: "Recupera 1 de Sue\xF1o."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959780
    m_Localized: Recupera 1 de Inteligencia.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959781
    m_Localized: "Lanza un trabajo recogido sin gastar Sue\xF1o."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959782
    m_Localized: "Recupera 1 de Sue\xF1o y aumenta la velocidad en 1 durante esta
      partida."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959783
    m_Localized: 'Recogido: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 1164959784
    m_Localized: 'Usado: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 1164959785
    m_Localized: "La barra est\xE1 llena. Usa un objeto primero."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959786
    m_Localized: "\xA1Mala nota! Pierdes 1 de Inteligencia."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959787
    m_Localized: Falta el proyectil del trabajo.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959788
    m_Localized: "\xA1Primer examen superado! +3 Sue\xF1o, +1 Inteligencia. Falta
      uno."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959789
    m_Localized: "\xA1T\xEDtulo conseguido!"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959790
    m_Localized: El semestre pudo contigo.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959791
    m_Localized: "Te has quedado sin Sue\xF1o. Usa trabajos recogidos para ahorrarlo."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959792
    m_Localized: "Tu Inteligencia lleg\xF3 a cero. Los libros te ayudar\xE1n en la
      pr\xF3xima partida."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959793
    m_Localized: "R \xB7 Reiniciar     Esc \xB7 Men\xFA principal"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959794
    m_Localized: "Mover: A/D o flechas\nSaltar: Espacio\nInteractuar / recoger: E\nLanzar
      trabajo: Ctrl o clic izquierdo (coste: 1 Sue\xF1o)\nObjetos: 1\u20139 o clic
      en una casilla\nPausa / ajustes: Esc\n\nRecoge provisiones, encuentra el aula
      y supera dos ex\xE1menes. Cada impacto cuenta una vez. Mant\xE9n Sue\xF1o e
      Inteligencia por encima de cero.\n\nMando: palanca izquierda / cruceta para
      moverte, bot\xF3n superior para saltar, izquierdo para interactuar e inferior
      para lanzar; Start reinicia tras el resultado, Select abre la pausa. Inventario:
      botones en pantalla o teclado."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959795
    m_Localized: "University.exe no responde. Por suerte, t\xFA sigues adelante."
    m_Metadata:
      m_Items: []
  - m_Id: 27822423793664
    m_Localized: Pausa
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708224
    m_Localized: Sonidos de interfaz
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708225
    m_Localized: Modo de pantalla
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708226
    m_Localized: Disponible en el juego compilado
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708227
    m_Localized: Pantalla completa sin bordes
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708228
    m_Localized: En ventana
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708229
    m_Localized: "Recoge objetos y supera dos ex\xE1menes. Mant\xE9n Sue\xF1o e Inteligencia
      por encima de cero. Disparar cuesta 1 Sue\xF1o; los trabajos recogidos son
      munici\xF3n gratuita. Selecciona un control para cambiarlo."
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708230
    m_Localized: "Teclado / rat\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708231
    m_Localized: Mando
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708232
    m_Localized: Restaurar controles
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708233
    m_Localized: "Cancelar asignaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708234
    m_Localized: "Pulsa un control \xB7 Esc cancela \xB7 L\xEDmite de 10 segundos"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708235
    m_Localized: "Ese control ya est\xE1 asignado. Elige otro."
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708236
    m_Localized: "Selecciona una asignaci\xF3n para cambiarla. Despl\xE1zate para
      ver todas las acciones."
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708237
    m_Localized: "Busca un objeto \xB7 {0} para recogerlo"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708238
    m_Localized: "{0} \xB7 Recoger: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708239
    m_Localized: "{0} \xB7 Abrir puerta (qu\xE9date cerca)"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708240
    m_Localized: "{0}: lanzar (1 Sue\xF1o) \xB7 {1}: inventario \xB7 {2}: usar objeto
      seleccionado"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708241
    m_Localized: Mover (eje)
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708242
    m_Localized: Mover a la izquierda
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708243
    m_Localized: Mover a la derecha
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708244
    m_Localized: Saltar
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708245
    m_Localized: Agacharse (mantener)
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708246
    m_Localized: Interactuar / recoger
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708247
    m_Localized: "Lanzar trabajo (1 Sue\xF1o)"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708248
    m_Localized: Pausa / volver
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708249
    m_Localized: Reiniciar tras el resultado
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708250
    m_Localized: Mostrar / ocultar inventario
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708251
    m_Localized: Objeto anterior
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708252
    m_Localized: Objeto siguiente
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708253
    m_Localized: Usar objeto seleccionado
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708254
    m_Localized: Usar casilla {0}
    m_Metadata:
      m_Items: []
  - m_Id: 39276501786624
    m_Localized: Continuar
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980928
    m_Localized: Nueva partida
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980929
    m_Localized: Reintentar punto de control
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980930
    m_Localized: "\xBFEmpezar de nuevo?"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980931
    m_Localized: "Se reemplazar\xE1n la partida y su punto de control. Se conservar\xE1n
      los ajustes."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980932
    m_Localized: "Vuelve al \xFAltimo punto de control: inicio, paso por una puerta
      o descanso tras el primer examen. Se deshacen los objetos y da\xF1os posteriores."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980933
    m_Localized: Partida guardada
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980934
    m_Localized: No se pudo guardar. Comprueba el espacio y el acceso a la carpeta.
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980935
    m_Localized: "Partida ilegible. Se usar\xE1 una copia de seguridad si existe."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980936
    m_Localized: "Restauraci\xF3n detenida. Vuelve al men\xFA y reintenta Continuar."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980937
    m_Localized: "Sobrevive a los ex\xE1menes"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980938
    m_Localized: Vamos
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980939
    m_Localized: "Aprueba dos ex\xE1menes. Recoge con {0} y sigue la flecha al aula.\n\nUn
      informe nuevo con {1} cuesta 1 Sue\xF1o: escribirlo requiere energ\xEDa. Los
      informes recogidos est\xE1n listos: selecciona uno y usa {2}, sin gastar Sue\xF1o.
      La comida restaura Sue\xF1o; los libros, Inteligencia.\n\nSi Sue\xF1o o Inteligencia
      llega a cero, termina el intento. Tras perder vuelves al punto de control;
      el men\xFA conserva el progreso."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980940
    m_Localized: Recoge con {1}; luego {0} al aula
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980941
    m_Localized: "{0} Aula \xB7 puertas abiertas: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980942
    m_Localized: "Informe nuevo: {0} (\u22121 Sue\xF1o) \xB7 recogido: selecciona
      y {1} (gratis)"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980943
    m_Localized: "LANZAMIENTO BAJO \u2014 salta: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980944
    m_Localized: "LANZAMIENTO ALTO \u2014 mant\xE9n pulsado para agacharte: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980945
    m_Localized: "Protecci\xF3n temporal"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980946
    m_Localized: "Cr\xE9ditos"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980947
    m_Localized: Colaboradores del proyecto
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980948
    m_Localized: Colaborador del repositorio
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980949
    m_Localized: "C\xF3digo y herramientas"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980950
    m_Localized: Consola original del juego
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980951
    m_Localized: Unity Localization, Input System, uGUI y Addressables
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980952
    m_Localized: Formato de texto en Unity Localization (MIT)
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980953
    m_Localized: Sonido
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980954
    m_Localized: Sonidos sintetizados de interfaz
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980955
    m_Localized: "El equipo debe confirmar la autor\xEDa de im\xE1genes, v\xEDdeos
      y m\xFAsica originales."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980956
    m_Localized: "Ilustraci\xF3n del men\xFA generada con OpenAI, 2026-11-21."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980957
    m_Localized: "Ilustraci\xF3n del men\xFA"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980958
    m_Localized: Minimalista / misteriosa
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980959
    m_Localized: "Ilustraci\xF3n detallada"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980960
    m_Localized: "SOBREESTIMULACI\xD3N \xB7 {0}s \xB7 m\xE1s velocidad"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980961
    m_Localized: "BAJ\xD3N DE CAFE\xCDNA \xB7 {0}s \xB7 reacci\xF3n lenta"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980962
    m_Localized: "SUE\xD1O A CERO \xB7 \xA1{0}s! Selecciona comida/bebida y pulsa
      {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980963
    m_Localized: "\xA1Ya est\xE1s acelerado! Espera a que pase el efecto."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980964
    m_Localized: "Sin Sue\xF1o para un informe nuevo. Usa comida, una bebida o un
      informe recogido."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980965
    m_Localized: "La cafe\xEDna pasa factura. Movimiento y reacci\xF3n m\xE1s lentos
      durante 10 segundos."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980966
    m_Localized: "{0} Coquetear \xB7 cuesta 1 informe recogido"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980967
    m_Localized: Tu informe ahora es una carta de amor. El examen puede esperar...
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980968
    m_Localized: No tienes un informe para convertirlo en carta de amor. Recoge uno
      primero.
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980969
    m_Localized: "+3 Sue\xF1o temporal, m\xE1s velocidad 20s y reacci\xF3n lenta
      10s. El Sue\xF1o prestado sin usar desaparece."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980970
    m_Localized: "Aprueba dos ex\xE1menes. Recoge con {0} y sigue la flecha. Un informe
      nuevo ({1}) cuesta 1 Sue\xF1o; uno recogido es gratis: selecci\xF3nalo y usa
      {2}. Los libros restauran Inteligencia y la comida Sue\xF1o.\n\nA cero Sue\xF1o
      tienes 8s para recuperarte. Una bebida presta 3 Sue\xF1o y acelera durante
      20s; despu\xE9s retira el bonus sin usar y ralentiza la reacci\xF3n 10s. Los
      efectos no se acumulan. Coquetear es opcional y cuesta un informe.\n\nCero
      Inteligencia o el fin del plazo causa la derrota. Reintenta desde el punto
      de control; el men\xFA guarda el progreso."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980971
    m_Localized: "Pasaste demasiado tiempo sin Sue\xF1o. Usa comida o una bebida
      antes de que termine el plazo."
    m_Metadata:
      m_Items: []
  - m_Id: 44367438929920
    m_Localized: "C\xF3mo jugar"
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398912
    m_Localized: Controles
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398913
    m_Localized: "Selecciona una acci\xF3n para cambiar su tecla."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398914
    m_Localized: Tu objetivo
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398915
    m_Localized: "Aprueba dos ex\xE1menes para graduarte. Sigue la flecha al aula
      y usa las puertas abiertas."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398916
    m_Localized: Recoge provisiones
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398917
    m_Localized: "Usa {0} junto a un objeto o una puerta abierta. La comida restaura
      Sue\xF1o; los libros, Inteligencia. Selecciona un objeto para ver su efecto."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398918
    m_Localized: Lucha con informes
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398919
    m_Localized: "Un informe nuevo con {0} cuesta 1 Sue\xF1o. Los recogidos son munici\xF3n
      gratis: selecciona uno y usa {1}. Salta los lanzamientos bajos y ag\xE1chate
      ante los altos."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398920
    m_Localized: "La energ\xEDa tiene un precio"
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398921
    m_Localized: "Una bebida presta 3 Sue\xF1o y acelera durante 20 segundos. Luego
      desaparece el bonus sin usar y llega un baj\xF3n de 10 segundos. A cero Sue\xF1o
      tienes 8 segundos para comer o beber. Cero Inteligencia causa la derrota inmediata."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398922
    m_Localized: Guardar y reintentar
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398923
    m_Localized: "Volver al men\xFA guarda el progreso. Continuar lo restaura. Tras
      perder, Reintentar vuelve al \xFAltimo punto de control y deshace objetos y
      da\xF1os posteriores. Nueva partida reemplaza la partida."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398924
    m_Localized: "Una distracci\xF3n tentadora"
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398925
    m_Localized: "Coquetear con la estudiante es opcional. Interact\xFAa para convertir
      un informe recogido en una carta de amor. Pasar de largo no cuesta nada. Una
      vez por partida."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398926
    m_Localized: "Tipograf\xEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398927
    m_Localized: Fuente pixel - SIL Open Font License 1.1
    m_Metadata:
      m_Items: []
  - m_Id: 45729513988096
    m_Localized: Otro integrante del equipo - nombre por confirmar
    m_Metadata:
      m_Items: []
  - m_Id: 62966366986240
    m_Localized: "Sue\xF1o: {0}\nIntelecto: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706496
    m_Localized: 'Examen {0}: {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706497
    m_Localized: "Mant\xE9n {0}: lanzar informes recogidos x{1} (sin gastar Sue\xF1o)"
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706498
    m_Localized: '{0}: usar {1} x{2}'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706499
    m_Localized: 'Recoger: {0}. Elegir: {1} / {2}. Usar: {3}.'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706500
    m_Localized: "{0}: recoger informes (munici\xF3n gratis)"
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706501
    m_Localized: '{0} Informes en el suelo - recoger: {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706502
    m_Localized: "Mant\xE9n {0}: lanzar (-1 Sue\xF1o)"
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706503
    m_Localized: "Hueco vac\xEDo. Recoge con {0} o lanza informes nuevos con {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706504
    m_Localized: "Se acabaron los informes recogidos. {0} lanza nuevos gastando Sue\xF1o."
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706505
    m_Localized: "Los primeros informes est\xE1n en el suelo a la derecha del inicio.
      Sigue el marcador pixel y pulsa {0} cerca. Lo recogido se selecciona autom\xE1ticamente.
      La comida restaura Sue\xF1o; los libros, Intelecto."
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706506
    m_Localized: "Mant\xE9n {0} para lanzar informes nuevos (-1 Sue\xF1o cada uno).
      Los recogidos son gratis: mant\xE9n {1} para lanzar la pila seleccionada. {2}
      / {3} cambian de objeto. Si hay comida seleccionada, {1} la come. Cada lanzamiento
      gasta un informe; un hueco vac\xEDo no dispara."
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706507
    m_Localized: 'SALTA: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706508
    m_Localized: "AG\xC1CHATE: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706509
    m_Localized: "Cuando el docente prepara un lanzamiento, aparecen marcas sobre
      su cabeza y la pantalla indica SALTA o AG\xC1CHATE. Sigue el aviso para esquivar
      la nota."
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706510
    m_Localized: '{0}: Salir al exterior'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706511
    m_Localized: '{0}: Entrar en la universidad'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706512
    m_Localized: '{0}: Coquetear

      Coste: 1 informe recogido'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706513
    m_Localized: Selecciona un nombre para abrir su perfil de GitHub.
    m_Metadata:
      m_Items: []
  - m_Id: 80304181075968
    m_Localized: "{0}: coger las chuletas ocultas \u2014 riesgo de confiscaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658880
    m_Localized: "{0}: repasar con honradez \u2014 preparaci\xF3n gratuita"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658881
    m_Localized: "{0}: usar las chuletas \u2014 bastar\xE1n cuatro impactos"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658882
    m_Localized: "Chuletas recogidas. Oc\xFAltaselas al guardia."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658883
    m_Localized: Repaso completado. Puedes presentarte al examen sin chuletas.
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658884
    m_Localized: 'Las chuletas ayudan: ahora bastan cuatro impactos en total.'
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658885
    m_Localized: "Chuletas confiscadas. Examen cancelado: prep\xE1rate y vuelve a
      intentarlo."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658886
    m_Localized: "\xA1El guardia sospecha! Esc\xF3ndete, ag\xE1chate o sal de su
      vista."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658887
    m_Localized: "Sospecha del guardia: confiscaci\xF3n en {0} s"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658888
    m_Localized: "{0} \xB7 Coquetear (1 informe recogido + 1 hora libre)"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658889
    m_Localized: "Opcional: gasta 1 informe recogido y 1 de tus 2 horas libres en
      crear un v\xEDnculo. Estudia una vez y luego pide 2 informes gratis a tu amiga.
      Estudiar dos veces mejora m\xE1s tu preparaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658890
    m_Localized: "\xA1Hay conexi\xF3n! Estudia una vez y vuelve por 2 informes gratis."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658891
    m_Localized: "\xA1Hay conexi\xF3n! Habla otra vez para recibir 2 informes gratis."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658892
    m_Localized: "{0} \xB7 Aceptar 2 informes de tu amiga"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658893
    m_Localized: "Tu amiga comparti\xF3 2 informes. Lanzarlos no cuesta Sue\xF1o."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658894
    m_Localized: "{0} \xB7 Estudiar (+1 preparaci\xF3n, usa 1 hora libre)"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658895
    m_Localized: "Preparaci\xF3n +1. Prepararte mejor facilita este examen."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658896
    m_Localized: "Preparaci\xF3n +1. Tu amiga ya puede darte 2 informes gratis; vuelve
      antes del examen."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658897
    m_Localized: "No quedan horas libres. A\xFAn puedes presentarte al examen."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658898
    m_Localized: Profesor Byte
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658899
    m_Localized: "Doctora Bol\xEDgrafo Rojo"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658900
    m_Localized: "Profesor Fecha L\xEDmite"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658901
    m_Localized: "{0} \u2014 comenzar este examen"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658902
    m_Localized: "Prep\xE1rate primero para este examen"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658903
    m_Localized: "Antes de empezar, estudia o consigue una ventaja \xFAtil."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658904
    m_Localized: "{0} \u2014 ir a la otra aula"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658905
    m_Localized: Termina el examen actual antes de cambiar de aula.
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658906
    m_Localized: Examen iniciado. Observa la advertencia y contraataca.
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658907
    m_Localized: "\xA1Examen aprobado! Recuperaste Sue\xF1o e Inteligencia. Usa la
      puerta cuando est\xE9s listo."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658908
    m_Localized: "Examen {0}/3 \xB7 {1}/{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658909
    m_Localized: "{0} Siguiente aula \xB7 {1} junto a la puerta"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658910
    m_Localized: '{0} Recoge suministros; {1} inicia el examen'
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658911
    m_Localized: "{0} Chuletas en el ba\xF1o o mesa de repaso \xB7 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658912
    m_Localized: "{0} Todo listo \xB7 {1} inicia el examen"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658913
    m_Localized: "{0} Estudia o liga\nHoras libres: {2} \xB7 Preparaci\xF3n {3}/2"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658914
    m_Localized: "{0} Pide 2 informes a tu amigo \xB7 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658915
    m_Localized: "{0} Examen en marcha \xB7 lanza informes y esquiva"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658916
    m_Localized: "\xA1Semestre aprobado!"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658917
    m_Localized: "Tres profes, tres ex\xE1menes. Tu primer semestre ha terminado.
      T\xF3mate un respiro: te lo has ganado."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658918
    m_Localized: "Aprueba tres ex\xE1menes consecutivos para terminar el semestre.
      Recoge suministros, prep\xE1rate e interact\xFAa con cada profe para empezar.
      Tras aprobar, usa la puerta marcada para llegar a la siguiente aula."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658919
    m_Localized: Chuletas ocultas y un guardia atento
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658920
    m_Localized: "En la segunda aula, repasa con honradez en la mesa o coge las chuletas
      ocultas en el rinc\xF3n del ba\xF1o. Si el guardia te ve con ellas, sus sospechas
      aumentan. Ag\xE1chate o esc\xF3ndete en el rinc\xF3n para reducirlas. Si te
      pilla, confisca las chuletas y cancela el examen; prep\xE1rate y vuelve a intentarlo.
      Durante el examen, interact\xFAa cerca del profe para usarlas: cuatro impactos
      en lugar de seis."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658921
    m_Localized: "Dos horas libres antes del \xFAltimo examen"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658922
    m_Localized: "En la tercera aula tienes dos horas libres. Estudiar consume una
      y a\xF1ade un punto de preparaci\xF3n. Ligar cuesta una hora y un informe recogido.
      Estudia dos veces para el examen m\xE1s f\xE1cil, o liga y estudia una vez;
      despu\xE9s vuelve con tu amigo para recibir dos informes gratis. Tambi\xE9n
      puedes afrontar un examen m\xE1s dif\xEDcil con menos preparaci\xF3n. El coste
      se muestra antes de interactuar."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658923
    m_Localized: "Profes distintos, ex\xE1menes distintos"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658924
    m_Localized: "El profesor Byte empieza con lanzamientos bajos individuales. El
      doctor Redline mezcla r\xE1fagas altas y bajas. El profesor Deadline lanza
      salvas alternas m\xE1s largas. Inicia cada examen con Interactuar; f\xEDjate
      en las advertencias y en las indicaciones de saltar o agacharte. Aprobar abre
      la siguiente aula y guarda un punto de control."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658925
    m_Localized: "{0}: examen iniciado. Mira las se\xF1ales y esquiva."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658926
    m_Localized: Seguir explorando
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658927
    m_Localized: "\xA1Semestre aprobado! Sigue explorando: tu progreso se guarda.
      Reiniciar es opcional."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658928
    m_Localized: "Semestre aprobado \xB7 Explora el campus"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658929
    m_Localized: "El docente se recupera \xB7 Calcula tu pr\xF3ximo lanzamiento"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658930
    m_Localized: "Inicia cada examen con Interactuar. Byte lanza dos notas bajas,
      Bol\xEDgrafo Rojo pares a distintas alturas y Fecha L\xEDmite triples seguidos.
      Sigue los avisos de salto y agacharse. Tras un impacto, el docente parpadea
      y queda protegido brevemente: espacia los lanzamientos para no gastar informes.
      Aprobar abre la siguiente sala; despu\xE9s del \xFAltimo examen puedes seguir
      explorando."
    m_Metadata:
      m_Items: []
  - m_Id: 81762762874880
    m_Localized: De vuelta a suelo seguro. Tu progreso se conserva.
    m_Metadata:
      m_Items: []
  - m_Id: 93462958432256
    m_Localized: "{0} \xB7 Recoger comida (reserva \xFAnica)"
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735424
    m_Localized: Comida recogida. Comer no repone esta reserva.
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735425
    m_Localized: "{0} \xB7 Cambiar 1 informe recogido por 1 bebida energ\xE9tica"
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735426
    m_Localized: "{0} \xB7 Cambiar 1 informe recogido por un consejo para el examen"
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735427
    m_Localized: "{0} \xB7 Repetir el consejo (gratis)"
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735428
    m_Localized: Ya hicimos este intercambio.
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735429
    m_Localized: Trae 1 informe recogido para intercambiar.
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735430
    m_Localized: "Haz espacio para la bebida. No se ha gastado ning\xFAn informe."
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735431
    m_Localized: "Este intercambio no est\xE1 disponible. No se gast\xF3 ning\xFAn
      informe."
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735432
    m_Localized: "1 informe cambiado por 1 bebida energ\xE9tica."
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735433
    m_Localized: "Salta las notas bajas y ag\xE1chate bajo las altas. Espera a que
      termine el parpadeo de protecci\xF3n del profesor antes de volver a lanzar."
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735434
    m_Localized: "{0} \xB7 WC \u2014 entrar en el ba\xF1o"
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735435
    m_Localized: "{0} \xB7 Volver al aula de pr\xE1cticas"
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735436
    m_Localized: "{0} Vuelve al aula \xB7 {1} en la puerta del ba\xF1o"
    m_Metadata:
      m_Items: []
  - m_Id: 745201730576384
    m_Localized: Aprueba primero el examen de esta aula para abrir esta puerta.
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685248
    m_Localized: "Saliste del aula, as\xED que el examen se cancel\xF3. Vuelve y
      empi\xE9zalo de nuevo cuando est\xE9s listo."
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685249
    m_Localized: "{0} \u2014 salir del aula (cancela el examen)"
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685250
    m_Localized: "Revisi\xF3n del guardia: \xA1esconde las chuletas {0} s m\xE1s!
      Ag\xE1chate o qu\xE9date a su espalda."
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685251
    m_Localized: "\xA1El guardia te vio usar las chuletas! Te las confiscan y el
      examen se cancela."
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685252
    m_Localized: "En la segunda aula, repasa con honradez en la mesa o coge las chuletas
      ocultas en el ba\xF1o. Llevarlas es seguro hasta que empieza el examen. Al
      empezar, el guardia revisa el aula unos segundos: no dejes que te vea, ag\xE1chate
      o ponte a su espalda. Durante el examen, interact\xFAa cerca del profe para
      usarlas (cuatro impactos en lugar de seis), pero solo cuando el guardia no
      te vea. Si te pilla, te las confisca y el examen se cancela. Salir del aula
      durante cualquier examen tambi\xE9n lo cancela."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
