  m_TableData:
  - m_Id: 1085267968
    m_Localized: "Survie \xE9tudiante"
    m_Metadata:
      m_Items: []
  - m_Id: 1156571136
    m_Localized: "D\xE9crochez votre dipl\xF4me. Restez \xE9veill\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959744
    m_Localized: Commencer
    m_Metadata:
      m_Items: []
  - m_Id: 1164959745
    m_Localized: "Param\xE8tres"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959746
    m_Localized: Comment jouer
    m_Metadata:
      m_Items: []
  - m_Id: 1164959747
    m_Localized: Quitter
    m_Metadata:
      m_Items: []
  - m_Id: 1164959748
    m_Localized: Retour
    m_Metadata:
      m_Items: []
  - m_Id: 1164959749
    m_Localized: Reprendre
    m_Metadata:
      m_Items: []
  - m_Id: 1164959750
    m_Localized: Recommencer
    m_Metadata:
      m_Items: []
  - m_Id: 1164959751
    m_Localized: Menu principal
    m_Metadata:
      m_Items: []
  - m_Id: 1164959752
    m_Localized: "Chargement\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959753
    m_Localized: Petite pause
    m_Metadata:
      m_Items: []
  - m_Id: 1164959754
    m_Localized: Langue
    m_Metadata:
      m_Items: []
  - m_Id: 1164959755
    m_Localized: "Volume g\xE9n\xE9ral"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959756
    m_Localized: "Taille de l\u2019interface"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959757
    m_Localized: "Plein \xE9cran"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959758
    m_Localized: "Activ\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959759
    m_Localized: "D\xE9sactiv\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959760
    m_Localized: "La langue du texte change imm\xE9diatement. Les inscriptions des
      images et vid\xE9os d\u2019origine restent inchang\xE9es."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959761
    m_Localized: 'Sommeil : {0}    Intelligence : {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 1164959762
    m_Localized: "Examen {0}/2 \xB7 Travaux restants : {1}/{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959763
    m_Localized: "Le prochain examinateur arrive\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959764
    m_Localized: "Ctrl / souris : lancer un travail (co\xFBt : 1 Sommeil)"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959765
    m_Localized: Vide
    m_Metadata:
      m_Items: []
  - m_Id: 1164959766
    m_Localized: "{0} \xB7 {1}\n\xD7{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959767
    m_Localized: "D\u2019abord, trouvez un objet et ramassez-le avec E."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959768
    m_Localized: "Trouvez le professeur et r\xE9ussissez le premier examen."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959769
    m_Localized: "R\xE9ussissez l\u2019examen final pour obtenir votre dipl\xF4me."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959770
    m_Localized: "E \xB7 Ouvrir la porte (restez \xE0 proximit\xE9)"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959771
    m_Localized: "Ouverture\u2026 restez pr\xE8s de la porte"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959772
    m_Localized: "Cette porte est verrouill\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959773
    m_Localized: "Cette porte n\u2019a pas de destination."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959774
    m_Localized: "E \xB7 Ramasser : {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959775
    m_Localized: Chawarma
    m_Metadata:
      m_Items: []
  - m_Id: 1164959776
    m_Localized: Livre
    m_Metadata:
      m_Items: []
  - m_Id: 1164959777
    m_Localized: Compte rendu de TP
    m_Metadata:
      m_Items: []
  - m_Id: 1164959778
    m_Localized: "Boisson \xE9nergisante"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959779
    m_Localized: Rend 1 point de Sommeil.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959780
    m_Localized: "Rend 1 point d\u2019Intelligence."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959781
    m_Localized: "Lance un travail ramass\xE9 sans d\xE9penser de Sommeil."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959782
    m_Localized: "Rend 1 point de Sommeil et ajoute 1 \xE0 la vitesse pour cette
      partie."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959783
    m_Localized: "Objet ramass\xE9 : {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959784
    m_Localized: "Objet utilis\xE9 : {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959785
    m_Localized: "Votre barre est pleine. Utilisez d\u2019abord un objet."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959786
    m_Localized: "Mauvaise note ! Vous perdez 1 point d\u2019Intelligence."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959787
    m_Localized: Le projectile du travail est manquant.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959788
    m_Localized: "Premier examen r\xE9ussi ! +3 Sommeil, +1 Intelligence. Encore
      un !"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959789
    m_Localized: "Dipl\xF4me obtenu !"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959790
    m_Localized: Le semestre a eu raison de vous.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959791
    m_Localized: "Vous n\u2019avez plus de Sommeil. Utilisez les travaux ramass\xE9s
      pour l\u2019\xE9conomiser."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959792
    m_Localized: "Votre Intelligence est \xE0 z\xE9ro. Les livres vous aideront \xE0
      la prochaine partie."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959793
    m_Localized: "R \xB7 Recommencer     \xC9chap \xB7 Menu principal"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959794
    m_Localized: "D\xE9placement : A/D ou fl\xE8ches\nSaut : Espace\nInteragir /
      ramasser : E\nLancer un travail : Ctrl ou clic gauche (co\xFBt : 1 Sommeil)\nObjets
      : 1\u20139 ou clic sur une case\nPause / param\xE8tres : \xC9chap\n\nRamassez
      des provisions, trouvez la salle et r\xE9ussissez deux examens. Chaque impact
      compte une fois. Gardez le Sommeil et l\u2019Intelligence au-dessus de z\xE9ro.\n\nManette
      : stick gauche / croix pour bouger, bouton du haut pour sauter, de gauche pour
      interagir, du bas pour lancer ; Start pour recommencer apr\xE8s le r\xE9sultat,
      Select pour la pause. Inventaire : boutons \xE0 l\u2019\xE9cran ou clavier."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959795
    m_Localized: "University.exe ne r\xE9pond plus. Heureusement, vous tenez encore."
    m_Metadata:
      m_Items: []
  - m_Id: 27822423793664
    m_Localized: Pause
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708224
    m_Localized: "Sons de l\u2019interface"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708225
    m_Localized: "Mode d\u2019affichage"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708226
    m_Localized: "Disponible dans le jeu compil\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708227
    m_Localized: "Plein \xE9cran sans bordure"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708228
    m_Localized: "Fen\xEAtr\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708229
    m_Localized: "Ramassez des objets et r\xE9ussissez deux examens. Gardez Sommeil
      et Intelligence au-dessus de z\xE9ro. Tirer co\xFBte 1 Sommeil ; les travaux
      ramass\xE9s sont des munitions gratuites. S\xE9lectionnez une commande pour
      la modifier."
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708230
    m_Localized: Clavier / souris
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708231
    m_Localized: Manette
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708232
    m_Localized: "R\xE9tablir les commandes"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708233
    m_Localized: "Annuler l\u2019affectation"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708234
    m_Localized: "Appuyez sur une commande \xB7 \xC9chap pour annuler \xB7 D\xE9lai
      de 10 secondes"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708235
    m_Localized: "Cette commande est d\xE9j\xE0 affect\xE9e. Choisissez-en une autre."
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708236
    m_Localized: "S\xE9lectionnez une affectation pour la modifier. Faites d\xE9filer
      pour voir toutes les actions."
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708237
    m_Localized: "Trouvez un objet \xB7 {0} pour le ramasser"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708238
    m_Localized: "{0} \xB7 Ramasser : {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708239
    m_Localized: "{0} \xB7 Ouvrir la porte (restez \xE0 proximit\xE9)"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708240
    m_Localized: "{0} : lancer (1 Sommeil) \xB7 {1} : inventaire \xB7 {2} : utiliser
      l\u2019objet s\xE9lectionn\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708241
    m_Localized: "D\xE9placement (axe)"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708242
    m_Localized: "Aller \xE0 gauche"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708243
    m_Localized: "Aller \xE0 droite"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708244
    m_Localized: Sauter
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708245
    m_Localized: "S\u2019accroupir (maintenir)"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708246
    m_Localized: Interagir / ramasser
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708247
    m_Localized: Lancer un travail (1 Sommeil)
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708248
    m_Localized: Pause / retour
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708249
    m_Localized: "Recommencer apr\xE8s le r\xE9sultat"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708250
    m_Localized: "Afficher / masquer l\u2019inventaire"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708251
    m_Localized: "Objet pr\xE9c\xE9dent"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708252
    m_Localized: Objet suivant
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708253
    m_Localized: "Utiliser l\u2019objet s\xE9lectionn\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708254
    m_Localized: "Utiliser l\u2019emplacement {0}"
    m_Metadata:
      m_Items: []
