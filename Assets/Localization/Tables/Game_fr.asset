  m_TableData:
  - m_Id: 1085267968
    m_Localized: "Survie \xE9tudiante"
    m_Metadata:
      m_Items: []
  - m_Id: 1156571136
    m_Localized: "D\xE9crochez votre dipl\xF4me. Restez \xE9veill\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959744
    m_Localized: Commencer
    m_Metadata:
      m_Items: []
  - m_Id: 1164959745
    m_Localized: "Param\xE8tres"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959746
    m_Localized: Comment jouer
    m_Metadata:
      m_Items: []
  - m_Id: 1164959747
    m_Localized: Quitter
    m_Metadata:
      m_Items: []
  - m_Id: 1164959748
    m_Localized: Retour
    m_Metadata:
      m_Items: []
  - m_Id: 1164959749
    m_Localized: Reprendre
    m_Metadata:
      m_Items: []
  - m_Id: 1164959750
    m_Localized: Recommencer
    m_Metadata:
      m_Items: []
  - m_Id: 1164959751
    m_Localized: Menu principal
    m_Metadata:
      m_Items: []
  - m_Id: 1164959752
    m_Localized: "Chargement\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959753
    m_Localized: Petite pause
    m_Metadata:
      m_Items: []
  - m_Id: 1164959754
    m_Localized: Langue
    m_Metadata:
      m_Items: []
  - m_Id: 1164959755
    m_Localized: "Volume g\xE9n\xE9ral"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959756
    m_Localized: "Taille de l\u2019interface"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959757
    m_Localized: "Plein \xE9cran"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959758
    m_Localized: "Activ\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959759
    m_Localized: "D\xE9sactiv\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959760
    m_Localized: "La langue du texte change imm\xE9diatement. Les inscriptions des
      images et vid\xE9os d\u2019origine restent inchang\xE9es."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959761
    m_Localized: 'Sommeil : {0}    Intelligence : {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 1164959762
    m_Localized: "Examen {0}/2 \xB7 Travaux restants : {1}/{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959763
    m_Localized: "Le prochain examinateur arrive\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959764
    m_Localized: "Ctrl / souris : lancer un travail (co\xFBt : 1 Sommeil)"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959765
    m_Localized: Vide
    m_Metadata:
      m_Items: []
  - m_Id: 1164959766
    m_Localized: "{0} \xB7 {1}\n\xD7{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959767
    m_Localized: "D\u2019abord, trouvez un objet et ramassez-le avec E."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959768
    m_Localized: "Trouvez le professeur et r\xE9ussissez le premier examen."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959769
    m_Localized: "R\xE9ussissez l\u2019examen final pour obtenir votre dipl\xF4me."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959770
    m_Localized: "E \xB7 Ouvrir la porte (restez \xE0 proximit\xE9)"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959771
    m_Localized: "Ouverture\u2026 restez pr\xE8s de la porte"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959772
    m_Localized: "Cette porte est verrouill\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959773
    m_Localized: "Cette porte n\u2019a pas de destination."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959774
    m_Localized: "E \xB7 Ramasser : {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959775
    m_Localized: Chawarma
    m_Metadata:
      m_Items: []
  - m_Id: 1164959776
    m_Localized: Livre
    m_Metadata:
      m_Items: []
  - m_Id: 1164959777
    m_Localized: Compte rendu de TP
    m_Metadata:
      m_Items: []
  - m_Id: 1164959778
    m_Localized: "Boisson \xE9nergisante"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959779
    m_Localized: Rend 1 point de Sommeil.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959780
    m_Localized: "Rend 1 point d\u2019Intelligence."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959781
    m_Localized: "Lance un travail ramass\xE9 sans d\xE9penser de Sommeil."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959782
    m_Localized: "Rend 1 point de Sommeil et ajoute 1 \xE0 la vitesse pour cette
      partie."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959783
    m_Localized: "Objet ramass\xE9 : {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959784
    m_Localized: "Objet utilis\xE9 : {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959785
    m_Localized: "Votre barre est pleine. Utilisez d\u2019abord un objet."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959786
    m_Localized: "Mauvaise note ! Vous perdez 1 point d\u2019Intelligence."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959787
    m_Localized: Le projectile du travail est manquant.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959788
    m_Localized: "Premier examen r\xE9ussi ! +3 Sommeil, +1 Intelligence. Encore
      un !"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959789
    m_Localized: "Dipl\xF4me obtenu !"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959790
    m_Localized: Le semestre a eu raison de vous.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959791
    m_Localized: "Vous n\u2019avez plus de Sommeil. Utilisez les travaux ramass\xE9s
      pour l\u2019\xE9conomiser."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959792
    m_Localized: "Votre Intelligence est \xE0 z\xE9ro. Les livres vous aideront \xE0
      la prochaine partie."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959793
    m_Localized: "R \xB7 Recommencer     \xC9chap \xB7 Menu principal"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959794
    m_Localized: "D\xE9placement : A/D ou fl\xE8ches\nSaut : Espace\nInteragir /
      ramasser : E\nLancer un travail : Ctrl ou clic gauche (co\xFBt : 1 Sommeil)\nObjets
      : 1\u20139 ou clic sur une case\nPause / param\xE8tres : \xC9chap\n\nRamassez
      des provisions, trouvez la salle et r\xE9ussissez deux examens. Chaque impact
      compte une fois. Gardez le Sommeil et l\u2019Intelligence au-dessus de z\xE9ro.\n\nManette
      : stick gauche / croix pour bouger, bouton du haut pour sauter, de gauche pour
      interagir, du bas pour lancer ; Start pour recommencer apr\xE8s le r\xE9sultat,
      Select pour la pause. Inventaire : boutons \xE0 l\u2019\xE9cran ou clavier."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959795
    m_Localized: "University.exe ne r\xE9pond plus. Heureusement, vous tenez encore."
    m_Metadata:
      m_Items: []
  - m_Id: 27822423793664
    m_Localized: Pause
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708224
    m_Localized: "Sons de l\u2019interface"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708225
    m_Localized: "Mode d\u2019affichage"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708226
    m_Localized: "Disponible dans le jeu compil\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708227
    m_Localized: "Plein \xE9cran sans bordure"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708228
    m_Localized: "Fen\xEAtr\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708229
    m_Localized: "Ramassez des objets et r\xE9ussissez deux examens. Gardez Sommeil
      et Intelligence au-dessus de z\xE9ro. Tirer co\xFBte 1 Sommeil ; les travaux
      ramass\xE9s sont des munitions gratuites. S\xE9lectionnez une commande pour
      la modifier."
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708230
    m_Localized: Clavier / souris
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708231
    m_Localized: Manette
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708232
    m_Localized: "R\xE9tablir les commandes"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708233
    m_Localized: "Annuler l\u2019affectation"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708234
    m_Localized: "Appuyez sur une commande \xB7 \xC9chap pour annuler \xB7 D\xE9lai
      de 10 secondes"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708235
    m_Localized: "Cette commande est d\xE9j\xE0 affect\xE9e. Choisissez-en une autre."
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708236
    m_Localized: "S\xE9lectionnez une affectation pour la modifier. Faites d\xE9filer
      pour voir toutes les actions."
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708237
    m_Localized: "Trouvez un objet \xB7 {0} pour le ramasser"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708238
    m_Localized: "{0} \xB7 Ramasser : {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708239
    m_Localized: "{0} \xB7 Ouvrir la porte (restez \xE0 proximit\xE9)"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708240
    m_Localized: "{0} : lancer (1 Sommeil) \xB7 {1} : inventaire \xB7 {2} : utiliser
      l\u2019objet s\xE9lectionn\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708241
    m_Localized: "D\xE9placement (axe)"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708242
    m_Localized: "Aller \xE0 gauche"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708243
    m_Localized: "Aller \xE0 droite"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708244
    m_Localized: Sauter
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708245
    m_Localized: "S\u2019accroupir (maintenir)"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708246
    m_Localized: Interagir / ramasser
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708247
    m_Localized: Lancer un travail (1 Sommeil)
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708248
    m_Localized: Pause / retour
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708249
    m_Localized: "Recommencer apr\xE8s le r\xE9sultat"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708250
    m_Localized: "Afficher / masquer l\u2019inventaire"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708251
    m_Localized: "Objet pr\xE9c\xE9dent"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708252
    m_Localized: Objet suivant
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708253
    m_Localized: "Utiliser l\u2019objet s\xE9lectionn\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708254
    m_Localized: "Utiliser l\u2019emplacement {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 39276501786624
    m_Localized: Continuer
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980928
    m_Localized: Nouvelle partie
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980929
    m_Localized: "Reprendre au point de contr\xF4le"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980930
    m_Localized: Recommencer ?
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980931
    m_Localized: "Votre partie et son point de contr\xF4le seront remplac\xE9s. Vos
      r\xE9glages seront conserv\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980932
    m_Localized: "Retour au dernier point de contr\xF4le : d\xE9part, passage de
      porte ou pause apr\xE8s le premier examen. Les objets et d\xE9g\xE2ts ult\xE9rieurs
      sont annul\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980933
    m_Localized: "Partie sauvegard\xE9e"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980934
    m_Localized: "Sauvegarde impossible. V\xE9rifiez l'espace disque et l'acc\xE8s
      au dossier."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980935
    m_Localized: "Sauvegarde illisible. Une copie de secours est utilis\xE9e si disponible."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980936
    m_Localized: "Restauration interrompue. Revenez au menu et r\xE9essayez Continuer."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980937
    m_Localized: Survivez aux examens
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980938
    m_Localized: C'est parti
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980939
    m_Localized: "R\xE9ussissez deux examens. Ramassez avec {0}, puis suivez la fl\xE8che
      vers la salle.\n\nUn nouveau rapport avec {1} co\xFBte 1 Sommeil : le r\xE9diger
      demande de l'\xE9nergie. Les rapports ramass\xE9s sont pr\xEAts : s\xE9lectionnez-en
      un et utilisez {2}, sans d\xE9penser de Sommeil. La nourriture restaure le
      Sommeil, les livres l'Intelligence.\n\nSi le Sommeil ou l\u2019Intelligence
      atteint z\xE9ro, la tentative se termine. Apr\xE8s une d\xE9faite, reprenez
      au point de contr\xF4le ; le menu conserve votre progression."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980940
    m_Localized: 'Provisions : {1} ; puis {0} vers la salle'
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980941
    m_Localized: "{0} Salle \xB7 portes ouvertes : {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980942
    m_Localized: "Nouveau rapport : {0} (\u22121 Sommeil) \xB7 ramass\xE9 : s\xE9lectionner,
      puis {1} (gratuit)"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980943
    m_Localized: "TIR BAS \u2014 sauter : {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980944
    m_Localized: "TIR HAUT \u2014 rester accroupi : {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980945
    m_Localized: Protection temporaire
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980946
    m_Localized: "Cr\xE9dits"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980947
    m_Localized: Contributeurs du projet
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980948
    m_Localized: "Contribution au d\xE9p\xF4t"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980949
    m_Localized: Code et outils
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980950
    m_Localized: Console de jeu d'origine
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980951
    m_Localized: Unity Localization, Input System, uGUI et Addressables
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980952
    m_Localized: Formatage dans Unity Localization (MIT)
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980953
    m_Localized: Son
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980954
    m_Localized: "Sons d'interface synth\xE9tis\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980955
    m_Localized: "L'attribution des images, vid\xE9os et musiques d'origine reste
      \xE0 confirmer par l'\xE9quipe."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980956
    m_Localized: "Illustration du menu g\xE9n\xE9r\xE9e avec OpenAI, 2026-11-21."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980957
    m_Localized: Illustration du menu
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980958
    m_Localized: "Minimaliste / myst\xE9rieuse"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980959
    m_Localized: "Illustration d\xE9taill\xE9e"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980960
    m_Localized: "SURSTIMULATION \xB7 {0}s \xB7 vitesse accrue"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980961
    m_Localized: "CONTRECOUP \xB7 {0}s \xB7 r\xE9actions lentes"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980962
    m_Localized: "SOMMEIL \xC0 Z\xC9RO \xB7 {0}s ! S\xE9lectionnez nourriture/boisson,
      puis {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980963
    m_Localized: "D\xE9j\xE0 survolt\xE9 ! Attendez la fin de l'effet."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980964
    m_Localized: "Pas de Sommeil pour un nouveau rapport. Utilisez nourriture, boisson
      ou rapport ramass\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980965
    m_Localized: "La caf\xE9ine r\xE9clame son d\xFB. D\xE9placements et r\xE9actions
      ralentis pendant 10 secondes."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980966
    m_Localized: "{0} Flirter \xB7 co\xFBte 1 rapport ramass\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980967
    m_Localized: Votre rapport est devenu une lettre d'amour. L'examen attendra...
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980968
    m_Localized: "Aucun rapport \xE0 transformer en lettre d'amour. Ramassez-en un
      d'abord."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980969
    m_Localized: "+3 Sommeil temporaire, vitesse accrue 20s, puis r\xE9actions lentes
      10s. Le bonus inutilis\xE9 expire."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980970
    m_Localized: "R\xE9ussissez deux examens. Ramassez avec {0} et suivez la fl\xE8che.
      Un rapport neuf ({1}) co\xFBte 1 Sommeil ; un rapport ramass\xE9 est gratuit
      : s\xE9lectionnez-le, puis {2}. Les livres restaurent l'Intelligence, la nourriture
      le Sommeil.\n\n\xC0 z\xE9ro Sommeil, vous avez 8s pour r\xE9cup\xE9rer. Une
      boisson pr\xEAte 3 Sommeil et acc\xE9l\xE8re pendant 20s, puis retire le bonus
      inutilis\xE9 et ralentit les r\xE9actions 10s. Les effets ne se cumulent pas.
      Flirter est facultatif et co\xFBte un rapport.\n\nZ\xE9ro Intelligence ou la
      fin du d\xE9lai entra\xEEne la d\xE9faite. Reprise au point de contr\xF4le
      ; le menu conserve la progression."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980971
    m_Localized: "Vous \xEAtes rest\xE9 sans Sommeil trop longtemps. Utilisez nourriture
      ou boisson avant la fin du d\xE9lai."
    m_Metadata:
      m_Items: []
  - m_Id: 44367438929920
    m_Localized: Comment jouer
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398912
    m_Localized: Commandes
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398913
    m_Localized: "S\xE9lectionnez une action pour changer sa touche."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398914
    m_Localized: Votre objectif
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398915
    m_Localized: "R\xE9ussissez deux examens pour obtenir votre dipl\xF4me. Suivez
      la fl\xE8che vers la salle et empruntez les portes ouvertes."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398916
    m_Localized: Ramassez des provisions
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398917
    m_Localized: "Utilisez {0} pr\xE8s d'un objet ou d'une porte ouverte. La nourriture
      restaure le Sommeil, les livres l'Intelligence. S\xE9lectionnez un objet pour
      voir son effet."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398918
    m_Localized: Combattez avec des rapports
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398919
    m_Localized: "Un rapport neuf avec {0} co\xFBte 1 Sommeil. Les rapports ramass\xE9s
      sont gratuits : s\xE9lectionnez-en un, puis utilisez {1}. Sautez les tirs bas
      et accroupissez-vous pour les tirs hauts."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398920
    m_Localized: "L'\xE9nergie a un prix"
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398921
    m_Localized: "Une boisson pr\xEAte 3 Sommeil et acc\xE9l\xE8re pendant 20 secondes.
      Le bonus inutilis\xE9 dispara\xEEt ensuite et un contrecoup ralentit vos r\xE9actions
      10 secondes. \xC0 z\xE9ro Sommeil, vous avez 8 secondes pour manger ou boire.
      Z\xE9ro Intelligence entra\xEEne une d\xE9faite imm\xE9diate."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398922
    m_Localized: Sauvegarde et reprise
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398923
    m_Localized: "Le menu sauvegarde votre progression. Continuer la restaure. Apr\xE8s
      une d\xE9faite, Reprendre restaure le dernier point de contr\xF4le et annule
      les objets et d\xE9g\xE2ts ult\xE9rieurs. Nouvelle partie remplace la partie."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398924
    m_Localized: Une distraction tentante
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398925
    m_Localized: "Flirter avec l'\xE9tudiante est facultatif. Interagissez pour transformer
      un rapport ramass\xE9 en lettre d'amour. Passer devant ne co\xFBte rien. Une
      fois par partie."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398926
    m_Localized: Typographie
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398927
    m_Localized: Police pixel - SIL Open Font License 1.1
    m_Metadata:
      m_Items: []
  - m_Id: 45729513988096
    m_Localized: "Un autre membre de l'\xE9quipe - nom \xE0 confirmer"
    m_Metadata:
      m_Items: []
  - m_Id: 62966366986240
    m_Localized: 'Sommeil : {0}

      Intellect : {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706496
    m_Localized: 'Examen {0} : {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706497
    m_Localized: "Maintenez {0} : lancer les rapports ramass\xE9s x{1} (gratuit)"
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706498
    m_Localized: '{0} : utiliser {1} x{2}'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706499
    m_Localized: 'Ramasser : {0}. Choisir : {1} / {2}. Utiliser : {3}.'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706500
    m_Localized: '{0} : ramasser les rapports (munitions gratuites)'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706501
    m_Localized: '{0} Rapports au sol - ramasser : {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706502
    m_Localized: 'Maintenez {0} : lancer (-1 Sommeil)'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706503
    m_Localized: Emplacement vide. Ramassez avec {0}, ou lancez un rapport neuf avec
      {1}.
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706504
    m_Localized: "Plus de rapports ramass\xE9s. {0} en lance de nouveaux contre du
      Sommeil."
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706505
    m_Localized: "Les premiers rapports sont au sol, \xE0 droite du d\xE9part. Suivez
      le rep\xE8re pixel et utilisez {0} \xE0 proximit\xE9. L'objet ramass\xE9 est
      s\xE9lectionn\xE9 automatiquement. La nourriture restaure le Sommeil, les livres
      l'Intelligence."
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706506
    m_Localized: "Maintenez {0} pour lancer des rapports neufs (-1 Sommeil chacun).
      Les rapports ramass\xE9s sont gratuits : maintenez {1} pour lancer la pile
      s\xE9lectionn\xE9e. {2} / {3} changent d'objet. Si de la nourriture est s\xE9lectionn\xE9e,
      {1} la mange. Chaque tir d\xE9pense un rapport ; un emplacement vide ne tire
      pas."
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706507
    m_Localized: 'SAUTEZ : {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706508
    m_Localized: 'ACCROUPISSEZ-VOUS : {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706509
    m_Localized: "Quand le professeur pr\xE9pare un lancer, des marques apparaissent
      au-dessus de sa t\xEAte et l'\xE9cran indique de SAUTER ou de S'ACCROUPIR.
      Suivez cet avertissement pour esquiver la note."
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706510
    m_Localized: '{0} : Sortir'
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706511
    m_Localized: "{0} : Entrer \xE0 l\u2019universit\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706512
    m_Localized: "{0} : Flirter\nCo\xFBt : 1 rapport ramass\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706513
    m_Localized: "S\xE9lectionnez un nom pour ouvrir son profil GitHub."
    m_Metadata:
      m_Items: []
  - m_Id: 80304181075968
    m_Localized: "{0} : prendre les antis\xE8ches cach\xE9es \u2014 risque de confiscation"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658880
    m_Localized: "{0} : r\xE9viser honn\xEAtement \u2014 pr\xE9paration gratuite"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658881
    m_Localized: "{0} : utiliser les antis\xE8ches \u2014 quatre touches suffiront"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658882
    m_Localized: "Antis\xE8ches r\xE9cup\xE9r\xE9es. Cache-les au gardien."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658883
    m_Localized: "R\xE9visions termin\xE9es. Tu peux passer l'examen sans antis\xE8ches."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658884
    m_Localized: "Les antis\xE8ches aident : quatre touches au total suffisent d\xE9sormais."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658885
    m_Localized: "Antis\xE8ches confisqu\xE9es. Examen annul\xE9 : pr\xE9pare-toi
      et r\xE9essaie."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658886
    m_Localized: "Le gardien se m\xE9fie ! Cache-toi, accroupis-toi ou \xE9loigne-toi."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658887
    m_Localized: "Soup\xE7ons du gardien : confiscation dans {0} s"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658888
    m_Localized: "{0} \xB7 Flirter (1 rapport ramass\xE9 + 1 cr\xE9neau libre)"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658889
    m_Localized: "Facultatif : d\xE9pensez 1 rapport ramass\xE9 et 1 de vos 2 cr\xE9neaux
      libres pour nouer une relation. \xC9tudiez une fois, puis demandez 2 rapports
      gratuits \xE0 votre amie. \xC9tudier deux fois vous pr\xE9pare mieux."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658890
    m_Localized: "Le courant passe ! \xC9tudiez une fois, puis revenez chercher 2
      rapports gratuits."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658891
    m_Localized: Le courant passe ! Reparlez-lui pour recevoir 2 rapports gratuits.
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658892
    m_Localized: "{0} \xB7 Accepter 2 rapports de votre amie"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658893
    m_Localized: "Votre amie vous a donn\xE9 2 rapports. Les lancer ne co\xFBte aucun
      Sommeil."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658894
    m_Localized: "{0} \xB7 \xC9tudier (+1 pr\xE9paration, co\xFBte 1 cr\xE9neau libre)"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658895
    m_Localized: "Pr\xE9paration +1. Mieux vous pr\xE9parer facilite cet examen."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658896
    m_Localized: "Pr\xE9paration +1. Votre amie peut maintenant donner 2 rapports
      gratuits ; revenez avant l'examen."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658897
    m_Localized: "Il ne reste aucun cr\xE9neau libre. Vous pouvez quand m\xEAme passer
      l'examen."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658898
    m_Localized: Professeur Octet
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658899
    m_Localized: Docteure Stylo rouge
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658900
    m_Localized: "Professeur Dernier D\xE9lai"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658901
    m_Localized: "{0} \u2014 commencer cet examen"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658902
    m_Localized: "Pr\xE9parez d\u2019abord cet examen"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658903
    m_Localized: "Avant de commencer, r\xE9visez ou trouvez un avantage utile."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658904
    m_Localized: "{0} \u2014 changer de salle"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658905
    m_Localized: Terminez votre examen avant de changer de salle.
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658906
    m_Localized: "Examen commenc\xE9. Guettez l\u2019avertissement, puis contre-attaquez."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658907
    m_Localized: "Examen r\xE9ussi ! Sommeil et intelligence r\xE9cup\xE9r\xE9s.
      Prenez la porte quand vous \xEAtes pr\xEAt."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658908
    m_Localized: "Examen {0}/3 \xB7 {1}/{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658909
    m_Localized: "{0} Salle suivante \xB7 {1} \xE0 la porte"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658910
    m_Localized: '{0} Rassemble des provisions ; {1} lance l''examen'
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658911
    m_Localized: "{0} Antis\xE8ches aux toilettes ou bureau de r\xE9vision \xB7 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658912
    m_Localized: "{0} Tout est pr\xEAt \xB7 {1} lance l'examen"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658913
    m_Localized: "{0} R\xE9vise ou flirte\nCr\xE9neaux libres : {2} \xB7 Pr\xE9paration
      {3}/2"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658914
    m_Localized: "{0} Demande 2 rapports \xE0 ton ami \xB7 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658915
    m_Localized: "{0} Examen en cours \xB7 lance des rapports et esquive"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658916
    m_Localized: "Semestre valid\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658917
    m_Localized: "Trois profs, trois examens. Ton premier semestre est termin\xE9.
      Souffle un peu, tu l'as bien m\xE9rit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658918
    m_Localized: "R\xE9ussis trois examens successifs pour terminer le semestre.
      Rassemble des provisions, pr\xE9pare-toi, puis interagis avec chaque prof pour
      commencer. Apr\xE8s la r\xE9ussite, passe par la porte indiqu\xE9e pour rejoindre
      la salle suivante."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658919
    m_Localized: "Antis\xE8ches cach\xE9es et gardien vigilant"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658920
    m_Localized: "Dans la deuxi\xE8me salle, r\xE9vise honn\xEAtement au bureau ou
      prends les antis\xE8ches cach\xE9es dans le renfoncement des toilettes. Si
      le gardien te voit avec, ses soup\xE7ons augmentent. Accroupis-toi ou cache-toi
      dans le renfoncement pour les faire baisser. Si tu te fais prendre, les antis\xE8ches
      sont confisqu\xE9es et l'examen est annul\xE9 ; pr\xE9pare-toi et r\xE9essaie.
      Pendant l'examen, interagis pr\xE8s du prof pour utiliser tes antis\xE8ches
      : quatre touches au lieu de six."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658921
    m_Localized: "Deux cr\xE9neaux libres avant le dernier examen"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658922
    m_Localized: "La troisi\xE8me salle te laisse deux cr\xE9neaux libres. R\xE9viser
      en d\xE9pense un et ajoute un point de pr\xE9paration. Flirter co\xFBte un
      cr\xE9neau et un rapport collect\xE9. R\xE9vise deux fois pour l'examen le
      plus facile, ou flirte puis r\xE9vise une fois avant de revenir voir ton ami
      pour deux rapports gratuits. Tu peux aussi tenter un examen plus difficile
      avec moins de pr\xE9paration. Le co\xFBt s'affiche avant l'interaction."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658923
    m_Localized: "Des profs diff\xE9rents, des examens diff\xE9rents"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658924
    m_Localized: "Le professeur Byte commence par des lancers bas et isol\xE9s. Le
      docteur Redline m\xEAle rafales hautes et basses. Le professeur Deadline envoie
      de plus longues salves altern\xE9es. Lance chaque examen avec l'action Interagir
      ; surveille les avertissements et les indications Sauter/S'accroupir. Un examen
      r\xE9ussi ouvre la salle suivante et enregistre un point de contr\xF4le."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658925
    m_Localized: "{0} : examen commenc\xE9. Guettez les signaux et esquivez."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658926
    m_Localized: "Continuer \xE0 explorer"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658927
    m_Localized: "Semestre r\xE9ussi ! Continuez \xE0 explorer : votre progression
      reste sauvegard\xE9e. Recommencer est facultatif."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658928
    m_Localized: "Semestre r\xE9ussi \xB7 Explorez le campus"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658929
    m_Localized: "Le professeur r\xE9cup\xE8re \xB7 Choisissez le moment de lancer"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658930
    m_Localized: "Lancez chaque examen avec Interagir. Octet lance deux notes basses,
      Stylo rouge des paires \xE0 diff\xE9rentes hauteurs et Dernier D\xE9lai des
      triples serr\xE9s. Suivez les signaux de saut et d\u2019accroupissement. Apr\xE8s
      un impact, le professeur clignote et r\xE9siste bri\xE8vement : espacez les
      tirs pour ne pas gaspiller vos rapports. R\xE9ussir ouvre la salle suivante
      ; apr\xE8s le dernier examen, continuez \xE0 explorer."
    m_Metadata:
      m_Items: []
  - m_Id: 81762762874880
    m_Localized: "Retour sur un sol s\xFBr. Votre progression est conserv\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 93462958432256
    m_Localized: "{0} \xB7 Prendre la nourriture (stock unique)"
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735424
    m_Localized: "Nourriture r\xE9cup\xE9r\xE9e. Manger ne renouvelle pas ce stock."
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735425
    m_Localized: "{0} \xB7 \xC9changer 1 rapport ramass\xE9 contre 1 boisson \xE9nergisante"
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735426
    m_Localized: "{0} \xB7 \xC9changer 1 rapport ramass\xE9 contre un conseil pour
      l\u2019examen"
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735427
    m_Localized: "{0} \xB7 R\xE9\xE9couter le conseil (gratuit)"
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735428
    m_Localized: "Nous avons d\xE9j\xE0 fait cet \xE9change."
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735429
    m_Localized: "Apporte 1 rapport ramass\xE9 \xE0 \xE9changer."
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735430
    m_Localized: "Fais de la place pour la boisson. Aucun rapport d\xE9pens\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735431
    m_Localized: "Cet \xE9change est indisponible. Aucun rapport d\xE9pens\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735432
    m_Localized: "1 rapport \xE9chang\xE9 contre 1 boisson \xE9nergisante."
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735433
    m_Localized: Saute les notes basses et accroupis-toi sous les hautes. Attends
      la fin du clignotement de protection avant de relancer.
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735434
    m_Localized: "{0} \xB7 WC \u2014 entrer dans les toilettes"
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735435
    m_Localized: "{0} \xB7 Retourner en salle de travaux pratiques"
    m_Metadata:
      m_Items: []
  - m_Id: 93463029735436
    m_Localized: "{0} Retour en classe \xB7 {1} \xE0 la porte des WC"
    m_Metadata:
      m_Items: []
  - m_Id: 745201730576384
    m_Localized: "R\xE9ussissez d\u2019abord l\u2019examen de cette salle pour ouvrir
      cette porte."
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685248
    m_Localized: "Tu as quitt\xE9 la salle : l\u2019examen est annul\xE9. Reviens
      le recommencer quand tu es pr\xEAt."
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685249
    m_Localized: "{0} \u2014 quitter la salle (annule l\u2019examen)"
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685250
    m_Localized: "Contr\xF4le du gardien : cache tes antis\xE8ches encore {0} s !
      Accroupis-toi ou reste dans son dos."
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685251
    m_Localized: "Le gardien t\u2019a vu utiliser tes antis\xE8ches ! Elles sont
      confisqu\xE9es et l\u2019examen est annul\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685252
    m_Localized: "Dans la deuxi\xE8me salle, r\xE9vise honn\xEAtement au bureau ou
      prends les antis\xE8ches cach\xE9es dans les WC. Les porter ne risque rien
      avant l\u2019examen. Au d\xE9but de l\u2019examen, le gardien inspecte la salle
      quelques secondes : reste hors de sa vue, accroupis-toi ou place-toi dans son
      dos. Pendant l\u2019examen, interagis pr\xE8s du prof pour utiliser tes antis\xE8ches
      (quatre touches au lieu de six), mais seulement quand le gardien ne te voit
      pas. S\u2019il te prend, elles sont confisqu\xE9es et l\u2019examen est annul\xE9.
      Quitter la salle pendant un examen l\u2019annule aussi."
    m_Metadata:
      m_Items: []
  - m_Id: 748101240348672
    m_Localized: 'Sommeil : {0}

      Intellect : {1}

      Rapports : {2}'
    m_Metadata:
      m_Items: []
  - m_Id: 748101244542976
    m_Localized: "Examen {0}/3 \xB7 touches restantes : {1} sur {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 748101244542977
    m_Localized: "Plus de rapports ramass\xE9s. Trouves-en dans les salles suivantes
      ou demande \xE0 ton amie dans la derni\xE8re ; {0} en lance de nouveaux pour
      1 Sommeil."
    m_Metadata:
      m_Items: []
  - m_Id: 748101244542978
    m_Localized: "Elle r\xE9vise. Reviens pendant ta pr\xE9paration \xE0 l\u2019examen
      final."
    m_Metadata:
      m_Items: []
  - m_Id: 748101244542979
    m_Localized: "R\xE9vise une fois au bureau, puis reviens : elle te donnera 2
      rapports."
    m_Metadata:
      m_Items: []
  - m_Id: 748101244542980
    m_Localized: "Plus rien \xE0 faire avec elle pour l\u2019instant. Bonne chance
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 772983596507136
    m_Localized: "{0} \xB7 Dormir dans le lit (rend du Sommeil)"
    m_Metadata:
      m_Items: []
  - m_Id: 772983600701440
    m_Localized: "Tu viens de dormir. Le lit t\u2019aidera \xE0 nouveau dans quelques
      minutes."
    m_Metadata:
      m_Items: []
  - m_Id: 772983600701441
    m_Localized: "Bien dormi : Sommeil remont\xE9 \xE0 10 et esprit plus clair."
    m_Metadata:
      m_Items: []
  - m_Id: 772983600701442
    m_Localized: "Tu es parfaitement repos\xE9. Inutile de dormir."
    m_Metadata:
      m_Items: []
  - m_Id: 772983600701443
    m_Localized: Pas de sieste pendant un examen !
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895744
    m_Localized: "{0} \xB7 Cuisiner un repas (+1 nourriture \xE0 emporter)"
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895745
    m_Localized: "{0} \xB7 Faire un caf\xE9 serr\xE9 (coup de boost, puis coup de
      barre)"
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895746
    m_Localized: "Tu as cuisin\xE9 un repas \xE0 emporter. S\xE9lectionne-le et utilise-le
      pour r\xE9cup\xE9rer du Sommeil."
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895747
    m_Localized: "Caf\xE9 serr\xE9 ! Sommeil et vitesse en plus pendant 20 secondes,
      puis coup de barre."
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895748
    m_Localized: "Attends une minute ou deux avant de r\xE9utiliser la cuisine."
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895749
    m_Localized: "L\u2019\xE9tudiante sympa attend dans la troisi\xE8me salle, celle
      de l\u2019examen final : r\xE9ussis l\u2019examen 2 et prends la porte avant
      de la salle de TP. Un c\u0153ur rose au-dessus d\u2019elle signifie que tu
      peux lui parler. Cette salle te donne deux cr\xE9neaux libres. R\xE9viser en
      co\xFBte un et ajoute de la pr\xE9paration. Flirter co\xFBte un cr\xE9neau
      et un rapport ramass\xE9. R\xE9vise deux fois pour l\u2019examen le plus facile,
      ou flirte et r\xE9vise une fois, puis reviens la voir pour deux rapports gratuits."
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895750
    m_Localized: "L\u2019examen n\u2019a pas commenc\xE9 : appuie d\u2019abord sur
      {0} pr\xE8s du prof. Avant cela, les lancers ne servent \xE0 rien."
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895751
    m_Localized: "Pr\xE9pare-toi d\u2019abord (r\xE9vise au bureau ou trouve les
      antis\xE8ches), puis appuie sur {0} pr\xE8s du prof. Avant l\u2019examen, les
      lancers ne servent \xE0 rien."
    m_Metadata:
      m_Items: []
  - m_Id: 774744583430144
    m_Localized: "{0} \xB7 Pr\xE9parer des rapports sur le PC (2 Sommeil \u2192 2
      rapports, une fois par examen)"
    m_Metadata:
      m_Items: []
  - m_Id: 774744591818752
    m_Localized: "Tu as d\xE9j\xE0 pr\xE9par\xE9 des rapports pour cet examen. R\xE9ussis-le
      pour r\xE9utiliser le PC."
    m_Metadata:
      m_Items: []
  - m_Id: 774744591818753
    m_Localized: "Trop fatigu\xE9 pour travailler : il faut plus de 2 Sommeil. Mange
      ou repose-toi d\u2019abord."
    m_Metadata:
      m_Items: []
  - m_Id: 774744591818754
    m_Localized: "Tu as pr\xE9par\xE9 2 rapports pendant la nuit (\u22122 Sommeil).
      Les lancer ne co\xFBte rien."
    m_Metadata:
      m_Items: []
  - m_Id: 775002260496384
    m_Localized: "{0} \xB7 Changer de tenue"
    m_Metadata:
      m_Items: []
  - m_Id: 775002264690688
    m_Localized: 'Tenue : {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 775002264690689
    m_Localized: "Tenue : {0}. R\xE9ussis des examens pour en d\xE9bloquer d\u2019autres."
    m_Metadata:
      m_Items: []
