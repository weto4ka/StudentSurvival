  - m_Id: 1085267968
    m_Localized: Studierendenleben
    m_Metadata:
      m_Items: []
  - m_Id: 1156571136
    m_Localized: Hol dir den Abschluss. Bleib wach.
    m_Metadata:
      m_Items: []
  - m_Id: 1164959744
    m_Localized: Spiel starten
    m_Metadata:
      m_Items: []
  - m_Id: 1164959745
    m_Localized: Einstellungen
    m_Metadata:
      m_Items: []
  - m_Id: 1164959746
    m_Localized: Spielanleitung
    m_Metadata:
      m_Items: []
