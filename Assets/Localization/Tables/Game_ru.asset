  - m_Id: 80304193658916
    m_Localized: "\u0421\u0435\u043C\u0435\u0441\u0442\u0440 \u0441\u0434\u0430\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658917
    m_Localized: "\u0422\u0440\u0438 \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u044F,
      \u0442\u0440\u0438 \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430. \u041F\u0435\u0440\u0432\u044B\u0439
      \u0441\u0435\u043C\u0435\u0441\u0442\u0440 \u043F\u043E\u0437\u0430\u0434\u0438.
      \u041F\u0435\u0440\u0435\u0434\u043E\u0445\u043D\u0438 \u2014 \u0442\u044B
      \u044D\u0442\u043E \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658918
    m_Localized: "\u0421\u0434\u0430\u0439 \u0442\u0440\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430, \u0447\u0442\u043E\u0431\u044B
      \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0441\u0435\u043C\u0435\u0441\u0442\u0440.
      \u0421\u043E\u0431\u0438\u0440\u0430\u0439 \u043F\u0440\u0438\u043F\u0430\u0441\u044B,
      \u0433\u043E\u0442\u043E\u0432\u044C\u0441\u044F, \u0437\u0430\u0442\u0435\u043C
      \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0439
      \u0441 \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u0435\u043C,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0447\u0430\u0442\u044C. \u041F\u043E\u0441\u043B\u0435
      \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430 \u0438\u0434\u0438 \u0447\u0435\u0440\u0435\u0437
      \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u0443\u044E \u0434\u0432\u0435\u0440\u044C
      \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658919
    m_Localized: "\u0421\u043F\u0440\u044F\u0442\u0430\u043D\u043D\u044B\u0435 \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438
      \u0438 \u0431\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658920
    m_Localized: "\u0412\u043E \u0432\u0442\u043E\u0440\u043E\u0439 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0438
      \u0447\u0435\u0441\u0442\u043D\u043E \u043F\u043E\u0432\u0442\u043E\u0440\u0438
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C
      \u0438\u043B\u0438 \u0432\u043E\u0437\u044C\u043C\u0438 \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438,
      \u0441\u043F\u0440\u044F\u0442\u0430\u043D\u043D\u044B\u0435 \u0432 \u0442\u0443\u0430\u043B\u0435\u0442\u043D\u043E\u0439
      \u043D\u0438\u0448\u0435. \u0415\u0441\u043B\u0438 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u0432\u0438\u0434\u0438\u0442 \u0442\u0435\u0431\u044F \u0441\u043E \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0430\u043C\u0438,
      \u0435\u0433\u043E \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u0435
      \u0440\u0430\u0441\u0442\u0451\u0442. \u041F\u0440\u0438\u0433\u043D\u0438\u0441\u044C
      \u0438\u043B\u0438 \u0441\u043F\u0440\u044F\u0447\u044C\u0441\u044F \u0432
      \u043D\u0438\u0448\u0435, \u0447\u0442\u043E\u0431\u044B \u043E\u043D\u043E
      \u0441\u043F\u0430\u043B\u043E. \u0415\u0441\u043B\u0438 \u043F\u043E\u0439\u043C\u0430\u0435\u0442,
      \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438 \u0437\u0430\u0431\u0435\u0440\u0443\u0442,
      \u0430 \u044D\u043A\u0437\u0430\u043C\u0435\u043D \u043F\u0440\u0435\u0440\u0432\u0443\u0442;
      \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C\u0441\u044F \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439
      \u0441\u043D\u043E\u0432\u0430. \u0412\u043E \u0432\u0440\u0435\u043C\u044F
      \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430 \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0439
      \u0440\u044F\u0434\u043E\u043C \u0441 \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u0435\u043C,
      \u0447\u0442\u043E\u0431\u044B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438: \u0447\u0435\u0442\u044B\u0440\u0435
      \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F \u0432\u043C\u0435\u0441\u0442\u043E
      \u0448\u0435\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658921
    m_Localized: "\u0414\u0432\u0435 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0435
      \u043F\u0430\u0440\u044B \u043F\u0435\u0440\u0435\u0434 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C
      \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658922
    m_Localized: "\u0412 \u0442\u0440\u0435\u0442\u044C\u0435\u0439 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0438
      \u0443 \u0442\u0435\u0431\u044F \u0434\u0432\u0435 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0435
      \u043F\u0430\u0440\u044B. \u0423\u0447\u0451\u0431\u0430 \u0442\u0440\u0430\u0442\u0438\u0442
      \u043E\u0434\u043D\u0443 \u0438 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442
      \u043E\u0434\u0438\u043D \u0431\u0430\u043B\u043B \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438.
      \u0424\u043B\u0438\u0440\u0442 \u0442\u0440\u0430\u0442\u0438\u0442 \u043E\u0434\u043D\u0443
      \u043F\u0430\u0440\u0443 \u0438 \u043E\u0434\u043D\u0443 \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u0443\u044E
      \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0443\u044E. \u0423\u0447\u0438\u0441\u044C
      \u0434\u0432\u0430\u0436\u0434\u044B, \u0447\u0442\u043E\u0431\u044B \u044D\u043A\u0437\u0430\u043C\u0435\u043D
      \u0431\u044B\u043B \u0441\u0430\u043C\u044B\u043C \u043B\u0451\u0433\u043A\u0438\u043C,
      \u0438\u043B\u0438 \u043F\u043E\u0444\u043B\u0438\u0440\u0442\u0443\u0439 \u0438
      \u043F\u043E\u0443\u0447\u0438\u0441\u044C \u043E\u0434\u0438\u043D \u0440\u0430\u0437,
      \u0430 \u0437\u0430\u0442\u0435\u043C \u0432\u0435\u0440\u043D\u0438\u0441\u044C
      \u043A \u0434\u0440\u0443\u0433\u0443 \u0437\u0430 \u0434\u0432\u0443\u043C\u044F
      \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u043C\u0438 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u044B\u043C\u0438.
      \u041C\u043E\u0436\u043D\u043E \u0442\u0430\u043A\u0436\u0435 \u043F\u043E\u0439\u0442\u0438
      \u043D\u0430 \u0431\u043E\u043B\u0435\u0435 \u0441\u043B\u043E\u0436\u043D\u044B\u0439
      \u044D\u043A\u0437\u0430\u043C\u0435\u043D \u0441 \u043C\u0435\u043D\u044C\u0448\u0435\u0439
      \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u043E\u0439. \u0421\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
      \u0432\u0438\u0434\u043D\u0430 \u0434\u043E \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658923
    m_Localized: "\u0420\u0430\u0437\u043D\u044B\u0435 \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u0438
      \u2014 \u0440\u0430\u0437\u043D\u044B\u0435 \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658924
    m_Localized: "\u041F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440 Byte \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
      \u0441 \u043D\u0438\u0437\u043A\u0438\u0445 \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u044B\u0445
      \u0431\u0440\u043E\u0441\u043A\u043E\u0432. \u0414\u043E\u043A\u0442\u043E\u0440
      Redline \u0447\u0435\u0440\u0435\u0434\u0443\u0435\u0442 \u0432\u044B\u0441\u043E\u043A\u0438\u0435
      \u0438 \u043D\u0438\u0437\u043A\u0438\u0435 \u043E\u0447\u0435\u0440\u0435\u0434\u0438.
      \u041F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440 Deadline \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u0442
      \u0431\u043E\u043B\u0435\u0435 \u0434\u043B\u0438\u043D\u043D\u044B\u0435 \u0437\u0430\u043B\u043F\u044B
      \u0441\u043E \u0441\u043C\u0435\u043D\u043E\u0439 \u0432\u044B\u0441\u043E\u0442\u044B.
      \u041D\u0430\u0447\u0438\u043D\u0430\u0439 \u043A\u0430\u0436\u0434\u044B\u0439
      \u044D\u043A\u0437\u0430\u043C\u0435\u043D \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C
      \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F;
      \u0441\u043B\u0435\u0434\u0438 \u0437\u0430 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F\u043C\u0438
      \u0438 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430\u043C\u0438 \u043F\u0440\u044B\u0433\u043D\u0443\u0442\u044C
      \u0438\u043B\u0438 \u043F\u0440\u0438\u0433\u043D\u0443\u0442\u044C\u0441\u044F.
      \u0421\u0434\u0430\u043D\u043D\u044B\u0439 \u044D\u043A\u0437\u0430\u043C\u0435\u043D
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E
      \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u044E \u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u0443\u044E \u0442\u043E\u0447\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658925
    m_Localized: "{0}: \u044D\u043A\u0437\u0430\u043C\u0435\u043D \u043D\u0430\u0447\u0430\u043B\u0441\u044F.
      \u0421\u043B\u0435\u0434\u0438 \u0437\u0430 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435\u043C
      \u0438 \u0443\u043A\u043B\u043E\u043D\u044F\u0439\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658926
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658927
    m_Localized: "\u0421\u0435\u043C\u0435\u0441\u0442\u0440 \u0441\u0434\u0430\u043D!
      \u0418\u0441\u0441\u043B\u0435\u0434\u0443\u0439 \u0434\u0430\u043B\u044C\u0448\u0435:
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F.
      \u041D\u043E\u0432\u0430\u044F \u0438\u0433\u0440\u0430 \u2014 \u043F\u043E
      \u0436\u0435\u043B\u0430\u043D\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658928
    m_Localized: "\u0421\u0435\u043C\u0435\u0441\u0442\u0440 \u0441\u0434\u0430\u043D
      \xB7 \u0418\u0441\u0441\u043B\u0435\u0434\u0443\u0439 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658929
    m_Localized: "\u041F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u044C
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \xB7 \u0412\u044B\u0431\u0435\u0440\u0438 \u043C\u043E\u043C\u0435\u043D\u0442
      \u0434\u043B\u044F \u0431\u0440\u043E\u0441\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658930
    m_Localized: "\u041D\u0430\u0447\u0438\u043D\u0430\u0439 \u044D\u043A\u0437\u0430\u043C\u0435\u043D
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F.
      \u0411\u0430\u0439\u0442 \u0431\u0440\u043E\u0441\u0430\u0435\u0442 \u0434\u0432\u0435
      \u043D\u0438\u0437\u043A\u0438\u0435 \u043E\u0446\u0435\u043D\u043A\u0438,
      \u041A\u0440\u0430\u0441\u043D\u0430\u044F \u0420\u0443\u0447\u043A\u0430 \u2014
      \u043F\u0430\u0440\u044B \u043D\u0430 \u0440\u0430\u0437\u043D\u043E\u0439
      \u0432\u044B\u0441\u043E\u0442\u0435, \u0414\u0435\u0434\u043B\u0430\u0439\u043D
      \u2014 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435 \u0442\u0440\u043E\u0439\u043A\u0438.
      \u0421\u043B\u0435\u0434\u0438 \u0437\u0430 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435\u043C
      \u0438 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430\u043C\u0438 \u043F\u0440\u044B\u0436\u043A\u0430
      \u0438 \u043F\u0440\u0438\u0441\u0435\u0434\u0430\u043D\u0438\u044F. \u041F\u043E\u0441\u043B\u0435
      \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u044C
      \u043C\u0438\u0433\u0430\u0435\u0442 \u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
      \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u0443\u0440\u043E\u043D:
      \u0434\u0435\u043B\u0430\u0439 \u043F\u0430\u0443\u0437\u044B \u043C\u0435\u0436\u0434\u0443
      \u0431\u0440\u043E\u0441\u043A\u0430\u043C\u0438. \u0421\u0434\u0430\u043D\u043D\u044B\u0439
      \u044D\u043A\u0437\u0430\u043C\u0435\u043D \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E \u043A\u043E\u043C\u043D\u0430\u0442\u0443;
      \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
      \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
