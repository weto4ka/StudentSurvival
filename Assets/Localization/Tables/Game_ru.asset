    m_Metadata:
      m_Items: []
  - m_Id: 39276505980962
    m_Localized: "\u041D\u0423\u041B\u042C \u0421\u041D\u0410 \xB7 {0} \u0441 \u043D\u0430
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435!
      \u0412\u044B\u0431\u0435\u0440\u0438 \u0435\u0434\u0443/\u043D\u0430\u043F\u0438\u0442\u043E\u043A,
      \u0437\u0430\u0442\u0435\u043C {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980963
    m_Localized: "\u0423\u0436\u0435 \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u0431\u0443\u0436\u0434\u0451\u043D.
      \u0414\u043E\u0436\u0434\u0438\u0441\u044C \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043D\u0430\u043F\u0438\u0442\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980964
    m_Localized: "\u041D\u0435\u0442 \u0421\u043D\u0430 \u0434\u043B\u044F \u043D\u043E\u0432\u043E\u0439
      \u0440\u0430\u0431\u043E\u0442\u044B. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
      \u0435\u0434\u0443, \u043D\u0430\u043F\u0438\u0442\u043E\u043A \u0438\u043B\u0438
      \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980965
    m_Localized: "\u041F\u043E\u0440\u0430 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C
      \u0434\u043E\u043B\u0433 \u043A\u043E\u0444\u0435\u0438\u043D\u0443. \u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435
      \u0438 \u0440\u0435\u0430\u043A\u0446\u0438\u044F \u0437\u0430\u043C\u0435\u0434\u043B\u0435\u043D\u044B
      \u043D\u0430 10 \u0441\u0435\u043A\u0443\u043D\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980966
    m_Localized: "{0} \u0424\u043B\u0438\u0440\u0442\u043E\u0432\u0430\u0442\u044C
      \xB7 \u0441\u0442\u043E\u0438\u0442 1 \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u0443\u044E
      \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0443\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980967
    m_Localized: "\u0422\u0432\u043E\u044F \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0430\u044F
      \u0441\u0442\u0430\u043B\u0430 \u043B\u044E\u0431\u043E\u0432\u043D\u044B\u043C
      \u043F\u0438\u0441\u044C\u043C\u043E\u043C. \u042D\u043A\u0437\u0430\u043C\u0435\u043D
      \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442..."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980968
    m_Localized: "\u041D\u0435\u0442 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u043E\u0439
      \u0434\u043B\u044F \u043B\u044E\u0431\u043E\u0432\u043D\u043E\u0433\u043E \u043F\u0438\u0441\u044C\u043C\u0430.
      \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430\u0439\u0434\u0438 \u0440\u0430\u0431\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980969
    m_Localized: "+3 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
      \u0421\u043D\u0430, 20 \u0441 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438,
      \u0437\u0430\u0442\u0435\u043C 10 \u0441 \u0437\u0430\u043C\u0435\u0434\u043B\u0435\u043D\u0438\u044F.
      \u041D\u0435\u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439 \u0421\u043E\u043D \u0438\u0441\u0447\u0435\u0437\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980970
    m_Localized: "\u0421\u0434\u0430\u0439 \u0434\u0432\u0430 \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430.
      \u0421\u043E\u0431\u0438\u0440\u0430\u0439 \u043F\u0440\u0438\u043F\u0430\u0441\u044B:
      {0}, \u0438 \u0441\u043B\u0435\u0434\u0443\u0439 \u0441\u0442\u0440\u0435\u043B\u043A\u0435.
      \u041D\u043E\u0432\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430 ({1}) \u0441\u0442\u043E\u0438\u0442
      1 \u0421\u043E\u043D; \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u0430\u044F
      \u2014 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E: \u0432\u044B\u0431\u0435\u0440\u0438
      \u0438 {2}. \u041A\u043D\u0438\u0433\u0438 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0442
      \u0418\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442, \u0435\u0434\u0430
      \u2014 \u0421\u043E\u043D.\n\n\u041F\u0440\u0438 \u043D\u0443\u043B\u0435 \u0421\u043D\u0430
      \u0435\u0441\u0442\u044C 8 \u0441\u0435\u043A\u0443\u043D\u0434 \u043D\u0430
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435.
      \u041D\u0430\u043F\u0438\u0442\u043E\u043A \u0434\u0430\u0451\u0442 \u0432\u0437\u0430\u0439\u043C\u044B
      3 \u0421\u043D\u0430 \u0438 \u0443\u0441\u043A\u043E\u0440\u044F\u0435\u0442
      \u043D\u0430 20 \u0441, \u0437\u0430\u0442\u0435\u043C \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442
      \u043D\u0435\u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u0431\u043E\u043D\u0443\u0441 \u0438 \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442
      \u0440\u0435\u0430\u043A\u0446\u0438\u044E \u043D\u0430 10 \u0441. \u042D\u0444\u0444\u0435\u043A\u0442\u044B
      \u043D\u0430\u043F\u0438\u0442\u043A\u043E\u0432 \u043D\u0435 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F.
      \u0424\u043B\u0438\u0440\u0442 \u2014 \u043F\u043E \u0436\u0435\u043B\u0430\u043D\u0438\u044E,
      \u0446\u0435\u043D\u0430: \u043E\u0434\u043D\u0430 \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u0430\u044F
      \u0440\u0430\u0431\u043E\u0442\u0430.\n\n\u041D\u043E\u043B\u044C \u0418\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0430
      \u0438\u043B\u0438 \u043A\u043E\u043D\u0435\u0446 \u043E\u0442\u0441\u0447\u0451\u0442\u0430
      \u2014 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435. \u041F\u043E\u0441\u043B\u0435
      \u043D\u0435\u0433\u043E \u2014 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u0430\u044F
      \u0442\u043E\u0447\u043A\u0430; \u043C\u0435\u043D\u044E \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980971
    m_Localized: "\u0422\u044B \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u043E\u043B\u0433\u043E
      \u0431\u044B\u043B \u0431\u0435\u0437 \u0421\u043D\u0430. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
      \u0435\u0434\u0443 \u0438\u043B\u0438 \u043D\u0430\u043F\u0438\u0442\u043E\u043A
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u043E\u0442\u0441\u0447\u0451\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 44367438929920
    m_Localized: "\u041A\u0430\u043A \u0438\u0433\u0440\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398912
    m_Localized: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398913
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435,
      \u0447\u0442\u043E\u0431\u044B \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
      \u043A\u043D\u043E\u043F\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398914
    m_Localized: "\u0422\u0432\u043E\u044F \u0446\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398915
    m_Localized: "\u0421\u0434\u0430\u0439 \u0434\u0432\u0430 \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u0434\u0438\u043F\u043B\u043E\u043C. \u0421\u043B\u0435\u0434\u0443\u0439
      \u0441\u0442\u0440\u0435\u043B\u043A\u0435 \u043A \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0438
      \u0438 \u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0441\u044F \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438
      \u0434\u0432\u0435\u0440\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398916
    m_Localized: "\u0421\u043E\u0431\u0438\u0440\u0430\u0439 \u043F\u0440\u0438\u043F\u0430\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398917
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 {0} \u0443 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430
      \u0438\u043B\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439 \u0434\u0432\u0435\u0440\u0438.
      \u0415\u0434\u0430 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0421\u043E\u043D, \u043A\u043D\u0438\u0433\u0438 \u2014 \u0418\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442.
      \u0412\u044B\u0431\u0435\u0440\u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
      \u0432 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435, \u0447\u0442\u043E\u0431\u044B
      \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0435\u0433\u043E \u044D\u0444\u0444\u0435\u043A\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398918
    m_Localized: "\u0421\u0440\u0430\u0436\u0430\u0439\u0441\u044F \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u044B\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398919
    m_Localized: "\u041D\u043E\u0432\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430
      \u043A\u043D\u043E\u043F\u043A\u043E\u0439 {0} \u0441\u0442\u043E\u0438\u0442
      1 \u0421\u043E\u043D. \u0421\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435
      \u0440\u0430\u0431\u043E\u0442\u044B \u2014 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0435
      \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u044B: \u0432\u044B\u0431\u0435\u0440\u0438
      \u0440\u0430\u0431\u043E\u0442\u0443 \u0438 \u043D\u0430\u0436\u043C\u0438
      {1}. \u041D\u0438\u0437\u043A\u0438\u0435 \u0431\u0440\u043E\u0441\u043A\u0438
      \u043F\u0435\u0440\u0435\u043F\u0440\u044B\u0433\u0438\u0432\u0430\u0439, \u043E\u0442
      \u0432\u044B\u0441\u043E\u043A\u0438\u0445 \u043F\u0440\u0438\u0441\u0435\u0434\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398920
    m_Localized: "\u0423 \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u0435\u0441\u0442\u044C
      \u0446\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398921
    m_Localized: "\u041D\u0430\u043F\u0438\u0442\u043E\u043A \u0434\u0430\u0451\u0442
      3 \u0421\u043D\u0430 \u0432\u0437\u0430\u0439\u043C\u044B \u0438 \u0443\u0441\u043A\u043E\u0440\u044F\u0435\u0442
      \u043D\u0430 20 \u0441\u0435\u043A\u0443\u043D\u0434. \u041F\u043E\u0442\u043E\u043C
      \u043D\u0435\u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u0431\u043E\u043D\u0443\u0441 \u0438\u0441\u0447\u0435\u0437\u0430\u0435\u0442,
      \u0430 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442\u0441\u044F
      \u043D\u0430 10 \u0441\u0435\u043A\u0443\u043D\u0434. \u041F\u0440\u0438 \u043D\u0443\u043B\u0435
      \u0421\u043D\u0430 \u0435\u0441\u0442\u044C 8 \u0441\u0435\u043A\u0443\u043D\u0434
      \u043D\u0430 \u0435\u0434\u0443 \u0438\u043B\u0438 \u043D\u0430\u043F\u0438\u0442\u043E\u043A.
      \u041D\u043E\u043B\u044C \u0418\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0430
      \u2014 \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E\u0435 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398922
    m_Localized: "\u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0438
      \u043F\u043E\u0432\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398923
    m_Localized: "\u0412\u044B\u0445\u043E\u0434 \u0432 \u043C\u0435\u043D\u044E
      \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441. \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0435\u0433\u043E. \u041F\u043E\u0441\u043B\u0435 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F
      \u041F\u043E\u0432\u0442\u043E\u0440 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442
      \u043A \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u043E\u0439 \u0442\u043E\u0447\u043A\u0435,
      \u043E\u0442\u043C\u0435\u043D\u044F\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u0438 \u0443\u0440\u043E\u043D.
      \u041D\u043E\u0432\u0430\u044F \u0438\u0433\u0440\u0430 \u0437\u0430\u043C\u0435\u043D\u044F\u0435\u0442
      \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398924
    m_Localized: "\u0417\u0430\u043C\u0430\u043D\u0447\u0438\u0432\u044B\u0439 \u043F\u0435\u0440\u0435\u0440\u044B\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398925
    m_Localized: "\u0424\u043B\u0438\u0440\u0442 \u0441\u043E \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043A\u043E\u0439
      \u2014 \u043F\u043E \u0436\u0435\u043B\u0430\u043D\u0438\u044E. \u0412\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
      \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u043E\u0434\u043D\u0443
      \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443
      \u0432 \u043B\u044E\u0431\u043E\u0432\u043D\u043E\u0435 \u043F\u0438\u0441\u044C\u043C\u043E.
      \u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E \u043C\u043E\u0436\u043D\u043E
      \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E. \u041E\u0434\u0438\u043D
      \u0440\u0430\u0437 \u0437\u0430 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435."
    m_Metadata:
