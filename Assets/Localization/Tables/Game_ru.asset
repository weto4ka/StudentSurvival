    m_Localized: "{0} \u042D\u043A\u0437\u0430\u043C\u0435\u043D \u0438\u0434\u0451\u0442
      \xB7 \u0431\u0440\u043E\u0441\u0430\u0439 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u044B\u0435
      \u0438 \u0443\u043A\u043B\u043E\u043D\u044F\u0439\u0441\u044F"
    m_Metadata:
