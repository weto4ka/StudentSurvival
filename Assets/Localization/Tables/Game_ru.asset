  - m_Id: 39276505980929
    m_Localized: "\u0421 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u043E\u0439
      \u0442\u043E\u0447\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980930
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0437\u0430\u043D\u043E\u0432\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980931
    m_Localized: "\u042D\u0442\u043E \u0437\u0430\u043C\u0435\u043D\u0438\u0442 \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D\u043D\u0443\u044E
      \u0438\u0433\u0440\u0443 \u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u0443\u044E
      \u0442\u043E\u0447\u043A\u0443. \u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438
      \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980932
    m_Localized: "\u041A \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u043E\u0439
      \u0442\u043E\u0447\u043A\u0435: \u043D\u0430\u0447\u0430\u043B\u043E, \u043F\u0435\u0440\u0435\u0445\u043E\u0434
      \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0435\u0440\u044C \u0438\u043B\u0438
      \u043F\u0435\u0440\u0435\u0440\u044B\u0432 \u043F\u043E\u0441\u043B\u0435 \u043F\u0435\u0440\u0432\u043E\u0433\u043E
      \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430. \u041F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
      \u043D\u0430\u0445\u043E\u0434\u043A\u0438 \u0438 \u0443\u0440\u043E\u043D
      \u043E\u0442\u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980933
    m_Localized: "\u0418\u0433\u0440\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980934
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C.
      \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u043C\u0435\u0441\u0442\u043E
      \u0438 \u0434\u043E\u0441\u0442\u0443\u043F \u043A \u043F\u0430\u043F\u043A\u0435
      \u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980935
    m_Localized: "\u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u043D\u0435
      \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F. \u041F\u0440\u0438 \u043D\u0430\u043B\u0438\u0447\u0438\u0438
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0440\u0435\u0437\u0435\u0440\u0432\u043D\u0430\u044F
      \u043A\u043E\u043F\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980936
    m_Localized: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E \u0434\u043B\u044F
      \u0437\u0430\u0449\u0438\u0442\u044B \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F.
      \u0412\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C \u0432 \u043C\u0435\u043D\u044E
      \u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980937
    m_Localized: "\u041F\u0435\u0440\u0435\u0436\u0438\u0432\u0438 \u0441\u0435\u0441\u0441\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980938
    m_Localized: "\u0412\u043F\u0435\u0440\u0451\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980939
    m_Localized: "\u0421\u0434\u0430\u0439 \u0434\u0432\u0430 \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430
      \u0438 \u043F\u043E\u043B\u0443\u0447\u0438 \u0434\u0438\u043F\u043B\u043E\u043C.
      \u0421\u043E\u0431\u0438\u0440\u0430\u0439 \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u043A\u043D\u043E\u043F\u043A\u043E\u0439 {0} \u0438 \u0441\u043B\u0435\u0434\u0443\u0439
      \u0441\u0442\u0440\u0435\u043B\u043A\u0435 \u043A \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0438.\n\n\u041D\u043E\u0432\u0430\u044F
      \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0430\u044F ({1})
      \u0441\u0442\u043E\u0438\u0442 1 \u0421\u043E\u043D: \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u0438\u0435
      \u043E\u0442\u043D\u0438\u043C\u0430\u0435\u0442 \u0441\u0438\u043B\u044B.
      \u0421\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435 \u0440\u0430\u0431\u043E\u0442\u044B
      \u0433\u043E\u0442\u043E\u0432\u044B: \u0432\u044B\u0431\u0435\u0440\u0438
      \u0440\u0430\u0431\u043E\u0442\u0443 \u0438 \u043D\u0430\u0436\u043C\u0438
      {2}, \u0447\u0442\u043E\u0431\u044B \u0431\u0440\u043E\u0441\u0438\u0442\u044C
      \u0431\u0435\u0437 \u0437\u0430\u0442\u0440\u0430\u0442 \u0421\u043D\u0430.
      \u0415\u0434\u0430 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0421\u043E\u043D, \u043A\u043D\u0438\u0433\u0438 \u2014 \u0418\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442.\n\n\u041D\u043E\u043B\u044C
      \u0421\u043D\u0430 \u0438\u043B\u0438 \u0418\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0430
      \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442 \u043F\u043E\u043F\u044B\u0442\u043A\u0443.
      \u041F\u043E\u0441\u043B\u0435 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F
