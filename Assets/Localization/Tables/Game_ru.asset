    m_Metadata:
      m_Items: []
  - m_Id: 27822486708228
    m_Localized: "\u0412 \u043E\u043A\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708229
    m_Localized: "\u0421\u043E\u0431\u0438\u0440\u0430\u0439 \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u0438 \u0441\u0434\u0430\u0439 \u0434\u0432\u0430 \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430.
      \u0421\u043E\u043D \u0438 \u0418\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442
      \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u0442\u044C \u0432\u044B\u0448\u0435
      \u043D\u0443\u043B\u044F. \u0412\u044B\u0441\u0442\u0440\u0435\u043B \u0441\u0442\u043E\u0438\u0442
      1 \u0421\u043E\u043D; \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435
      \u0440\u0430\u0431\u043E\u0442\u044B \u2014 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0435
      \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u044B. \u0412\u044B\u0431\u0435\u0440\u0438
      \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u043D\u0438\u0436\u0435,
      \u0447\u0442\u043E\u0431\u044B \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
      \u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708230
    m_Localized: "\u041A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0430 /
