  - m_Id: 745201730576384
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0441\u0434\u0430\u0439
      \u044D\u043A\u0437\u0430\u043C\u0435\u043D \u0432 \u044D\u0442\u043E\u0439
      \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0438, \u0447\u0442\u043E\u0431\u044B
      \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u044D\u0442\u0443 \u0434\u0432\u0435\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685248
    m_Localized: "\u0422\u044B \u0432\u044B\u0448\u0435\u043B \u0438\u0437 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0438,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u044D\u043A\u0437\u0430\u043C\u0435\u043D
      \u043E\u0442\u043C\u0435\u043D\u0451\u043D. \u0412\u0435\u0440\u043D\u0438\u0441\u044C
      \u0438 \u043D\u0430\u0447\u043D\u0438 \u0435\u0433\u043E \u0441\u043D\u043E\u0432\u0430,
      \u043A\u043E\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0448\u044C \u0433\u043E\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685249
    m_Localized: "{0} \u2014 \u0432\u044B\u0439\u0442\u0438 \u0438\u0437 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0438
      (\u044D\u043A\u0437\u0430\u043C\u0435\u043D \u0431\u0443\u0434\u0435\u0442
      \u043E\u0442\u043C\u0435\u043D\u0451\u043D)"
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685250
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430:
      \u0435\u0449\u0451 {0} \u0441 \u043D\u0435 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0439
      \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438! \u041F\u0440\u0438\u0433\u043D\u0438\u0441\u044C
      \u0438\u043B\u0438 \u0432\u0441\u0442\u0430\u043D\u044C \u0443 \u043D\u0435\u0433\u043E
      \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685251
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0443\u0432\u0438\u0434\u0435\u043B,
      \u043A\u0430\u043A \u0442\u044B \u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0448\u044C\u0441\u044F
      \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0430\u043C\u0438! \u0418\u0445
      \u0437\u0430\u0431\u0440\u0430\u043B\u0438, \u0430 \u044D\u043A\u0437\u0430\u043C\u0435\u043D
      \u043E\u0442\u043C\u0435\u043D\u0451\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685252
    m_Localized: "\u0412\u043E \u0432\u0442\u043E\u0440\u043E\u0439 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0438
      \u0447\u0435\u0441\u0442\u043D\u043E \u043F\u043E\u0432\u0442\u043E\u0440\u0438
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C
      \u0438\u043B\u0438 \u0432\u043E\u0437\u044C\u043C\u0438 \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438,
      \u0441\u043F\u0440\u044F\u0442\u0430\u043D\u043D\u044B\u0435 \u0432 WC. \u041D\u043E\u0441\u0438\u0442\u044C
      \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E,
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F
      \u044D\u043A\u0437\u0430\u043C\u0435\u043D. \u0412 \u043D\u0430\u0447\u0430\u043B\u0435
      \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0435\u043A\u0443\u043D\u0434
      \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u044E:
      \u043D\u0435 \u043F\u043E\u043F\u0430\u0434\u0430\u0439\u0441\u044F \u0435\u043C\u0443
      \u043D\u0430 \u0433\u043B\u0430\u0437\u0430, \u043F\u0440\u0438\u0433\u043D\u0438\u0441\u044C
      \u0438\u043B\u0438 \u0432\u0441\u0442\u0430\u043D\u044C \u0443 \u043D\u0435\u0433\u043E
      \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439. \u0412\u043E \u0432\u0440\u0435\u043C\u044F
      \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430 \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0439
      \u0440\u044F\u0434\u043E\u043C \u0441 \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u0435\u043C,
      \u0447\u0442\u043E\u0431\u044B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438 (\u0447\u0435\u0442\u044B\u0440\u0435
      \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F \u0432\u043C\u0435\u0441\u0442\u043E
      \u0448\u0435\u0441\u0442\u0438), \u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E
      \u043A\u043E\u0433\u0434\u0430 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u0442\u0435\u0431\u044F \u043D\u0435 \u0432\u0438\u0434\u0438\u0442. \u0415\u0441\u043B\u0438
      \u043E\u043D \u043F\u043E\u0439\u043C\u0430\u0435\u0442, \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438
      \u0437\u0430\u0431\u0435\u0440\u0443\u0442, \u0430 \u044D\u043A\u0437\u0430\u043C\u0435\u043D
      \u043E\u0442\u043C\u0435\u043D\u044F\u0442. \u0412\u044B\u0445\u043E\u0434
      \u0438\u0437 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0438 \u0432\u043E
      \u0432\u0440\u0435\u043C\u044F \u043B\u044E\u0431\u043E\u0433\u043E \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430
      \u0442\u043E\u0436\u0435 \u0435\u0433\u043E \u043E\u0442\u043C\u0435\u043D\u044F\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 748101240348672
    m_Localized: "\u0421\u043E\u043D: {0}\n\u0418\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442:
