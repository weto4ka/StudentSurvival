      {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706502
    m_Localized: "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439 {0}: \u0431\u0440\u043E\u0441\u0430\u0442\u044C
      (-1 \u0421\u043E\u043D \u0437\u0430 \u0440\u0430\u0431\u043E\u0442\u0443)"
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706503
    m_Localized: "\u041F\u0443\u0441\u0442\u0430\u044F \u044F\u0447\u0435\u0439\u043A\u0430.
      \u0421\u043E\u0431\u0438\u0440\u0430\u0439: {0}, \u0438\u043B\u0438 \u0431\u0440\u043E\u0441\u0430\u0439
      \u043D\u043E\u0432\u044B\u0435 \u0440\u0430\u0431\u043E\u0442\u044B: {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706504
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435 \u0440\u0430\u0431\u043E\u0442\u044B
      \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C. {0} \u0431\u0440\u043E\u0441\u0430\u0435\u0442
      \u043D\u043E\u0432\u044B\u0435 \u0437\u0430 \u0421\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706505
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0435 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u044B\u0435
      \u043B\u0435\u0436\u0430\u0442 \u043D\u0430 \u0437\u0435\u043C\u043B\u0435
      \u0441\u043F\u0440\u0430\u0432\u0430 \u043E\u0442 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0439
      \u043F\u043E\u0437\u0438\u0446\u0438\u0438. \u0418\u0434\u0438 \u043A \u043F\u0438\u043A\u0441\u0435\u043B\u044C\u043D\u043E\u043C\u0443
      \u043C\u0430\u0440\u043A\u0435\u0440\u0443 \u0438 \u043D\u0430\u0436\u043C\u0438
      {0} \u0440\u044F\u0434\u043E\u043C. \u0421\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0439
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438.
      \u0415\u0434\u0430 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0421\u043E\u043D, \u043A\u043D\u0438\u0433\u0438 - \u0418\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706506
    m_Localized: "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439 {0}, \u0447\u0442\u043E\u0431\u044B
      \u0431\u0440\u043E\u0441\u0430\u0442\u044C \u043D\u043E\u0432\u044B\u0435 \u0440\u0430\u0431\u043E\u0442\u044B
      (-1 \u0421\u043E\u043D \u0437\u0430 \u043A\u0430\u0436\u0434\u0443\u044E).
      \u0421\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435 \u0440\u0430\u0431\u043E\u0442\u044B
      - \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0435 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u044B:
      \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439 {1}, \u0447\u0442\u043E\u0431\u044B
      \u0431\u0440\u043E\u0441\u0430\u0442\u044C \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u0443\u044E
      \u043F\u0430\u0447\u043A\u0443. {2} / {3} \u0432\u044B\u0431\u0438\u0440\u0430\u044E\u0442
      \u0434\u0440\u0443\u0433\u043E\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442.
      \u0415\u0441\u043B\u0438 \u0432\u044B\u0431\u0440\u0430\u043D\u0430 \u0435\u0434\u0430,
      {1} \u0441\u044A\u0435\u0441\u0442 \u0435\u0451. \u0411\u0440\u043E\u0441\u043E\u043A
      \u0442\u0440\u0430\u0442\u0438\u0442 \u043E\u0434\u043D\u0443 \u0440\u0430\u0431\u043E\u0442\u0443;
      \u043F\u0443\u0441\u0442\u0430\u044F \u044F\u0447\u0435\u0439\u043A\u0430 \u043D\u0435
      \u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706507
    m_Localized: "\u041F\u0420\u042B\u0413\u0410\u0419: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706508
    m_Localized: "\u041F\u0420\u0418\u0421\u042F\u0414\u042C: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706509
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u044C
      \u0433\u043E\u0442\u043E\u0432\u0438\u0442 \u0431\u0440\u043E\u0441\u043E\u043A,
      \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
      \u043C\u0435\u0442\u043A\u0438, \u0430 \u044D\u043A\u0440\u0430\u043D \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
