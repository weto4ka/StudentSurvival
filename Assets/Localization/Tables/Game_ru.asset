  m_TableData:
  - m_Id: 1085267968
    m_Localized: "\u0421\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u043E\u0435
      \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1156571136
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0438 \u0434\u0438\u043F\u043B\u043E\u043C.
      \u041D\u0435 \u0443\u0441\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959744
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0438\u0433\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959745
    m_Localized: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959746
    m_Localized: "\u041A\u0430\u043A \u0438\u0433\u0440\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959747
    m_Localized: "\u0412\u044B\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959748
    m_Localized: "\u041D\u0430\u0437\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959749
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959750
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0437\u0430\u043D\u043E\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959751
    m_Localized: "\u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u043C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959752
    m_Localized: "\u0417\u0430\u0433\u0440\u0443\u0437\u043A\u0430\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959753
    m_Localized: "\u041F\u0435\u0440\u0435\u0434\u044B\u0448\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959754
    m_Localized: "\u042F\u0437\u044B\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959755
    m_Localized: "\u041E\u0431\u0449\u0430\u044F \u0433\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959756
    m_Localized: "\u0420\u0430\u0437\u043C\u0435\u0440 \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959757
    m_Localized: "\u041F\u043E\u043B\u043D\u044B\u0439 \u044D\u043A\u0440\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959758
    m_Localized: "\u0412\u043A\u043B\u044E\u0447\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959759
    m_Localized: "\u0412\u044B\u043A\u043B\u044E\u0447\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959760
    m_Localized: "\u042F\u0437\u044B\u043A \u0442\u0435\u043A\u0441\u0442\u0430 \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
      \u0441\u0440\u0430\u0437\u0443. \u041D\u0430\u0434\u043F\u0438\u0441\u0438
      \u0432 \u0438\u0441\u0445\u043E\u0434\u043D\u044B\u0445 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F\u0445
      \u0438 \u0432\u0438\u0434\u0435\u043E \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F
      \u0431\u0435\u0437 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959761
    m_Localized: "\u0421\u043E\u043D: {0}    \u0418\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442:
      {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959762
    m_Localized: "\u042D\u043A\u0437\u0430\u043C\u0435\u043D {0}/2 \xB7 \u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
      \u0440\u0430\u0431\u043E\u0442: {1}/{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959763
    m_Localized: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u044C
      \u0443\u0436\u0435 \u0438\u0434\u0451\u0442\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959764
    m_Localized: "Ctrl / \u043C\u044B\u0448\u044C: \u0431\u0440\u043E\u0441\u0438\u0442\u044C
      \u0440\u0430\u0431\u043E\u0442\u0443 (\u0446\u0435\u043D\u0430: 1 \u0421\u043E\u043D)"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959765
    m_Localized: "\u041F\u0443\u0441\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959766
    m_Localized: "{0} \xB7 {1}\n\xD7{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959767
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430\u0439\u0434\u0438
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u0438 \u043D\u0430\u0436\u043C\u0438
      E, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959768
    m_Localized: "\u041D\u0430\u0439\u0434\u0438 \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u044F
      \u0438 \u0441\u0434\u0430\u0439 \u043F\u0435\u0440\u0432\u044B\u0439 \u044D\u043A\u0437\u0430\u043C\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959769
    m_Localized: "\u0421\u0434\u0430\u0439 \u0438\u0442\u043E\u0433\u043E\u0432\u044B\u0439
      \u044D\u043A\u0437\u0430\u043C\u0435\u043D, \u0447\u0442\u043E\u0431\u044B
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0434\u0438\u043F\u043B\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959770
    m_Localized: "E \xB7 \u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0434\u0432\u0435\u0440\u044C
      (\u043E\u0441\u0442\u0430\u0432\u0430\u0439\u0441\u044F \u0440\u044F\u0434\u043E\u043C)"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959771
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u043C\u2026 \u043E\u0441\u0442\u0430\u0432\u0430\u0439\u0441\u044F
      \u0443 \u0434\u0432\u0435\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959772
    m_Localized: "\u042D\u0442\u0430 \u0434\u0432\u0435\u0440\u044C \u0437\u0430\u043F\u0435\u0440\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959773
    m_Localized: "\u0414\u043B\u044F \u044D\u0442\u043E\u0439 \u0434\u0432\u0435\u0440\u0438
      \u043D\u0435 \u0437\u0430\u0434\u0430\u043D \u0432\u044B\u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959774
    m_Localized: "E \xB7 \u041F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C:
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959775
    m_Localized: "\u0428\u0430\u0443\u0440\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959776
    m_Localized: "\u041A\u043D\u0438\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959777
    m_Localized: "\u041B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0430\u044F
      \u0440\u0430\u0431\u043E\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959778
    m_Localized: "\u042D\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959779
    m_Localized: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      1 \u0421\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959780
    m_Localized: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      1 \u0418\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959781
    m_Localized: "\u0411\u0440\u043E\u0441\u0430\u0435\u0442 \u043E\u0434\u043D\u0443
      \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443
      \u0431\u0435\u0437 \u0437\u0430\u0442\u0440\u0430\u0442 \u0421\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959782
    m_Localized: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      1 \u0421\u043E\u043D \u0438 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442
      1 \u043A \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u0434\u043E \u043A\u043E\u043D\u0446\u0430
      \u0437\u0430\u0431\u0435\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959783
    m_Localized: "\u041F\u043E\u0434\u043E\u0431\u0440\u0430\u043D\u043E: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959784
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u043E:
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959785
    m_Localized: "\u041F\u0430\u043D\u0435\u043B\u044C \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u0430.
      \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959786
    m_Localized: "\u041F\u043B\u043E\u0445\u0430\u044F \u043E\u0446\u0435\u043D\u043A\u0430!
      \u041F\u043E\u0442\u0435\u0440\u044F\u043D 1 \u0418\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959787
    m_Localized: "\u041E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442
      \u043E\u0431\u044A\u0435\u043A\u0442 \u0434\u043B\u044F \u0431\u0440\u043E\u0441\u043A\u0430
      \u0440\u0430\u0431\u043E\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959788
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u044D\u043A\u0437\u0430\u043C\u0435\u043D
      \u0441\u0434\u0430\u043D! +3 \u0421\u043E\u043D, +1 \u0418\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442.
      \u041E\u0441\u0442\u0430\u043B\u0441\u044F \u0435\u0449\u0451 \u043E\u0434\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959789
    m_Localized: "\u0414\u0438\u043F\u043B\u043E\u043C \u043F\u043E\u043B\u0443\u0447\u0435\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959790
    m_Localized: "\u0421\u0435\u043C\u0435\u0441\u0442\u0440 \u0442\u0435\u0431\u044F
      \u043E\u0434\u043E\u043B\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959791
    m_Localized: "\u0421\u043E\u043D \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F.
      \u0411\u0440\u043E\u0441\u0430\u0439 \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435
      \u0440\u0430\u0431\u043E\u0442\u044B, \u0447\u0442\u043E\u0431\u044B \u0435\u0433\u043E
      \u0441\u0431\u0435\u0440\u0435\u0447\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959792
    m_Localized: "\u0418\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442 \u0443\u043F\u0430\u043B
      \u0434\u043E \u043D\u0443\u043B\u044F. \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0440\u0430\u0437 \u043F\u043E\u043C\u043E\u0433\u0443\u0442 \u043A\u043D\u0438\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959793
    m_Localized: "R \xB7 \u0417\u0430\u043D\u043E\u0432\u043E     Esc \xB7 \u0413\u043B\u0430\u0432\u043D\u043E\u0435
      \u043C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959794
    m_Localized: "\u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435: A/D \u0438\u043B\u0438
      \u0441\u0442\u0440\u0435\u043B\u043A\u0438\n\u041F\u0440\u044B\u0436\u043E\u043A:
      \u041F\u0440\u043E\u0431\u0435\u043B\n\u0412\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
      / \u043F\u043E\u0434\u0431\u043E\u0440: E\n\u0411\u0440\u043E\u0441\u0438\u0442\u044C
      \u0440\u0430\u0431\u043E\u0442\u0443: Ctrl \u0438\u043B\u0438 \u043B\u0435\u0432\u0430\u044F
      \u043A\u043D\u043E\u043F\u043A\u0430 \u043C\u044B\u0448\u0438 (\u0446\u0435\u043D\u0430:
      1 \u0421\u043E\u043D)\n\u041F\u0440\u0435\u0434\u043C\u0435\u0442\u044B: 1\u20139
      \u0438\u043B\u0438 \u043D\u0430\u0436\u043C\u0438 \u044F\u0447\u0435\u0439\u043A\u0443\n\u041F\u0430\u0443\u0437\u0430
      / \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438: Esc\n\n\u0421\u043E\u0431\u0438\u0440\u0430\u0439
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B, \u043D\u0430\u0439\u0434\u0438
      \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u044E \u0438 \u0441\u0434\u0430\u0439
      \u0434\u0432\u0430 \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430. \u041A\u0430\u0436\u0434\u043E\u0435
      \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u043E\u0434\u0438\u043D \u0440\u0430\u0437. \u0421\u043E\u043D \u0438 \u0418\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442
      \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u0442\u044C \u0432\u044B\u0448\u0435
      \u043D\u0443\u043B\u044F.\n\n\u0413\u0435\u0439\u043C\u043F\u0430\u0434: \u043B\u0435\u0432\u044B\u0439
      \u0441\u0442\u0438\u043A / \u043A\u0440\u0435\u0441\u0442\u043E\u0432\u0438\u043D\u0430
      \u2014 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435, \u0432\u0435\u0440\u0445\u043D\u044F\u044F
      \u043A\u043D\u043E\u043F\u043A\u0430 \u2014 \u043F\u0440\u044B\u0436\u043E\u043A,
      \u043B\u0435\u0432\u0430\u044F \u2014 \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435,
      \u043D\u0438\u0436\u043D\u044F\u044F \u2014 \u0431\u0440\u043E\u0441\u043E\u043A;
      Start \u2014 \u043F\u043E\u0432\u0442\u043E\u0440 \u043F\u043E\u0441\u043B\u0435
      \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430, Select \u2014
      \u043F\u0430\u0443\u0437\u0430. \u0414\u043B\u044F \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044F
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u044D\u043A\u0440\u0430\u043D\u043D\u044B\u0435
      \u043A\u043D\u043E\u043F\u043A\u0438 \u0438\u043B\u0438 \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0443."
    m_Metadata:
      m_Items: []
