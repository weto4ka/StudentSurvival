  - m_Id: 772983604895745
    m_Localized: "{0} \xB7 \u0421\u0434\u0435\u043B\u0430\u0442\u044C \u043A\u0440\u0435\u043F\u043A\u0438\u0439
      \u043A\u043E\u0444\u0435 (\u0437\u0430\u0440\u044F\u0434 \u044D\u043D\u0435\u0440\u0433\u0438\u0438,
      \u043F\u043E\u0442\u043E\u043C \u0441\u043F\u0430\u0434)"
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895746
    m_Localized: "\u0422\u044B \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u043B
      \u0435\u0434\u0443 \u0438 \u0432\u0437\u044F\u043B \u0441 \u0441\u043E\u0431\u043E\u0439.
      \u0412\u044B\u0431\u0435\u0440\u0438 \u0435\u0451 \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439,
      \u0447\u0442\u043E\u0431\u044B \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0421\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895747
    m_Localized: "\u041A\u0440\u0435\u043F\u043A\u0438\u0439 \u043A\u043E\u0444\u0435!
      \u0414\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0421\u043E\u043D \u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
      \u043D\u0430 20 \u0441\u0435\u043A\u0443\u043D\u0434, \u043F\u043E\u0442\u043E\u043C
      \u0441\u043F\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895748
    m_Localized: "\u0414\u0430\u0439 \u043A\u0443\u0445\u043D\u0435 \u043C\u0438\u043D\u0443\u0442\u0443-\u0434\u0440\u0443\u0433\u0443\u044E,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895749
    m_Localized: "\u0414\u0440\u0443\u0436\u0435\u043B\u044E\u0431\u043D\u0430\u044F
      \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043A\u0430 \u0436\u0434\u0451\u0442
      \u0432 \u0442\u0440\u0435\u0442\u044C\u0435\u0439 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0438,
      \u0433\u0434\u0435 \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u044D\u043A\u0437\u0430\u043C\u0435\u043D:
      \u0441\u0434\u0430\u0439 \u044D\u043A\u0437\u0430\u043C\u0435\u043D 2 \u0438
      \u043F\u0440\u043E\u0439\u0434\u0438 \u0447\u0435\u0440\u0435\u0437 \u043F\u0435\u0440\u0435\u0434\u043D\u044E\u044E
      \u0434\u0432\u0435\u0440\u044C \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0438. \u0420\u043E\u0437\u043E\u0432\u043E\u0435
      \u0441\u0435\u0440\u0434\u0446\u0435 \u043D\u0430\u0434 \u043D\u0435\u0439
      \u0437\u043D\u0430\u0447\u0438\u0442, \u0447\u0442\u043E \u0441 \u043D\u0435\u0439
      \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C.
      \u0422\u0430\u043C \u0443 \u0442\u0435\u0431\u044F \u0434\u0432\u0435 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0435
      \u043F\u0430\u0440\u044B. \u0423\u0447\u0451\u0431\u0430 \u0442\u0440\u0430\u0442\u0438\u0442
      \u043E\u0434\u043D\u0443 \u0438 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442
      \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u044C. \u0424\u043B\u0438\u0440\u0442
      \u0442\u0440\u0430\u0442\u0438\u0442 \u043E\u0434\u043D\u0443 \u043F\u0430\u0440\u0443
      \u0438 \u043E\u0434\u043D\u0443 \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u0443\u044E
      \u0440\u0430\u0431\u043E\u0442\u0443. \u0423\u0447\u0438\u0441\u044C \u0434\u0432\u0430\u0436\u0434\u044B
      \u0434\u043B\u044F \u0441\u0430\u043C\u043E\u0433\u043E \u043B\u0451\u0433\u043A\u043E\u0433\u043E
      \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430 \u0438\u043B\u0438 \u0444\u043B\u0438\u0440\u0442\u0443\u0439
      \u0438 \u0443\u0447\u0438\u0441\u044C \u0440\u0430\u0437, \u0430 \u043F\u043E\u0442\u043E\u043C
      \u0432\u0435\u0440\u043D\u0438\u0441\u044C \u0437\u0430 \u0434\u0432\u0443\u043C\u044F
      \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u043C\u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895750
    m_Localized: "\u042D\u043A\u0437\u0430\u043C\u0435\u043D \u0435\u0449\u0451 \u043D\u0435
      \u043D\u0430\u0447\u0430\u043B\u0441\u044F: \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u043D\u0430\u0436\u043C\u0438 {0} \u0440\u044F\u0434\u043E\u043C \u0441 \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u0435\u043C.
      \u0414\u043E \u044D\u0442\u043E\u0433\u043E \u0431\u0440\u043E\u0441\u043A\u0438
      \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0434\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895751
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C\u0441\u044F
      (\u043F\u043E\u0432\u0442\u043E\u0440\u0438 \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C
      \u0438\u043B\u0438 \u043D\u0430\u0439\u0434\u0438 \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438),
      \u043F\u043E\u0442\u043E\u043C \u043D\u0430\u0436\u043C\u0438 {0} \u0440\u044F\u0434\u043E\u043C
      \u0441 \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u0435\u043C.
      \u0414\u043E \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430 \u0431\u0440\u043E\u0441\u043A\u0438
      \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0434\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 774744583430144
    m_Localized: "{0} \xB7 \u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
      \u0440\u0430\u0431\u043E\u0442\u044B \u043D\u0430 \u041F\u041A (2 \u0421\u043D\u0430
      \u2192 2 \u0440\u0430\u0431\u043E\u0442\u044B, \u0440\u0430\u0437 \u043D\u0430
