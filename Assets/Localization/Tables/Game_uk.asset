      m_Items: []
  - m_Id: 80304193658893
    m_Localized: "\u041F\u043E\u0434\u0440\u0443\u0433\u0430 \u043F\u043E\u0434\u0456\u043B\u0438\u043B\u0430\u0441\u044F
      2 \u0433\u043E\u0442\u043E\u0432\u0438\u043C\u0438 \u0440\u043E\u0431\u043E\u0442\u0430\u043C\u0438.
      \u0407\u0445 \u043A\u0438\u0434\u0430\u043D\u043D\u044F \u043D\u0435 \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0454
