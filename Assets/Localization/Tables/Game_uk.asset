      {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706502
    m_Localized: "\u0423\u0442\u0440\u0438\u043C\u0443\u0439 {0}: \u043A\u0438\u0434\u0430\u0442\u0438
      (-1 \u0421\u043E\u043D \u0437\u0430 \u0440\u043E\u0431\u043E\u0442\u0443)"
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706503
    m_Localized: "\u041F\u043E\u0440\u043E\u0436\u043D\u044F \u043A\u043E\u043C\u0456\u0440\u043A\u0430.
      \u0417\u0431\u0438\u0440\u0430\u0439: {0}, \u0430\u0431\u043E \u043A\u0438\u0434\u0430\u0439
      \u043D\u043E\u0432\u0456 \u0440\u043E\u0431\u043E\u0442\u0438: {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706504
    m_Localized: "\u0417\u0456\u0431\u0440\u0430\u043D\u0456 \u0440\u043E\u0431\u043E\u0442\u0438
      \u0441\u043A\u0456\u043D\u0447\u0438\u043B\u0438\u0441\u044F. {0} \u043A\u0438\u0434\u0430\u0454
      \u043D\u043E\u0432\u0456 \u0437\u0430 \u0421\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706505
    m_Localized: "\u041F\u0435\u0440\u0448\u0456 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0456
      \u043B\u0435\u0436\u0430\u0442\u044C \u043D\u0430 \u0437\u0435\u043C\u043B\u0456
      \u043F\u0440\u0430\u0432\u043E\u0440\u0443\u0447 \u0432\u0456\u0434 \u043F\u043E\u0447\u0430\u0442\u043A\u043E\u0432\u043E\u0457
      \u043F\u043E\u0437\u0438\u0446\u0456\u0457. \u0406\u0434\u0438 \u0434\u043E
      \u043F\u0456\u043A\u0441\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043C\u0430\u0440\u043A\u0435\u0440\u0430
      \u0439 \u043D\u0430\u0442\u0438\u0441\u043D\u0438 {0} \u043F\u043E\u0440\u0443\u0447.
      \u0417\u0456\u0431\u0440\u0430\u043D\u0438\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
      \u0432\u0438\u0431\u0438\u0440\u0430\u0454\u0442\u044C\u0441\u044F \u0432 \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0456
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E. \u0407\u0436\u0430
      \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u0454 \u0421\u043E\u043D,
      \u043A\u043D\u0438\u0436\u043A\u0438 - \u0406\u043D\u0442\u0435\u043B\u0435\u043A\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706506
    m_Localized: "\u0423\u0442\u0440\u0438\u043C\u0443\u0439 {0}, \u0449\u043E\u0431
      \u043A\u0438\u0434\u0430\u0442\u0438 \u043D\u043E\u0432\u0456 \u0440\u043E\u0431\u043E\u0442\u0438
      (-1 \u0421\u043E\u043D \u0437\u0430 \u043A\u043E\u0436\u043D\u0443). \u0417\u0456\u0431\u0440\u0430\u043D\u0456
      \u0440\u043E\u0431\u043E\u0442\u0438 - \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u0456
      \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0438: \u0443\u0442\u0440\u0438\u043C\u0443\u0439
      {1}, \u0449\u043E\u0431 \u043A\u0438\u0434\u0430\u0442\u0438 \u0432\u0438\u0431\u0440\u0430\u043D\u0443
      \u043F\u0430\u0447\u043A\u0443. {2} / {3} \u0432\u0438\u0431\u0438\u0440\u0430\u044E\u0442\u044C
      \u0456\u043D\u0448\u0438\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442.
      \u042F\u043A\u0449\u043E \u0432\u0438\u0431\u0440\u0430\u043D\u0430 \u0457\u0436\u0430,
      {1} \u0437'\u0457\u0441\u0442\u044C \u0457\u0457. \u041A\u0438\u0434\u043E\u043A
      \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0454 \u043E\u0434\u043D\u0443 \u0440\u043E\u0431\u043E\u0442\u0443;
      \u043F\u043E\u0440\u043E\u0436\u043D\u044F \u043A\u043E\u043C\u0456\u0440\u043A\u0430
      \u043D\u0435 \u0441\u0442\u0440\u0456\u043B\u044F\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 62966425706507
    m_Localized: "\u0421\u0422\u0420\u0418\u0411\u0410\u0419: {0}"
    m_Metadata:
