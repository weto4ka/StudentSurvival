  - m_Id: 80304193658882
    m_Localized: "\u0428\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438 \u0432\u0437\u044F\u0442\u043E.
      \u041D\u0435 \u043F\u043E\u043A\u0430\u0437\u0443\u0439 \u0457\u0445 \u043E\u0445\u043E\u0440\u043E\u043D\u0446\u0435\u0432\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658883
    m_Localized: "\u041C\u0430\u0442\u0435\u0440\u0456\u0430\u043B \u043F\u043E\u0432\u0442\u043E\u0440\u0435\u043D\u043E.
      \u041C\u043E\u0436\u043D\u0430 \u0439\u0442\u0438 \u043D\u0430 \u0456\u0441\u043F\u0438\u0442
      \u0431\u0435\u0437 \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658884
    m_Localized: "\u0428\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043B\u0438:
      \u0434\u043B\u044F \u0456\u0441\u043F\u0438\u0442\u0443 \u0442\u0435\u043F\u0435\u0440
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0432\u0441\u044C\u043E\u0433\u043E
      \u0447\u043E\u0442\u0438\u0440\u0438 \u0432\u043B\u0443\u0447\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658885
    m_Localized: "\u0428\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438 \u0437\u0430\u0431\u0440\u0430\u043B\u0438.
      \u0406\u0441\u043F\u0438\u0442 \u043F\u0435\u0440\u0435\u0440\u0432\u0430\u043D\u043E:
      \u043F\u0456\u0434\u0433\u043E\u0442\u0443\u0439\u0441\u044F \u0442\u0430 \u0441\u043F\u0440\u043E\u0431\u0443\u0439
      \u0449\u0435 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658886
    m_Localized: "\u041E\u0445\u043E\u0440\u043E\u043D\u0435\u0446\u044C \u0449\u043E\u0441\u044C
      \u0437\u0430\u043F\u0456\u0434\u043E\u0437\u0440\u0438\u0432! \u0421\u0445\u043E\u0432\u0430\u0439\u0441\u044F,
      \u043F\u0440\u0438\u0433\u043D\u0438\u0441\u044F \u0430\u0431\u043E \u0432\u0456\u0434\u0456\u0439\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658887
    m_Localized: "\u041F\u0456\u0434\u043E\u0437\u0440\u0430 \u043E\u0445\u043E\u0440\u043E\u043D\u0446\u044F:
      \u0434\u043E \u043A\u043E\u043D\u0444\u0456\u0441\u043A\u0430\u0446\u0456\u0457
      {0} \u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658888
    m_Localized: "{0} \xB7 \u041F\u043E\u0444\u043B\u0456\u0440\u0442\u0443\u0432\u0430\u0442\u0438
      (1 \u0437\u0456\u0431\u0440\u0430\u043D\u0430 \u0440\u043E\u0431\u043E\u0442\u0430
      + 1 \u0432\u0456\u043B\u044C\u043D\u0430 \u043F\u0430\u0440\u0430)"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658889
    m_Localized: "\u0417\u0430 \u0431\u0430\u0436\u0430\u043D\u043D\u044F\u043C:
      \u0432\u0438\u0442\u0440\u0430\u0442\u044C 1 \u0437\u0456\u0431\u0440\u0430\u043D\u0443
      \u0440\u043E\u0431\u043E\u0442\u0443 \u0439 1 \u0437 2 \u0432\u0456\u043B\u044C\u043D\u0438\u0445
      \u043F\u0430\u0440 \u043D\u0430 \u0437\u043D\u0430\u0439\u043E\u043C\u0441\u0442\u0432\u043E.
      \u041E\u0434\u0438\u043D \u0440\u0430\u0437 \u043F\u0456\u0434\u0433\u043E\u0442\u0443\u0439\u0441\u044F,
      \u0442\u043E\u0434\u0456 \u043F\u043E\u043F\u0440\u043E\u0441\u0438 \u0443
      \u043F\u043E\u0434\u0440\u0443\u0433\u0438 2 \u0433\u043E\u0442\u043E\u0432\u0456
      \u0440\u043E\u0431\u043E\u0442\u0438. \u0414\u0432\u0456 \u043F\u0430\u0440\u0438
      \u043D\u0430\u0432\u0447\u0430\u043D\u043D\u044F \u043D\u0430\u0442\u043E\u043C\u0456\u0441\u0442\u044C
      \u0434\u0430\u044E\u0442\u044C \u043A\u0440\u0430\u0449\u0443 \u0433\u043E\u0442\u043E\u0432\u043D\u0456\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658890
    m_Localized: "\u0417\u043D\u0430\u0439\u043E\u043C\u0441\u0442\u0432\u043E \u0432\u0434\u0430\u043B\u043E\u0441\u044F!
      \u041E\u0434\u0438\u043D \u0440\u0430\u0437 \u043F\u0456\u0434\u0433\u043E\u0442\u0443\u0439\u0441\u044F
      \u0439 \u043F\u043E\u0432\u0435\u0440\u043D\u0438\u0441\u044F \u043F\u043E
      2 \u0433\u043E\u0442\u043E\u0432\u0456 \u0440\u043E\u0431\u043E\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658891
    m_Localized: "\u0417\u043D\u0430\u0439\u043E\u043C\u0441\u0442\u0432\u043E \u0432\u0434\u0430\u043B\u043E\u0441\u044F!
      \u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438 \u0449\u0435 \u0440\u0430\u0437,
      \u0449\u043E\u0431 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 2 \u0433\u043E\u0442\u043E\u0432\u0456
      \u0440\u043E\u0431\u043E\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658892
    m_Localized: "{0} \xB7 \u0412\u0437\u044F\u0442\u0438 \u0443 \u043F\u043E\u0434\u0440\u0443\u0433\u0438
