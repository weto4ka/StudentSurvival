    m_Metadata:
      m_Items: []
  - m_Id: 93463029735436
    m_Localized: "{0} \u041D\u0430\u0437\u0430\u0434 \u0434\u043E \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0456\u0457
      \xB7 {1} \u0431\u0456\u043B\u044F \u0434\u0432\u0435\u0440\u0435\u0439 WC"
    m_Metadata:
      m_Items: []
  - m_Id: 745201730576384
    m_Localized: "\u0421\u043F\u0435\u0440\u0448\u0443 \u0441\u043A\u043B\u0430\u0434\u0438
      \u0456\u0441\u043F\u0438\u0442 \u0443 \u0446\u0456\u0439 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0456\u0457,
      \u0449\u043E\u0431 \u0432\u0456\u0434\u0447\u0438\u043D\u0438\u0442\u0438 \u0446\u0456
      \u0434\u0432\u0435\u0440\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685248
    m_Localized: "\u0422\u0438 \u0432\u0438\u0439\u0448\u043E\u0432 \u0437 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0456\u0457,
      \u0442\u043E\u043C\u0443 \u0456\u0441\u043F\u0438\u0442 \u0441\u043A\u0430\u0441\u043E\u0432\u0430\u043D\u043E.
      \u041F\u043E\u0432\u0435\u0440\u043D\u0438\u0441\u044C \u0456 \u043F\u043E\u0447\u043D\u0438
      \u0439\u043E\u0433\u043E \u0437\u043D\u043E\u0432\u0443, \u043A\u043E\u043B\u0438
      \u0431\u0443\u0434\u0435\u0448 \u0433\u043E\u0442\u043E\u0432\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685249
    m_Localized: "{0} \u2014 \u0432\u0438\u0439\u0442\u0438 \u0437 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0456\u0457
      (\u0456\u0441\u043F\u0438\u0442 \u0431\u0443\u0434\u0435 \u0441\u043A\u0430\u0441\u043E\u0432\u0430\u043D\u043E)"
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685250
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u0456\u0440\u043A\u0430 \u043E\u0445\u043E\u0440\u043E\u043D\u0446\u044F:
      \u0449\u0435 {0} \u0441 \u043D\u0435 \u043F\u043E\u043A\u0430\u0437\u0443\u0439
      \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438! \u041F\u0440\u0438\u0433\u043D\u0438\u0441\u044F
      \u0430\u0431\u043E \u0441\u0442\u0430\u043D\u044C \u0443 \u043D\u044C\u043E\u0433\u043E
      \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685251
    m_Localized: "\u041E\u0445\u043E\u0440\u043E\u043D\u0435\u0446\u044C \u043F\u043E\u0431\u0430\u0447\u0438\u0432,
      \u044F\u043A \u0442\u0438 \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0454\u0448\u0441\u044F
      \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0430\u043C\u0438! \u0407\u0445
      \u0437\u0430\u0431\u0440\u0430\u043B\u0438, \u0430 \u0456\u0441\u043F\u0438\u0442
      \u0441\u043A\u0430\u0441\u043E\u0432\u0430\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 745201797685252
    m_Localized: "\u0423 \u0434\u0440\u0443\u0433\u0456\u0439 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0456\u0457
      \u0447\u0435\u0441\u043D\u043E \u043F\u043E\u0432\u0442\u043E\u0440\u0438 \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B
      \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C \u0430\u0431\u043E \u0432\u0456\u0437\u044C\u043C\u0438
      \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438, \u0441\u0445\u043E\u0432\u0430\u043D\u0456
      \u0432 WC. \u041D\u043E\u0441\u0438\u0442\u0438 \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438
      \u0431\u0435\u0437\u043F\u0435\u0447\u043D\u043E, \u0434\u043E\u043A\u0438
      \u043D\u0435 \u043F\u043E\u0447\u043D\u0435\u0442\u044C\u0441\u044F \u0456\u0441\u043F\u0438\u0442.
      \u041D\u0430 \u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u0456\u0441\u043F\u0438\u0442\u0443
      \u043E\u0445\u043E\u0440\u043E\u043D\u0435\u0446\u044C \u043A\u0456\u043B\u044C\u043A\u0430
      \u0441\u0435\u043A\u0443\u043D\u0434 \u043E\u0433\u043B\u044F\u0434\u0430\u0454
      \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0456\u044E: \u043D\u0435 \u043F\u043E\u0442\u0440\u0430\u043F\u043B\u044F\u0439
      \u0439\u043E\u043C\u0443 \u043D\u0430 \u043E\u0447\u0456, \u043F\u0440\u0438\u0433\u043D\u0438\u0441\u044F
      \u0430\u0431\u043E \u0441\u0442\u0430\u043D\u044C \u0443 \u043D\u044C\u043E\u0433\u043E
      \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u044E. \u041F\u0456\u0434 \u0447\u0430\u0441
      \u0456\u0441\u043F\u0438\u0442\u0443 \u0432\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u0439
      \u0431\u0456\u043B\u044F \u0432\u0438\u043A\u043B\u0430\u0434\u0430\u0447\u0430,
      \u0449\u043E\u0431 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438
      \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438 (\u0447\u043E\u0442\u0438\u0440\u0438
      \u0432\u043B\u0443\u0447\u0430\u043D\u043D\u044F \u0437\u0430\u043C\u0456\u0441\u0442\u044C
      \u0448\u0435\u0441\u0442\u0438), \u0430\u043B\u0435 \u043B\u0438\u0448\u0435
      \u043A\u043E\u043B\u0438 \u043E\u0445\u043E\u0440\u043E\u043D\u0435\u0446\u044C
      \u0442\u0435\u0431\u0435 \u043D\u0435 \u0431\u0430\u0447\u0438\u0442\u044C.
      \u042F\u043A\u0449\u043E \u0432\u0456\u043D \u0441\u043F\u0456\u0439\u043C\u0430\u0454,
      \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438 \u0437\u0430\u0431\u0435\u0440\u0443\u0442\u044C,
      \u0430 \u0456\u0441\u043F\u0438\u0442 \u0441\u043A\u0430\u0441\u0443\u044E\u0442\u044C.
      \u0412\u0438\u0445\u0456\u0434 \u0437 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0456\u0457
      \u043F\u0456\u0434 \u0447\u0430\u0441 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0433\u043E
      \u0456\u0441\u043F\u0438\u0442\u0443 \u0442\u0435\u0436 \u0439\u043E\u0433\u043E
      \u0441\u043A\u0430\u0441\u043E\u0432\u0443\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 748101240348672
    m_Localized: "\u0421\u043E\u043D: {0}\n\u0406\u043D\u0442\u0435\u043B\u0435\u043A\u0442:
      {1}\n\u0420\u043E\u0431\u043E\u0442\u0438: {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 748101244542976
    m_Localized: "\u0406\u0441\u043F\u0438\u0442 {0}/3 \xB7 \u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044C
      \u0432\u043B\u0443\u0447\u0430\u043D\u044C: {1} \u0437 {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 748101244542977
    m_Localized: "\u0417\u0456\u0431\u0440\u0430\u043D\u0438\u0445 \u0440\u043E\u0431\u0456\u0442
      \u043D\u0435 \u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044C. \u0417\u043D\u0430\u0439\u0434\u0438
      \u0449\u0435 \u0432 \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0438\u0445
      \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0456\u044F\u0445 \u0430\u0431\u043E
      \u043F\u043E\u043F\u0440\u043E\u0441\u0438 \u043F\u043E\u0434\u0440\u0443\u0433\u0443
      \u0443 \u0444\u0456\u043D\u0430\u043B\u044C\u043D\u0456\u0439; {0} \u043A\u0438\u0434\u0430\u0454
      \u043D\u043E\u0432\u0456 \u0437\u0430 1 \u0421\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 748101244542978
    m_Localized: "\u0412\u043E\u043D\u0430 \u0437\u0430\u0440\u0430\u0437 \u0432\u0447\u0438\u0442\u044C\u0441\u044F.
      \u041F\u043E\u0432\u0435\u0440\u0442\u0430\u0439\u0441\u044F, \u043A\u043E\u043B\u0438
      \u0433\u043E\u0442\u0443\u0432\u0430\u0442\u0438\u043C\u0435\u0448\u0441\u044F
      \u0434\u043E \u0444\u0456\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0456\u0441\u043F\u0438\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 748101244542979
    m_Localized: "\u041E\u0434\u0438\u043D \u0440\u0430\u0437 \u043F\u043E\u0432\u0442\u043E\u0440\u0438
      \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C
      \u0456 \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u0439\u0441\u044F: \u0432\u043E\u043D\u0430
      \u043F\u043E\u0434\u0456\u043B\u0438\u0442\u044C\u0441\u044F 2 \u0433\u043E\u0442\u043E\u0432\u0438\u043C\u0438
      \u0440\u043E\u0431\u043E\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
