      \u0442\u0430\u0454\u043C\u043D\u0438\u0447\u0456\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980959
    m_Localized: "\u0414\u0435\u0442\u0430\u043B\u044C\u043D\u0430 \u0456\u043B\u044E\u0441\u0442\u0440\u0430\u0446\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980960
    m_Localized: "\u041F\u0415\u0420\u0415\u0417\u0411\u0423\u0414\u0416\u0415\u041D\u041D\u042F
      \xB7 {0} \u0441 \xB7 \u043D\u0430\u0434\u043C\u0456\u0440\u043D\u0430 \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980961
    m_Localized: "\u0421\u041F\u0410\u0414 \u041F\u0406\u0421\u041B\u042F \u041A\u041E\u0424\u0415\u0407\u041D\u0423
      \xB7 {0} \u0441 \xB7 \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0430 \u0440\u0435\u0430\u043A\u0446\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980962
    m_Localized: "\u041D\u0423\u041B\u042C \u0421\u041D\u0423 \xB7 {0} \u0441 \u043D\u0430
      \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F! \u0412\u0438\u0431\u0435\u0440\u0438
      \u0457\u0436\u0443/\u043D\u0430\u043F\u0456\u0439, \u043F\u043E\u0442\u0456\u043C
      {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980963
    m_Localized: "\u0423\u0436\u0435 \u043F\u0435\u0440\u0435\u0437\u0431\u0443\u0434\u0436\u0435\u043D\u0438\u0439.
      \u0414\u043E\u0447\u0435\u043A\u0430\u0439\u0441\u044F \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044F
      \u0434\u0456\u0457 \u043D\u0430\u043F\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980964
    m_Localized: "\u041D\u0435\u043C\u0430\u0454 \u0421\u043D\u0443 \u0434\u043B\u044F
      \u043D\u043E\u0432\u043E\u0457 \u0440\u043E\u0431\u043E\u0442\u0438. \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0439
      \u0457\u0436\u0443, \u043D\u0430\u043F\u0456\u0439 \u0430\u0431\u043E \u0437\u0456\u0431\u0440\u0430\u043D\u0443
      \u0440\u043E\u0431\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980965
    m_Localized: "\u0427\u0430\u0441 \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u0442\u0438
      \u0431\u043E\u0440\u0433 \u043A\u043E\u0444\u0435\u0457\u043D\u0443. \u0420\u0443\u0445
      \u0456 \u0440\u0435\u0430\u043A\u0446\u0456\u044F \u0441\u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0435\u043D\u0456
      \u043D\u0430 10 \u0441\u0435\u043A\u0443\u043D\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980966
    m_Localized: "{0} \u0424\u043B\u0456\u0440\u0442\u0443\u0432\u0430\u0442\u0438
      \xB7 \u043A\u043E\u0448\u0442\u0443\u0454 1 \u0437\u0456\u0431\u0440\u0430\u043D\u0443
      \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980967
    m_Localized: "\u0422\u0432\u043E\u044F \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0430
      \u0441\u0442\u0430\u043B\u0430 \u043B\u044E\u0431\u043E\u0432\u043D\u0438\u043C
      \u043B\u0438\u0441\u0442\u043E\u043C. \u0406\u0441\u043F\u0438\u0442 \u0437\u0430\u0447\u0435\u043A\u0430\u0454..."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980968
    m_Localized: "\u041D\u0435\u043C\u0430\u0454 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u043E\u0457
      \u0434\u043B\u044F \u043B\u044E\u0431\u043E\u0432\u043D\u043E\u0433\u043E \u043B\u0438\u0441\u0442\u0430.
      \u0421\u043F\u0435\u0440\u0448\u0443 \u0437\u043D\u0430\u0439\u0434\u0438 \u0440\u043E\u0431\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980969
    m_Localized: "+3 \u0442\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u043E\u0433\u043E
      \u0421\u043D\u0443, 20 \u0441 \u0448\u0432\u0438\u0434\u043A\u043E\u0441\u0442\u0456,
      \u043F\u043E\u0442\u0456\u043C 10 \u0441 \u0441\u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0435\u043D\u043D\u044F.
      \u041D\u0435\u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u0438\u0439
      \u0442\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u0438\u0439 \u0421\u043E\u043D
      \u0437\u043D\u0438\u043A\u0430\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980970
    m_Localized: "\u0421\u043A\u043B\u0430\u0434\u0438 \u0434\u0432\u0430 \u0456\u0441\u043F\u0438\u0442\u0438.
      \u0417\u0431\u0438\u0440\u0430\u0439 \u043F\u0440\u0438\u043F\u0430\u0441\u0438:
      {0}, \u0456 \u0439\u0434\u0438 \u0437\u0430 \u0441\u0442\u0440\u0456\u043B\u043A\u043E\u044E.
      \u041D\u043E\u0432\u0430 \u0440\u043E\u0431\u043E\u0442\u0430 ({1}) \u043A\u043E\u0448\u0442\u0443\u0454
      1 \u0421\u043E\u043D; \u0437\u0456\u0431\u0440\u0430\u043D\u0430 \u2014 \u0431\u0435\u0437
      \u0432\u0438\u0442\u0440\u0430\u0442: \u0432\u0438\u0431\u0435\u0440\u0438
      \u0439 {2}. \u041A\u043D\u0438\u0436\u043A\u0438 \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u044E\u0442\u044C
      \u0406\u043D\u0442\u0435\u043B\u0435\u043A\u0442, \u0457\u0436\u0430 \u2014
      \u0421\u043E\u043D.\n\n\u0417\u0430 \u043D\u0443\u043B\u044C\u043E\u0432\u043E\u0433\u043E
      \u0421\u043D\u0443 \u0454 8 \u0441\u0435\u043A\u0443\u043D\u0434 \u043D\u0430
      \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F. \u041D\u0430\u043F\u0456\u0439
      \u043F\u043E\u0437\u0438\u0447\u0430\u0454 3 \u0421\u043D\u0443 \u0439 \u043F\u0440\u0438\u0441\u043A\u043E\u0440\u044E\u0454
      \u043D\u0430 20 \u0441, \u043F\u043E\u0442\u0456\u043C \u0437\u0430\u0431\u0438\u0440\u0430\u0454
      \u043D\u0435\u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u0438\u0439
      \u0431\u043E\u043D\u0443\u0441 \u0456 \u0441\u043F\u043E\u0432\u0456\u043B\u044C\u043D\u044E\u0454
      \u0440\u0435\u0430\u043A\u0446\u0456\u044E \u043D\u0430 10 \u0441. \u0414\u0456\u044F
      \u043D\u0430\u043F\u043E\u0457\u0432 \u043D\u0435 \u043D\u0430\u043A\u043E\u043F\u0438\u0447\u0443\u0454\u0442\u044C\u0441\u044F.
      \u0424\u043B\u0456\u0440\u0442 \u2014 \u0437\u0430 \u0431\u0430\u0436\u0430\u043D\u043D\u044F\u043C,
      \u0446\u0456\u043D\u0430: \u043E\u0434\u043D\u0430 \u0437\u0456\u0431\u0440\u0430\u043D\u0430
      \u0440\u043E\u0431\u043E\u0442\u0430.\n\n\u041D\u0443\u043B\u044C \u0406\u043D\u0442\u0435\u043B\u0435\u043A\u0442\u0443
      \u0447\u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044F \u0432\u0456\u0434\u043B\u0456\u043A\u0443
      \u2014 \u043F\u043E\u0440\u0430\u0437\u043A\u0430. \u041F\u0456\u0441\u043B\u044F
      \u043D\u0435\u0457 \u2014 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u0430
      \u0442\u043E\u0447\u043A\u0430; \u043C\u0435\u043D\u044E \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980971
    m_Localized: "\u0422\u0438 \u043D\u0430\u0434\u0442\u043E \u0434\u043E\u0432\u0433\u043E
      \u0431\u0443\u0432 \u0431\u0435\u0437 \u0421\u043D\u0443. \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0439
      \u0457\u0436\u0443 \u0447\u0438 \u043D\u0430\u043F\u0456\u0439 \u0434\u043E
      \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044F \u0432\u0456\u0434\u043B\u0456\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 44367438929920
    m_Localized: "\u042F\u043A \u0433\u0440\u0430\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398912
    m_Localized: "\u041A\u0435\u0440\u0443\u0432\u0430\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398913
    m_Localized: "\u0412\u0438\u0431\u0435\u0440\u0438 \u0434\u0456\u044E, \u0449\u043E\u0431
      \u0437\u043C\u0456\u043D\u0438\u0442\u0438 \u043A\u043D\u043E\u043F\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398914
    m_Localized: "\u0422\u0432\u043E\u044F \u043C\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398915
    m_Localized: "\u0421\u043A\u043B\u0430\u0434\u0438 \u0434\u0432\u0430 \u0456\u0441\u043F\u0438\u0442\u0438,
      \u0449\u043E\u0431 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u0434\u0438\u043F\u043B\u043E\u043C.
      \u0406\u0434\u0438 \u0437\u0430 \u0441\u0442\u0440\u0456\u043B\u043A\u043E\u044E
      \u0434\u043E \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0456\u0457 \u0442\u0430
      \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0439\u0441\u044F \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438\u043C\u0438
      \u0434\u0432\u0435\u0440\u0438\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398916
    m_Localized: "\u0417\u0431\u0438\u0440\u0430\u0439 \u043F\u0440\u0438\u043F\u0430\u0441\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398917
    m_Localized: "\u041D\u0430\u0442\u0438\u0441\u043D\u0438 {0} \u0431\u0456\u043B\u044F
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430 \u0447\u0438 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438\u0445
      \u0434\u0432\u0435\u0440\u0435\u0439. \u0407\u0436\u0430 \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u0454
      \u0421\u043E\u043D, \u043A\u043D\u0438\u0436\u043A\u0438 \u2014 \u0406\u043D\u0442\u0435\u043B\u0435\u043A\u0442.
      \u0412\u0438\u0431\u0435\u0440\u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
      \u0432 \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0456, \u0449\u043E\u0431
      \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u0438 \u0439\u043E\u0433\u043E \u0434\u0456\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398918
    m_Localized: "\u0411\u0438\u0439\u0441\u044F \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0438\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398919
    m_Localized: "\u041D\u043E\u0432\u0430 \u0440\u043E\u0431\u043E\u0442\u0430 \u043A\u043D\u043E\u043F\u043A\u043E\u044E
      {0} \u043A\u043E\u0448\u0442\u0443\u0454 1 \u0421\u043E\u043D. \u0417\u0456\u0431\u0440\u0430\u043D\u0456
      \u0440\u043E\u0431\u043E\u0442\u0438 \u2014 \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u0456
      \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0438: \u0432\u0438\u0431\u0435\u0440\u0438
      \u0440\u043E\u0431\u043E\u0442\u0443 \u0439 \u043D\u0430\u0442\u0438\u0441\u043D\u0438
      {1}. \u041D\u0438\u0437\u044C\u043A\u0456 \u043A\u0438\u0434\u043A\u0438 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0438\u0431\u0443\u0439,
      \u0432\u0456\u0434 \u0432\u0438\u0441\u043E\u043A\u0438\u0445 \u043F\u0440\u0438\u0441\u0456\u0434\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398920
    m_Localized: "\u0415\u043D\u0435\u0440\u0433\u0456\u044F \u043C\u0430\u0454 \u0446\u0456\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398921
    m_Localized: "\u041D\u0430\u043F\u0456\u0439 \u0434\u0430\u0454 3 \u0421\u043D\u0443
      \u0432 \u0431\u043E\u0440\u0433 \u0456 \u043F\u0440\u0438\u0441\u043A\u043E\u0440\u044E\u0454
      \u043D\u0430 20 \u0441\u0435\u043A\u0443\u043D\u0434. \u041F\u043E\u0442\u0456\u043C
      \u043D\u0435\u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u0438\u0439
      \u0431\u043E\u043D\u0443\u0441 \u0437\u043D\u0438\u043A\u0430\u0454, \u0430
      \u0440\u0443\u0445 \u0441\u043F\u043E\u0432\u0456\u043B\u044C\u043D\u044E\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430 10 \u0441\u0435\u043A\u0443\u043D\u0434. \u0417\u0430 \u043D\u0443\u043B\u044C\u043E\u0432\u043E\u0433\u043E
      \u0421\u043D\u0443 \u0454 8 \u0441\u0435\u043A\u0443\u043D\u0434 \u043D\u0430
      \u0457\u0436\u0443 \u0447\u0438 \u043D\u0430\u043F\u0456\u0439. \u041D\u0443\u043B\u044C
      \u0406\u043D\u0442\u0435\u043B\u0435\u043A\u0442\u0443 \u2014 \u043D\u0435\u0433\u0430\u0439\u043D\u0430
      \u043F\u043E\u0440\u0430\u0437\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398922
    m_Localized: "\u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F \u0439
      \u043F\u043E\u0432\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398923
    m_Localized: "\u0412\u0438\u0445\u0456\u0434 \u0443 \u043C\u0435\u043D\u044E
      \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454 \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u0439
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441. \u041F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438
      \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u0454 \u0439\u043E\u0433\u043E.
      \u041F\u0456\u0441\u043B\u044F \u043F\u043E\u0440\u0430\u0437\u043A\u0438 \u041F\u043E\u0432\u0442\u043E\u0440
      \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u0454 \u0434\u043E \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u043E\u0457
      \u0442\u043E\u0447\u043A\u0438, \u0441\u043A\u0430\u0441\u043E\u0432\u0443\u044E\u0447\u0438
      \u043F\u0456\u0437\u043D\u0456\u0448\u0456 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0438
      \u0439 \u0448\u043A\u043E\u0434\u0443. \u041D\u043E\u0432\u0430 \u0433\u0440\u0430
      \u0437\u0430\u043C\u0456\u043D\u044E\u0454 \u043F\u0440\u043E\u0445\u043E\u0434\u0436\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398924
    m_Localized: "\u0421\u043F\u043E\u043A\u0443\u0441\u043B\u0438\u0432\u0430 \u043F\u0435\u0440\u0435\u0440\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 44367535398925
    m_Localized: "\u0424\u043B\u0456\u0440\u0442 \u0437\u0456 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043A\u043E\u044E
      \u2014 \u0437\u0430 \u0431\u0430\u0436\u0430\u043D\u043D\u044F\u043C. \u0412\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u044F
      \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u044E\u0454 \u043E\u0434\u043D\u0443
      \u0437\u0456\u0431\u0440\u0430\u043D\u0443 \u0440\u043E\u0431\u043E\u0442\u0443
      \u043D\u0430 \u043B\u044E\u0431\u043E\u0432\u043D\u0438\u0439 \u043B\u0438\u0441\u0442.
      \u041F\u0440\u043E\u0445\u0456\u0434 \u043F\u043E\u0432\u0437 \u043D\u0456\u0447\u043E\u0433\u043E
      \u043D\u0435 \u043A\u043E\u0448\u0442\u0443\u0454. \u041E\u0434\u0438\u043D
      \u0440\u0430\u0437 \u0437\u0430 \u043F\u0440\u043E\u0445\u043E\u0434\u0436\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
