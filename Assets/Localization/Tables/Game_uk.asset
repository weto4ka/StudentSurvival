  - m_Id: 39276505980929
    m_Localized: "\u0412\u0456\u0434 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u043E\u0457
      \u0442\u043E\u0447\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980930
    m_Localized: "\u041F\u043E\u0447\u0430\u0442\u0438 \u0441\u043F\u043E\u0447\u0430\u0442\u043A\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980931
    m_Localized: "\u0426\u0435 \u0437\u0430\u043C\u0456\u043D\u0438\u0442\u044C \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u0443
      \u0433\u0440\u0443 \u0439 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u0443
      \u0442\u043E\u0447\u043A\u0443. \u041D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F
      \u0437\u0430\u043B\u0438\u0448\u0430\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980932
    m_Localized: "\u0414\u043E \u043E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u0457
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u043E\u0457 \u0442\u043E\u0447\u043A\u0438:
      \u043F\u043E\u0447\u0430\u0442\u043E\u043A, \u043F\u0435\u0440\u0435\u0445\u0456\u0434
      \u0434\u0432\u0435\u0440\u0438\u043C\u0430 \u0430\u0431\u043E \u043F\u0435\u0440\u0435\u0440\u0432\u0430
      \u043F\u0456\u0441\u043B\u044F \u043F\u0435\u0440\u0448\u043E\u0433\u043E \u0456\u0441\u043F\u0438\u0442\u0443.
      \u041F\u0456\u0437\u043D\u0456\u0448\u0456 \u0437\u043D\u0430\u0445\u0456\u0434\u043A\u0438
      \u0439 \u043F\u043E\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u043D\u044F \u0441\u043A\u0430\u0441\u043E\u0432\u0443\u044E\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980933
    m_Localized: "\u0413\u0440\u0443 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980934
    m_Localized: "\u041D\u0435 \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438.
      \u041F\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u043C\u0456\u0441\u0446\u0435
      \u0439 \u0434\u043E\u0441\u0442\u0443\u043F \u0434\u043E \u043F\u0430\u043F\u043A\u0438
      \u0442\u0430 \u043F\u043E\u0432\u0442\u043E\u0440\u0456\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980935
    m_Localized: "\u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F \u043D\u0435
      \u0447\u0438\u0442\u0430\u0454\u0442\u044C\u0441\u044F. \u0417\u0430 \u043D\u0430\u044F\u0432\u043D\u043E\u0441\u0442\u0456
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043E \u0440\u0435\u0437\u0435\u0440\u0432\u043D\u0443
      \u043A\u043E\u043F\u0456\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980936
    m_Localized: "\u0412\u0456\u0434\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F
      \u0437\u0443\u043F\u0438\u043D\u0435\u043D\u043E \u0434\u043B\u044F \u0437\u0430\u0445\u0438\u0441\u0442\u0443
      \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F. \u041F\u043E\u0432\u0435\u0440\u043D\u0456\u0442\u044C\u0441\u044F
      \u0432 \u043C\u0435\u043D\u044E \u0439 \u043F\u043E\u0432\u0442\u043E\u0440\u0456\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980937
    m_Localized: "\u041F\u0435\u0440\u0435\u0436\u0438\u0432\u0438 \u0441\u0435\u0441\u0456\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980938
    m_Localized: "\u0423\u043F\u0435\u0440\u0435\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980939
    m_Localized: "\u0421\u043A\u043B\u0430\u0434\u0438 \u0434\u0432\u0430 \u0456\u0441\u043F\u0438\u0442\u0438
      \u0439 \u043E\u0442\u0440\u0438\u043C\u0430\u0439 \u0434\u0438\u043F\u043B\u043E\u043C.
      \u0417\u0431\u0438\u0440\u0430\u0439 \u043F\u0440\u0438\u043F\u0430\u0441\u0438
      \u043A\u043D\u043E\u043F\u043A\u043E\u044E {0} \u0442\u0430 \u0439\u0434\u0438
      \u0437\u0430 \u0441\u0442\u0440\u0456\u043B\u043A\u043E\u044E \u0434\u043E
      \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0456\u0457.\n\n\u041D\u043E\u0432\u0430
      \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0430 ({1}) \u043A\u043E\u0448\u0442\u0443\u0454
      1 \u0421\u043E\u043D: \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043D\u044F
      \u0437\u0430\u0431\u0438\u0440\u0430\u0454 \u0441\u0438\u043B\u0438. \u0417\u0456\u0431\u0440\u0430\u043D\u0456
      \u0440\u043E\u0431\u043E\u0442\u0438 \u0433\u043E\u0442\u043E\u0432\u0456:
      \u0432\u0438\u0431\u0435\u0440\u0438 \u0440\u043E\u0431\u043E\u0442\u0443 \u0439
      \u043D\u0430\u0442\u0438\u0441\u043D\u0438 {2}, \u0449\u043E\u0431 \u043A\u0438\u043D\u0443\u0442\u0438
      \u0431\u0435\u0437 \u0432\u0438\u0442\u0440\u0430\u0442 \u0421\u043D\u0443.
      \u0407\u0436\u0430 \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u0454 \u0421\u043E\u043D,
      \u043A\u043D\u0438\u0436\u043A\u0438 \u2014 \u0406\u043D\u0442\u0435\u043B\u0435\u043A\u0442.\n\n\u041D\u0443\u043B\u044C
      \u0421\u043D\u0443 \u0447\u0438 \u0406\u043D\u0442\u0435\u043B\u0435\u043A\u0442\u0443
      \u0437\u0430\u0432\u0435\u0440\u0448\u0443\u0454 \u0441\u043F\u0440\u043E\u0431\u0443.
      \u041F\u0456\u0441\u043B\u044F \u043F\u043E\u0440\u0430\u0437\u043A\u0438 \u2014
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u0430 \u0442\u043E\u0447\u043A\u0430;
      \u043C\u0435\u043D\u044E \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454 \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u0439
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980940
    m_Localized: "\u0417\u0431\u0438\u0440\u0430\u0439 \u043F\u0440\u0438\u043F\u0430\u0441\u0438:
      {1}; \u043F\u043E\u0442\u0456\u043C {0} \u0434\u043E \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0456\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 39276505980941
    m_Localized: "{0} \u0410\u0443\u0434\u0438\u0442\u043E\u0440\u0456\u044F \xB7
