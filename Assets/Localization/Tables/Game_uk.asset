  - m_Id: 772983604895747
    m_Localized: "\u041C\u0456\u0446\u043D\u0430 \u043A\u0430\u0432\u0430! \u0414\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0438\u0439
      \u0421\u043E\u043D \u0456 \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C
      \u043D\u0430 20 \u0441\u0435\u043A\u0443\u043D\u0434, \u043F\u043E\u0442\u0456\u043C
      \u0441\u043F\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895748
    m_Localized: "\u0414\u0430\u0439 \u043A\u0443\u0445\u043D\u0456 \u0445\u0432\u0438\u043B\u0438\u043D\u0443-\u0434\u0432\u0456,
      \u043F\u0435\u0440\u0448 \u043D\u0456\u0436 \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0437\u043D\u043E\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895749
    m_Localized: "\u041F\u0440\u0438\u044F\u0437\u043D\u0430 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043A\u0430
      \u0447\u0435\u043A\u0430\u0454 \u0432 \u0442\u0440\u0435\u0442\u0456\u0439
      \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0456\u0457, \u0434\u0435 \u0444\u0456\u043D\u0430\u043B\u044C\u043D\u0438\u0439
      \u0456\u0441\u043F\u0438\u0442: \u0441\u043A\u043B\u0430\u0434\u0438 \u0456\u0441\u043F\u0438\u0442
      2 \u0456 \u043F\u0440\u043E\u0439\u0434\u0438 \u043F\u0435\u0440\u0435\u0434\u043D\u0456\u043C\u0438
      \u0434\u0432\u0435\u0440\u0438\u043C\u0430 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u043E\u0457
      \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0456\u0457. \u0420\u043E\u0436\u0435\u0432\u0435
      \u0441\u0435\u0440\u0446\u0435 \u043D\u0430\u0434 \u043D\u0435\u044E \u043E\u0437\u043D\u0430\u0447\u0430\u0454,
      \u0449\u043E \u0437 \u043D\u0435\u044E \u043C\u043E\u0436\u043D\u0430 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438.
      \u0422\u0430\u043C \u0443 \u0442\u0435\u0431\u0435 \u0434\u0432\u0456 \u0432\u0456\u043B\u044C\u043D\u0456
      \u043F\u0430\u0440\u0438. \u041D\u0430\u0432\u0447\u0430\u043D\u043D\u044F
      \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0454 \u043E\u0434\u043D\u0443 \u0439
      \u0434\u043E\u0434\u0430\u0454 \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u0456.
      \u0424\u043B\u0456\u0440\u0442 \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0454
      \u043E\u0434\u043D\u0443 \u043F\u0430\u0440\u0443 \u0439 \u043E\u0434\u043D\u0443
      \u0437\u0456\u0431\u0440\u0430\u043D\u0443 \u0440\u043E\u0431\u043E\u0442\u0443.
      \u041D\u0430\u0432\u0447\u0430\u0439\u0441\u044F \u0434\u0432\u0456\u0447\u0456
      \u0434\u043B\u044F \u043D\u0430\u0439\u043B\u0435\u0433\u0448\u043E\u0433\u043E
      \u0456\u0441\u043F\u0438\u0442\u0443 \u0430\u0431\u043E \u0444\u043B\u0456\u0440\u0442\u0443\u0439
      \u0456 \u043D\u0430\u0432\u0447\u0430\u0439\u0441\u044F \u0440\u0430\u0437,
      \u0430 \u043F\u043E\u0442\u0456\u043C \u043F\u043E\u0432\u0435\u0440\u043D\u0438\u0441\u044C
      \u043F\u043E \u0434\u0432\u0456 \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u0456
      \u0440\u043E\u0431\u043E\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895750
    m_Localized: "\u0406\u0441\u043F\u0438\u0442 \u0449\u0435 \u043D\u0435 \u043F\u043E\u0447\u0430\u0432\u0441\u044F:
      \u0441\u043F\u0435\u0440\u0448\u0443 \u043D\u0430\u0442\u0438\u0441\u043D\u0438
      {0} \u0431\u0456\u043B\u044F \u0432\u0438\u043A\u043B\u0430\u0434\u0430\u0447\u0430.
      \u0414\u043E \u0442\u043E\u0433\u043E \u043A\u0438\u0434\u043A\u0438 \u043D\u0456\u0447\u043E\u0433\u043E
      \u043D\u0435 \u0434\u0430\u044E\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 772983604895751
    m_Localized: "\u0421\u043F\u0435\u0440\u0448\u0443 \u043F\u0456\u0434\u0433\u043E\u0442\u0443\u0439\u0441\u044F
      (\u043F\u043E\u0432\u0442\u043E\u0440\u0438 \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C
      \u0430\u0431\u043E \u0437\u043D\u0430\u0439\u0434\u0438 \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438),
      \u043F\u043E\u0442\u0456\u043C \u043D\u0430\u0442\u0438\u0441\u043D\u0438 {0}
      \u0431\u0456\u043B\u044F \u0432\u0438\u043A\u043B\u0430\u0434\u0430\u0447\u0430.
      \u0414\u043E \u0456\u0441\u043F\u0438\u0442\u0443 \u043A\u0438\u0434\u043A\u0438
      \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u0434\u0430\u044E\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 774744583430144
    m_Localized: "{0} \xB7 \u041F\u0456\u0434\u0433\u043E\u0442\u0443\u0432\u0430\u0442\u0438
      \u0440\u043E\u0431\u043E\u0442\u0438 \u043D\u0430 \u041F\u041A (2 \u0421\u043D\u0443
      \u2192 2 \u0440\u043E\u0431\u043E\u0442\u0438, \u0440\u0430\u0437 \u043D\u0430
      \u0456\u0441\u043F\u0438\u0442)"
    m_Metadata:
      m_Items: []
  - m_Id: 774744591818752
    m_Localized: "\u0422\u0438 \u0432\u0436\u0435 \u043F\u0456\u0434\u0433\u043E\u0442\u0443\u0432\u0430\u0432
      \u0440\u043E\u0431\u043E\u0442\u0438 \u0434\u043E \u0446\u044C\u043E\u0433\u043E
      \u0456\u0441\u043F\u0438\u0442\u0443. \u0421\u043A\u043B\u0430\u0434\u0438
      \u0439\u043E\u0433\u043E, \u0449\u043E\u0431 \u0437\u043D\u043E\u0432\u0443
      \u0441\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438\u0441\u044F \u041F\u041A."
    m_Metadata:
      m_Items: []
  - m_Id: 774744591818753
    m_Localized: "\u041D\u0430\u0434\u0442\u043E \u0432\u0442\u043E\u043C\u0438\u0432\u0441\u044F
      \u0434\u043B\u044F \u0440\u043E\u0431\u043E\u0442\u0438: \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0456\u0436 2 \u0421\u043D\u0443.
      \u0421\u043F\u0435\u0440\u0448\u0443 \u043F\u043E\u0457\u0436 \u0430\u0431\u043E
      \u0432\u0456\u0434\u043F\u043E\u0447\u0438\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 774744591818754
    m_Localized: "\u0422\u0438 \u043F\u0456\u0434\u0433\u043E\u0442\u0443\u0432\u0430\u0432
      2 \u0440\u043E\u0431\u043E\u0442\u0438 \u0437\u0430 \u043D\u0456\u0447 (\u22122
      \u0421\u043D\u0443). \u0407\u0445 \u043A\u0438\u0434\u0430\u043D\u043D\u044F
      \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 775002260496384
    m_Localized: "{0} \xB7 \u0417\u043C\u0456\u043D\u0438\u0442\u0438 \u043E\u0434\u044F\u0433"
