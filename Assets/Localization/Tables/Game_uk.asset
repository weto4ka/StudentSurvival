  - m_Id: 27822486708227
    m_Localized: "\u041D\u0430 \u0432\u0435\u0441\u044C \u0435\u043A\u0440\u0430\u043D
      \u0431\u0435\u0437 \u0440\u0430\u043C\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708228
    m_Localized: "\u0423 \u0432\u0456\u043A\u043D\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708229
    m_Localized: "\u0417\u0431\u0438\u0440\u0430\u0439 \u043F\u0440\u0438\u043F\u0430\u0441\u0438
      \u0442\u0430 \u0441\u043A\u043B\u0430\u0434\u0438 \u0434\u0432\u0430 \u0456\u0441\u043F\u0438\u0442\u0438.
      \u0421\u043E\u043D \u0442\u0430 \u0406\u043D\u0442\u0435\u043B\u0435\u043A\u0442
      \u043C\u0430\u044E\u0442\u044C \u0431\u0443\u0442\u0438 \u0432\u0438\u0449\u0435
      \u043D\u0443\u043B\u044F. \u041F\u043E\u0441\u0442\u0440\u0456\u043B \u043A\u043E\u0448\u0442\u0443\u0454
      1 \u0421\u043E\u043D; \u0437\u0456\u0431\u0440\u0430\u043D\u0456 \u0440\u043E\u0431\u043E\u0442\u0438
      \u2014 \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u0456 \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0438.
      \u041E\u0431\u0435\u0440\u0438 \u043F\u0440\u0438\u0432\u2019\u044F\u0437\u043A\u0443
      \u043D\u0438\u0436\u0447\u0435, \u0449\u043E\u0431 \u0437\u043C\u0456\u043D\u0438\u0442\u0438
      \u0457\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 27822486708230
    m_Localized: "\u041A\u043B\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0430 /
