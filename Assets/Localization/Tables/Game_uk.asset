  m_TableData:
  - m_Id: 1085267968
    m_Localized: "\u0421\u0442\u0443\u0434\u0435\u043D\u0442\u0441\u044C\u043A\u0435
      \u0432\u0438\u0436\u0438\u0432\u0430\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1156571136
    m_Localized: "\u0417\u0434\u043E\u0431\u0443\u0434\u044C \u0434\u0438\u043F\u043B\u043E\u043C.
      \u041D\u0435 \u0437\u0430\u0441\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959744
    m_Localized: "\u041F\u043E\u0447\u0430\u0442\u0438 \u0433\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959745
    m_Localized: "\u041D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959746
    m_Localized: "\u042F\u043A \u0433\u0440\u0430\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959747
    m_Localized: "\u0412\u0438\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959748
    m_Localized: "\u041D\u0430\u0437\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959749
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959750
    m_Localized: "\u041F\u043E\u0447\u0430\u0442\u0438 \u0437\u0430\u043D\u043E\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959751
    m_Localized: "\u0413\u043E\u043B\u043E\u0432\u043D\u0435 \u043C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959752
    m_Localized: "\u0417\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959753
    m_Localized: "\u041F\u0435\u0440\u0435\u043F\u043E\u0447\u0438\u043D\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959754
    m_Localized: "\u041C\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959755
    m_Localized: "\u0417\u0430\u0433\u0430\u043B\u044C\u043D\u0430 \u0433\u0443\u0447\u043D\u0456\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959756
    m_Localized: "\u0420\u043E\u0437\u043C\u0456\u0440 \u0456\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959757
    m_Localized: "\u041D\u0430 \u0432\u0435\u0441\u044C \u0435\u043A\u0440\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959758
    m_Localized: "\u0423\u0432\u0456\u043C\u043A\u043D\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959759
    m_Localized: "\u0412\u0438\u043C\u043A\u043D\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959760
    m_Localized: "\u041C\u043E\u0432\u0430 \u0442\u0435\u043A\u0441\u0442\u0443 \u0437\u043C\u0456\u043D\u044E\u0454\u0442\u044C\u0441\u044F
      \u043E\u0434\u0440\u0430\u0437\u0443. \u041D\u0430\u043F\u0438\u0441\u0438
      \u0432 \u043E\u0440\u0438\u0433\u0456\u043D\u0430\u043B\u044C\u043D\u0438\u0445
      \u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u043D\u044F\u0445 \u0456 \u0432\u0456\u0434\u0435\u043E
      \u0437\u0430\u043B\u0438\u0448\u0430\u044E\u0442\u044C\u0441\u044F \u0431\u0435\u0437
      \u0437\u043C\u0456\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959761
    m_Localized: "\u0421\u043E\u043D: {0}    \u0406\u043D\u0442\u0435\u043B\u0435\u043A\u0442:
      {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959762
    m_Localized: "\u0406\u0441\u043F\u0438\u0442 {0}/2 \xB7 \u0417\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F
      \u0440\u043E\u0431\u0456\u0442: {1}/{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959763
    m_Localized: "\u041D\u0430\u0441\u0442\u0443\u043F\u043D\u0438\u0439 \u0432\u0438\u043A\u043B\u0430\u0434\u0430\u0447
      \u0443\u0436\u0435 \u0439\u0434\u0435\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959764
    m_Localized: "Ctrl / \u043C\u0438\u0448\u0430: \u043A\u0438\u043D\u0443\u0442\u0438
      \u0440\u043E\u0431\u043E\u0442\u0443 (\u0446\u0456\u043D\u0430: 1 \u0421\u043E\u043D)"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959765
    m_Localized: "\u041F\u043E\u0440\u043E\u0436\u043D\u044C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959766
    m_Localized: "{0} \xB7 {1}\n\xD7{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959767
    m_Localized: "\u0421\u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u0437\u043D\u0430\u0439\u0434\u0438
      \u043F\u0440\u0438\u043F\u0430\u0441\u0438 \u0439 \u043D\u0430\u0442\u0438\u0441\u043D\u0438
      E, \u0449\u043E\u0431 \u043F\u0456\u0434\u0456\u0431\u0440\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959768
    m_Localized: "\u0417\u043D\u0430\u0439\u0434\u0438 \u0432\u0438\u043A\u043B\u0430\u0434\u0430\u0447\u0430
      \u0442\u0430 \u0441\u043A\u043B\u0430\u0434\u0438 \u043F\u0435\u0440\u0448\u0438\u0439
      \u0456\u0441\u043F\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959769
    m_Localized: "\u0421\u043A\u043B\u0430\u0434\u0438 \u0444\u0456\u043D\u0430\u043B\u044C\u043D\u0438\u0439
      \u0456\u0441\u043F\u0438\u0442, \u0449\u043E\u0431 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u0434\u0438\u043F\u043B\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959770
    m_Localized: "E \xB7 \u0412\u0456\u0434\u0447\u0438\u043D\u0438\u0442\u0438 \u0434\u0432\u0435\u0440\u0456
      (\u0437\u0430\u043B\u0438\u0448\u0430\u0439\u0441\u044F \u043F\u043E\u0440\u0443\u0447)"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959771
    m_Localized: "\u0412\u0456\u0434\u0447\u0438\u043D\u044F\u0454\u043C\u043E\u2026
      \u0437\u0430\u043B\u0438\u0448\u0430\u0439\u0441\u044F \u0431\u0456\u043B\u044F
      \u0434\u0432\u0435\u0440\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959772
    m_Localized: "\u0426\u0456 \u0434\u0432\u0435\u0440\u0456 \u0437\u0430\u043C\u043A\u043D\u0435\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959773
    m_Localized: "\u0414\u043B\u044F \u0446\u0438\u0445 \u0434\u0432\u0435\u0440\u0435\u0439
      \u043D\u0435 \u0437\u0430\u0434\u0430\u043D\u043E \u0432\u0438\u0445\u0456\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959774
    m_Localized: "E \xB7 \u041F\u0456\u0434\u0456\u0431\u0440\u0430\u0442\u0438:
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959775
    m_Localized: "\u0428\u0430\u0443\u0440\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959776
    m_Localized: "\u041A\u043D\u0438\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959777
    m_Localized: "\u041B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0430
      \u0440\u043E\u0431\u043E\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959778
    m_Localized: "\u0415\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959779
    m_Localized: "\u0412\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u0454 1 \u0421\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959780
    m_Localized: "\u0412\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u0454 1 \u0406\u043D\u0442\u0435\u043B\u0435\u043A\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959781
    m_Localized: "\u041A\u0438\u0434\u0430\u0454 \u043E\u0434\u043D\u0443 \u0437\u0456\u0431\u0440\u0430\u043D\u0443
      \u0440\u043E\u0431\u043E\u0442\u0443 \u0431\u0435\u0437 \u0432\u0438\u0442\u0440\u0430\u0442
      \u0421\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959782
    m_Localized: "\u0412\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u0454 1 \u0421\u043E\u043D
      \u0456 \u0434\u043E\u0434\u0430\u0454 1 \u0434\u043E \u0448\u0432\u0438\u0434\u043A\u043E\u0441\u0442\u0456
      \u0434\u043E \u043A\u0456\u043D\u0446\u044F \u0433\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959783
    m_Localized: "\u041F\u0456\u0434\u0456\u0431\u0440\u0430\u043D\u043E: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959784
    m_Localized: "\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043E:
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959785
    m_Localized: "\u041F\u0430\u043D\u0435\u043B\u044C \u0437\u0430\u043F\u043E\u0432\u043D\u0435\u043D\u0430.
      \u0421\u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0439
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959786
    m_Localized: "\u041F\u043E\u0433\u0430\u043D\u0430 \u043E\u0446\u0456\u043D\u043A\u0430!
      \u0412\u0442\u0440\u0430\u0447\u0435\u043D\u043E 1 \u0406\u043D\u0442\u0435\u043B\u0435\u043A\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959787
    m_Localized: "\u0412\u0456\u0434\u0441\u0443\u0442\u043D\u0456\u0439 \u043E\u0431\u2019\u0454\u043A\u0442
      \u0434\u043B\u044F \u043A\u0438\u0434\u0430\u043D\u043D\u044F \u0440\u043E\u0431\u043E\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959788
    m_Localized: "\u041F\u0435\u0440\u0448\u0438\u0439 \u0456\u0441\u043F\u0438\u0442
      \u0441\u043A\u043B\u0430\u0434\u0435\u043D\u043E! +3 \u0421\u043E\u043D, +1
      \u0406\u043D\u0442\u0435\u043B\u0435\u043A\u0442. \u0417\u0430\u043B\u0438\u0448\u0438\u0432\u0441\u044F
      \u0449\u0435 \u043E\u0434\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959789
    m_Localized: "\u0414\u0438\u043F\u043B\u043E\u043C \u0437\u0434\u043E\u0431\u0443\u0442\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959790
    m_Localized: "\u0421\u0435\u043C\u0435\u0441\u0442\u0440 \u0442\u0435\u0431\u0435
      \u0437\u0434\u043E\u043B\u0430\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959791
    m_Localized: "\u0421\u043E\u043D \u0432\u0438\u0447\u0435\u0440\u043F\u0430\u043D\u043E.
      \u041A\u0438\u0434\u0430\u0439 \u0437\u0456\u0431\u0440\u0430\u043D\u0456 \u0440\u043E\u0431\u043E\u0442\u0438,
      \u0449\u043E\u0431 \u0439\u043E\u0433\u043E \u0437\u0430\u043E\u0449\u0430\u0434\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959792
    m_Localized: "\u0406\u043D\u0442\u0435\u043B\u0435\u043A\u0442 \u0443\u043F\u0430\u0432
      \u0434\u043E \u043D\u0443\u043B\u044F. \u041D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u0433\u043E
      \u0440\u0430\u0437\u0443 \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0443\u0442\u044C
      \u043A\u043D\u0438\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959793
    m_Localized: "R \xB7 \u0417\u0430\u043D\u043E\u0432\u043E     Esc \xB7 \u0413\u043E\u043B\u043E\u0432\u043D\u0435
      \u043C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1164959794
    m_Localized: "\u0420\u0443\u0445: A/D \u0430\u0431\u043E \u0441\u0442\u0440\u0456\u043B\u043A\u0438\n\u0421\u0442\u0440\u0438\u0431\u043E\u043A:
      \u041F\u0440\u043E\u0431\u0456\u043B\n\u0412\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u044F
      / \u043F\u0456\u0434\u0431\u0456\u0440: E\n\u041A\u0438\u043D\u0443\u0442\u0438
      \u0440\u043E\u0431\u043E\u0442\u0443: Ctrl \u0430\u0431\u043E \u043B\u0456\u0432\u0430
      \u043A\u043D\u043E\u043F\u043A\u0430 \u043C\u0438\u0448\u0456 (\u0446\u0456\u043D\u0430:
      1 \u0421\u043E\u043D)\n\u041F\u0440\u0435\u0434\u043C\u0435\u0442\u0438: 1\u20139
      \u0430\u0431\u043E \u043D\u0430\u0442\u0438\u0441\u043D\u0438 \u043A\u043E\u043C\u0456\u0440\u043A\u0443\n\u041F\u0430\u0443\u0437\u0430
      / \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F:
      Esc\n\n\u0417\u0431\u0438\u0440\u0430\u0439 \u043F\u0440\u0438\u043F\u0430\u0441\u0438,
      \u0437\u043D\u0430\u0439\u0434\u0438 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0456\u044E
      \u0442\u0430 \u0441\u043A\u043B\u0430\u0434\u0438 \u0434\u0432\u0430 \u0456\u0441\u043F\u0438\u0442\u0438.
      \u041A\u043E\u0436\u043D\u0435 \u0432\u043B\u0443\u0447\u0430\u043D\u043D\u044F
      \u0440\u0430\u0445\u0443\u0454\u0442\u044C\u0441\u044F \u043E\u0434\u0438\u043D
      \u0440\u0430\u0437. \u0421\u043E\u043D \u0442\u0430 \u0406\u043D\u0442\u0435\u043B\u0435\u043A\u0442
      \u043C\u0430\u044E\u0442\u044C \u0431\u0443\u0442\u0438 \u0432\u0438\u0449\u0435
      \u043D\u0443\u043B\u044F.\n\n\u0413\u0435\u0439\u043C\u043F\u0430\u0434: \u043B\u0456\u0432\u0438\u0439
      \u0441\u0442\u0456\u043A / \u0445\u0440\u0435\u0441\u0442\u043E\u0432\u0438\u043D\u0430
      \u2014 \u0440\u0443\u0445, \u0432\u0435\u0440\u0445\u043D\u044F \u043A\u043D\u043E\u043F\u043A\u0430
      \u2014 \u0441\u0442\u0440\u0438\u0431\u043E\u043A, \u043B\u0456\u0432\u0430
      \u2014 \u0432\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u044F, \u043D\u0438\u0436\u043D\u044F
      \u2014 \u043A\u0438\u0434\u043E\u043A; Start \u2014 \u043F\u043E\u0432\u0442\u043E\u0440
      \u043F\u0456\u0441\u043B\u044F \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0443,
      Select \u2014 \u043F\u0430\u0443\u0437\u0430. \u0414\u043B\u044F \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044E
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439 \u0435\u043A\u0440\u0430\u043D\u043D\u0456
      \u043A\u043D\u043E\u043F\u043A\u0438 \u0430\u0431\u043E \u043A\u043B\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1164959795
    m_Localized: "University.exe \u043D\u0435 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u0454.
