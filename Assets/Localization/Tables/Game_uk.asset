  - m_Id: 80304193658916
    m_Localized: "\u0421\u0435\u043C\u0435\u0441\u0442\u0440 \u0441\u043A\u043B\u0430\u0434\u0435\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658917
    m_Localized: "\u0422\u0440\u0438 \u0432\u0438\u043A\u043B\u0430\u0434\u0430\u0447\u0456,
      \u0442\u0440\u0438 \u0456\u0441\u043F\u0438\u0442\u0438. \u041F\u0435\u0440\u0448\u0438\u0439
      \u0441\u0435\u043C\u0435\u0441\u0442\u0440 \u043F\u043E\u0437\u0430\u0434\u0443.
      \u041F\u0435\u0440\u0435\u043F\u043E\u0447\u0438\u043D\u044C \u2014 \u0442\u0438
      \u043D\u0430 \u0446\u0435 \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658918
    m_Localized: "\u0421\u043A\u043B\u0430\u0434\u0438 \u0442\u0440\u0438 \u043F\u043E\u0441\u043B\u0456\u0434\u043E\u0432\u043D\u0456
      \u0456\u0441\u043F\u0438\u0442\u0438, \u0449\u043E\u0431 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438
      \u0441\u0435\u043C\u0435\u0441\u0442\u0440. \u0417\u0431\u0438\u0440\u0430\u0439
      \u043F\u0440\u0438\u043F\u0430\u0441\u0438, \u0433\u043E\u0442\u0443\u0439\u0441\u044F,
      \u0430 \u043F\u043E\u0442\u0456\u043C \u0432\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u0439
      \u0456\u0437 \u0432\u0438\u043A\u043B\u0430\u0434\u0430\u0447\u0435\u043C,
      \u0449\u043E\u0431 \u043F\u043E\u0447\u0430\u0442\u0438. \u041F\u0456\u0441\u043B\u044F
      \u0456\u0441\u043F\u0438\u0442\u0443 \u0439\u0434\u0438 \u0447\u0435\u0440\u0435\u0437
      \u043F\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u0456 \u0434\u0432\u0435\u0440\u0456
      \u0434\u043E \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u0457 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658919
    m_Localized: "\u0421\u0445\u043E\u0432\u0430\u043D\u0456 \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438
      \u0439 \u043F\u0438\u043B\u044C\u043D\u0438\u0439 \u043E\u0445\u043E\u0440\u043E\u043D\u0435\u0446\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658920
    m_Localized: "\u0423 \u0434\u0440\u0443\u0433\u0456\u0439 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0456\u0457
      \u0447\u0435\u0441\u043D\u043E \u043F\u043E\u0432\u0442\u043E\u0440\u0438 \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B
      \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C \u0430\u0431\u043E \u0432\u0456\u0437\u044C\u043C\u0438
      \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438, \u0441\u0445\u043E\u0432\u0430\u043D\u0456
      \u0432 \u0442\u0443\u0430\u043B\u0435\u0442\u043D\u0456\u0439 \u043D\u0456\u0448\u0456.
      \u042F\u043A\u0449\u043E \u043E\u0445\u043E\u0440\u043E\u043D\u0435\u0446\u044C
      \u0431\u0430\u0447\u0438\u0442\u044C \u0442\u0435\u0431\u0435 \u0437\u0456
      \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0430\u043C\u0438, \u0439\u043E\u0433\u043E
      \u043F\u0456\u0434\u043E\u0437\u0440\u0430 \u0437\u0440\u043E\u0441\u0442\u0430\u0454.
      \u041F\u0440\u0438\u0433\u043D\u0438\u0441\u044F \u0430\u0431\u043E \u0441\u0445\u043E\u0432\u0430\u0439\u0441\u044F
      \u0432 \u043D\u0456\u0448\u0456, \u0449\u043E\u0431 \u0432\u043E\u043D\u0430
      \u0441\u043F\u0430\u043B\u0430. \u042F\u043A\u0449\u043E \u0441\u043F\u0456\u0439\u043C\u0430\u0454,
      \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438 \u0437\u0430\u0431\u0435\u0440\u0443\u0442\u044C,
      \u0430 \u0456\u0441\u043F\u0438\u0442 \u043F\u0435\u0440\u0435\u0440\u0432\u0443\u0442\u044C;
      \u043F\u0456\u0434\u0433\u043E\u0442\u0443\u0439\u0441\u044F \u0439 \u0441\u043F\u0440\u043E\u0431\u0443\u0439
      \u0449\u0435 \u0440\u0430\u0437. \u041F\u0456\u0434 \u0447\u0430\u0441 \u0456\u0441\u043F\u0438\u0442\u0443
      \u0432\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u0439 \u0431\u0456\u043B\u044F
      \u0432\u0438\u043A\u043B\u0430\u0434\u0430\u0447\u0430, \u0449\u043E\u0431
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438 \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0438:
      \u0447\u043E\u0442\u0438\u0440\u0438 \u0432\u043B\u0443\u0447\u0430\u043D\u043D\u044F
      \u0437\u0430\u043C\u0456\u0441\u0442\u044C \u0448\u0435\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658921
    m_Localized: "\u0414\u0432\u0456 \u0432\u0456\u043B\u044C\u043D\u0456 \u043F\u0430\u0440\u0438
      \u043F\u0435\u0440\u0435\u0434 \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u043C
      \u0456\u0441\u043F\u0438\u0442\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658922
    m_Localized: "\u0423 \u0442\u0440\u0435\u0442\u0456\u0439 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0456\u0457
      \u043C\u0430\u0454\u0448 \u0434\u0432\u0456 \u0432\u0456\u043B\u044C\u043D\u0456
      \u043F\u0430\u0440\u0438. \u041D\u0430\u0432\u0447\u0430\u043D\u043D\u044F
      \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0454 \u043E\u0434\u043D\u0443 \u0439
      \u0434\u043E\u0434\u0430\u0454 \u043E\u0434\u0438\u043D \u0431\u0430\u043B
      \u043F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438. \u0424\u043B\u0456\u0440\u0442
      \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0454 \u043E\u0434\u043D\u0443 \u043F\u0430\u0440\u0443
      \u0442\u0430 \u043E\u0434\u043D\u0443 \u0437\u0456\u0431\u0440\u0430\u043D\u0443
      \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0443. \u041D\u0430\u0432\u0447\u0430\u0439\u0441\u044F
      \u0434\u0432\u0456\u0447\u0456, \u0449\u043E\u0431 \u0456\u0441\u043F\u0438\u0442
      \u0431\u0443\u0432 \u043D\u0430\u0439\u043B\u0435\u0433\u0448\u0438\u043C,
      \u0430\u0431\u043E \u043F\u043E\u0444\u043B\u0456\u0440\u0442\u0443\u0439 \u0456
      \u043F\u043E\u0432\u0447\u0438\u0441\u044C \u043E\u0434\u0438\u043D \u0440\u0430\u0437,
      \u0430 \u043F\u043E\u0442\u0456\u043C \u043F\u043E\u0432\u0435\u0440\u043D\u0438\u0441\u044F
      \u0434\u043E \u0434\u0440\u0443\u0433\u0430 \u043F\u043E \u0434\u0432\u0456
      \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u0456 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0456.
      \u041C\u043E\u0436\u043D\u0430 \u0442\u0430\u043A\u043E\u0436 \u043F\u0456\u0442\u0438
      \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u043D\u0456\u0448\u0438\u0439 \u0456\u0441\u043F\u0438\u0442
      \u0456\u0437 \u043C\u0435\u043D\u0448\u043E\u044E \u043F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u043E\u044E.
      \u0412\u0430\u0440\u0442\u0456\u0441\u0442\u044C \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u043E
      \u0434\u043E \u0432\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658923
    m_Localized: "\u0420\u0456\u0437\u043D\u0456 \u0432\u0438\u043A\u043B\u0430\u0434\u0430\u0447\u0456
      \u2014 \u0440\u0456\u0437\u043D\u0456 \u0456\u0441\u043F\u0438\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658924
    m_Localized: "\u041F\u0440\u043E\u0444\u0435\u0441\u043E\u0440 Byte \u043F\u043E\u0447\u0438\u043D\u0430\u0454
      \u0437 \u043D\u0438\u0437\u044C\u043A\u0438\u0445 \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u0438\u0445
      \u043A\u0438\u0434\u043A\u0456\u0432. \u0414\u043E\u043A\u0442\u043E\u0440
      Redline \u0447\u0435\u0440\u0433\u0443\u0454 \u0432\u0438\u0441\u043E\u043A\u0456
      \u0439 \u043D\u0438\u0437\u044C\u043A\u0456 \u0447\u0435\u0440\u0433\u0438.
      \u041F\u0440\u043E\u0444\u0435\u0441\u043E\u0440 Deadline \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0454
      \u0434\u043E\u0432\u0448\u0456 \u0437\u0430\u043B\u043F\u0438 \u0437\u0456
      \u0437\u043C\u0456\u043D\u043E\u044E \u0432\u0438\u0441\u043E\u0442\u0438.
      \u041F\u043E\u0447\u0438\u043D\u0430\u0439 \u043A\u043E\u0436\u0435\u043D \u0456\u0441\u043F\u0438\u0442
      \u0434\u0456\u0454\u044E \u0432\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u0457;
      \u0441\u0442\u0435\u0436 \u0437\u0430 \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u0436\u0435\u043D\u043D\u044F\u043C\u0438
      \u0439 \u043F\u0456\u0434\u043A\u0430\u0437\u043A\u0430\u043C\u0438 \u0441\u0442\u0440\u0438\u0431\u043D\u0443\u0442\u0438
      \u0430\u0431\u043E \u043F\u0440\u0438\u0433\u043D\u0443\u0442\u0438\u0441\u044F.
      \u0421\u043A\u043B\u0430\u0434\u0435\u043D\u0438\u0439 \u0456\u0441\u043F\u0438\u0442
      \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u0454 \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0443
      \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0456\u044E \u0442\u0430 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u0443 \u0442\u043E\u0447\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658925
    m_Localized: "{0}: \u0456\u0441\u043F\u0438\u0442 \u043F\u043E\u0447\u0430\u0432\u0441\u044F.
      \u0421\u0442\u0435\u0436 \u0437\u0430 \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u0436\u0435\u043D\u043D\u044F\u043C
      \u0456 \u0443\u0445\u0438\u043B\u044F\u0439\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658926
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438 \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658927
    m_Localized: "\u0421\u0435\u043C\u0435\u0441\u0442\u0440 \u0441\u043A\u043B\u0430\u0434\u0435\u043D\u043E!
      \u0414\u043E\u0441\u043B\u0456\u0434\u0436\u0443\u0439 \u0434\u0430\u043B\u0456:
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044C\u0441\u044F.
      \u041D\u043E\u0432\u0430 \u0433\u0440\u0430 \u2014 \u0437\u0430 \u0431\u0430\u0436\u0430\u043D\u043D\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658928
    m_Localized: "\u0421\u0435\u043C\u0435\u0441\u0442\u0440 \u0441\u043A\u043B\u0430\u0434\u0435\u043D\u043E
      \xB7 \u0414\u043E\u0441\u043B\u0456\u0434\u0436\u0443\u0439 \u0443\u043D\u0456\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658929
    m_Localized: "\u0412\u0438\u043A\u043B\u0430\u0434\u0430\u0447 \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u0454\u0442\u044C\u0441\u044F
      \xB7 \u041E\u0431\u0435\u0440\u0438 \u043C\u0438\u0442\u044C \u0434\u043B\u044F
      \u043A\u0438\u0434\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 80304193658930
    m_Localized: "\u041F\u043E\u0447\u0438\u043D\u0430\u0439 \u0456\u0441\u043F\u0438\u0442
      \u0434\u0456\u0454\u044E \u0432\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u0457.
      \u0411\u0430\u0439\u0442 \u043A\u0438\u0434\u0430\u0454 \u0434\u0432\u0456
      \u043D\u0438\u0437\u044C\u043A\u0456 \u043E\u0446\u0456\u043D\u043A\u0438,
      \u0427\u0435\u0440\u0432\u043E\u043D\u0430 \u0420\u0443\u0447\u043A\u0430 \u2014
      \u043F\u0430\u0440\u0438 \u043D\u0430 \u0440\u0456\u0437\u043D\u0456\u0439
      \u0432\u0438\u0441\u043E\u0442\u0456, \u0414\u0435\u0434\u043B\u0430\u0439\u043D
      \u2014 \u043A\u043E\u0440\u043E\u0442\u043A\u0456 \u0442\u0440\u0456\u0439\u043A\u0438.
      \u0421\u0442\u0435\u0436 \u0437\u0430 \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u0436\u0435\u043D\u043D\u044F\u043C
      \u0456 \u043F\u0456\u0434\u043A\u0430\u0437\u043A\u0430\u043C\u0438 \u0441\u0442\u0440\u0438\u0431\u043A\u0430
      \u0442\u0430 \u043F\u0440\u0438\u0441\u0456\u0434\u0430\u043D\u043D\u044F.
      \u041F\u0456\u0441\u043B\u044F \u0432\u043B\u0443\u0447\u0430\u043D\u043D\u044F
      \u0432\u0438\u043A\u043B\u0430\u0434\u0430\u0447 \u0431\u043B\u0438\u043C\u0430\u0454
      \u0456 \u0442\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u043E \u043D\u0435
      \u043E\u0442\u0440\u0438\u043C\u0443\u0454 \u0448\u043A\u043E\u0434\u0438:
      \u0440\u043E\u0431\u0438 \u043F\u0430\u0443\u0437\u0438 \u043C\u0456\u0436
      \u043A\u0438\u0434\u043A\u0430\u043C\u0438. \u0421\u043A\u043B\u0430\u0434\u0435\u043D\u0438\u0439
      \u0456\u0441\u043F\u0438\u0442 \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u0454
      \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0443 \u043A\u0456\u043C\u043D\u0430\u0442\u0443;
      \u043F\u0456\u0441\u043B\u044F \u043E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u0433\u043E
      \u043C\u043E\u0436\u043D\u0430 \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0443\u0432\u0430\u0442\u0438
      \u0434\u0430\u043B\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 81762762874880
    m_Localized: "\u041F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u043E \u043D\u0430
      \u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0443 \u0437\u0435\u043C\u043B\u044E.
